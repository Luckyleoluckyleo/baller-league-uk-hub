---
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { getCollection } from 'astro:content';
import playerData from '../../data/players.json';
import fixturesData from '../../data/fixtures.json';
import { CURRENT_SEASON, playedMatches, standingsFor, matchSlug, teamColor, teamColorSoft } from '../../lib/league';

const nameBySlug: Record<string, string> = {};
for (const p of (playerData.players as any[])) nameBySlug[p.name.toLowerCase()] = p.slug;

export async function getStaticPaths() {
  const managers = await getCollection('managers');
  return managers.map(m => ({ params: { slug: m.slug }, props: { slug: m.slug } }));
}

const { slug } = Astro.props;
const managers = await getCollection('managers');
const manager = managers.find(m => m.slug === slug);
const data = manager?.data;
const isActive = data ? data.active !== false : true;

const SEASON = CURRENT_SEASON;
const standing = standingsFor(SEASON).find((t) => t.slug === data?.team);
const seasonMatches = playedMatches(SEASON);

function initials(name: string): string {
  return name.split(' ').map((n) => n[0]).join('').slice(0, 2).toUpperCase();
}

function getForm(teamSlug: string): { label: string; cls: string }[] {
  return seasonMatches
    .filter((x: any) => x.homeSlug === teamSlug || x.awaySlug === teamSlug)
    .sort((a: any, b: any) => b.gameweek - a.gameweek)
    .slice(0, 5)
    .map((x: any) => {
      const isHome = x.homeSlug === teamSlug;
      const gd = isHome ? x.homeScore - x.awayScore : x.awayScore - x.homeScore;
      if (gd > 0) return { label: 'W', cls: 'form-win' };
      if (gd < 0) return { label: 'L', cls: 'form-loss' };
      return { label: 'D', cls: 'form-draw' };
    });
}

const form = data ? getForm(data.team) : [];

// Current-season context: what happened last, and what's next. Keeps the page
// useful for "who is X" searches instead of only describing the manager.
const teamSlug = data?.team;

const latestMatch = teamSlug
  ? playedMatches(SEASON)
      .filter((m) => m.homeSlug === teamSlug || m.awaySlug === teamSlug)
      .sort((a, b) => b.gameweek - a.gameweek)[0] ?? null
  : null;

const nextFixture: any = teamSlug
  ? (((fixturesData as any).upcoming ?? []) as any[])
      .filter((f) => f.homeSlug === teamSlug || f.awaySlug === teamSlug)
      .sort((a, b) => a.gameweek - b.gameweek)[0] ?? null
  : null;

const topPlayers = seasonMatches
  .flatMap((m: any) => {
    if (m.homeSlug !== data?.team && m.awaySlug !== data?.team) return [];
    return (m.goalscorers || []).map((g: any) => ({ ...g, gameweek: m.gameweek }));
  });

const playerTally: Record<string, { player: string; goals: number; lastGW: number }> = {};
for (const g of topPlayers) {
  if (!playerTally[g.player]) playerTally[g.player] = { player: g.player, goals: 0, lastGW: 0 };
  playerTally[g.player].goals++;
  if (g.gameweek > playerTally[g.player].lastGW) playerTally[g.player].lastGW = g.gameweek;
}
const rankedPlayers = Object.values(playerTally).sort((a, b) => b.goals - a.goals).slice(0, 3);

// Career / tenure data. `seasonsManaged` lets a manager's own record be shown
// instead of the club's current record (important for former managers).
const born = data?.born ? new Date(data.born) : null;
const bornDisplay = born && !Number.isNaN(born.getTime())
  ? born.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })
  : null;
const playingPosition = data?.playingPosition;
const managerialCareer: string[] = data?.managerialCareer ?? [];
const careerHighlights: string[] = data?.careerHighlights ?? [];
const didYouKnow: string[] = data?.didYouKnow ?? [];

const managedSeasons: number[] = data?.seasonsManaged?.length ? data.seasonsManaged : [SEASON];
const managedMatches = data
  ? managedSeasons
      .flatMap((s) => playedMatches(s))
      .filter((m) => m.homeSlug === data.team || m.awaySlug === data.team)
  : [];
const record = { played: managedMatches.length, won: 0, drawn: 0, lost: 0, gf: 0, ga: 0 };
for (const m of managedMatches) {
  const isHome = m.homeSlug === data?.team;
  const scored = isHome ? m.homeScore : m.awayScore;
  const conceded = isHome ? m.awayScore : m.homeScore;
  record.gf += scored;
  record.ga += conceded;
  if (scored > conceded) record.won++;
  else if (scored < conceded) record.lost++;
  else record.drawn++;
}
const ppg = record.played ? ((record.won * 3 + record.drawn) / record.played).toFixed(2) : '0.00';
const seasonsLabel = managedSeasons.length === 1
  ? `S${managedSeasons[0]}`
  : `S${Math.min(...managedSeasons)}–S${Math.max(...managedSeasons)}`;

const bioText = (data?.bio || '').replace(/\n/g, ' ').trim();
const beforeBaller = [
  ...(data?.formerClubs?.length ? [`Played for ${(data.formerClubs as string[]).slice(0, 4).join(', ')}.`] : []),
  ...(data?.careerHighlights?.length ? [`${(data.careerHighlights as string[]).slice(0, 2).join('. ')}.`] : []),
].join(' ');

const managerFaqs = data ? [
  { q: `Who is ${data.name}?`, a: `${data.name} is ${isActive ? `the ${data.role.toLowerCase()} of ${data.teamName}` : `a former manager of ${data.teamName}`} in Baller League UK. ${bioText}` },
  { q: `Which Baller League UK team does ${data.name} manage?`, a: isActive ? `${data.name} manages ${data.teamName} in Baller League UK Season ${SEASON}.` : `${data.name} previously managed ${data.teamName} in Baller League UK.` },
  { q: `What did ${data.name} do before Baller League?`, a: beforeBaller || `${data.name} is part of the Baller League UK management line-up.` },
  { q: `What is ${data.name}'s Baller League UK record?`, a: record.played ? `${data.name}'s ${data.teamName} recorded ${record.won} wins, ${record.drawn} draws and ${record.lost} defeats in ${record.played} matches (${seasonsLabel}), scoring ${record.gf} and conceding ${record.ga} (${ppg} points per game).` : `${data.name}'s record is not yet available.` },
] : [];

const schema = data ? [
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "name": data.name,
    "description": bioText || `${data.name} manages ${data.teamName} in Baller League UK.`,
    "jobTitle": data.active === false ? 'Former Manager' : data.role,
    ...(data.born ? { "birthDate": data.born } : {}),
    ...(data.birthplace ? { "birthPlace": { "@type": "Place", "name": data.birthplace } } : {}),
    ...(data.nationality ? { "nationality": data.nationality } : {}),
    "memberOf": { "@type": "SportsTeam", "name": data.teamName, "url": `https://ballerleagueukhub.com/teams/${data.team}`, "sport": "Football" },
    "affiliation": { "@type": "SportsTeam", "name": data.teamName, "sport": "Football" },
    "image": `https://ballerleagueukhub.com/og/managers/${slug}.png`,
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": managerFaqs.map((f) => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } })),
  },
] : undefined;

const color = teamColor(data?.team);
const colorSoft = teamColorSoft(data?.team, 0.18);
const formerClubs: string[] = data?.formerClubs ?? [];
const honours: string[] = data?.honours ?? [];
---

{!data ? (
  <Base title="Manager Not Found" description="Manager not found.">
    <div class="page-header"><div class="container"><h1>Manager Not Found</h1><a href="/managers">Back to Managers</a></div></div>
  </Base>
) : (
  <Base
    title={`${data.name} — ${data.teamName} ${data.role} | Baller League UK`}
    description={`${isActive ? `${data.name} is the ${data.role.toLowerCase()} of ${data.teamName} in Baller League UK Season ${SEASON}.` : `${data.name} previously managed ${data.teamName} in Baller League UK.`} ${data.bio?.replace(/\n/g, ' ').trim().substring(0, 120)}...`}
    schema={schema}
    image={`/og/managers/${slug}.png`}
    keywords={`${data.name}, ${data.teamName}, Baller League UK manager, celebrity manager, ${data.role.toLowerCase()}`}
  >
    <div class="profile" style={`--team-color:${color}; --team-soft:${colorSoft};`}>
      <header class="profile-hero">
        <div class="container">
          <Breadcrumb items={[{name:'Home',url:'/'},{name:'Managers',url:'/managers'},{name:data.name}]} />
          <div class="profile-hero-grid">
            <div class="profile-photo-wrap">
              <img
                src={`/managers/${data.image || slug}.webp`}
                alt={data.name}
                class="profile-photo"
                loading="eager"
                onerror="this.hidden=true;this.nextElementSibling.hidden=false"
              />
              <div class="profile-photo-fallback" hidden>{initials(data.name)}</div>
            </div>
            <div class="profile-hero-info">
              <div class="profile-eyebrow">
                {isActive
                  ? `${data.role}${standing && standing.played > 0 ? ` · #${standing.pos} in league` : ''}`
                  : 'Former manager'}
              </div>
              <h1 class="profile-name">{data.name}</h1>
              <a href={`/teams/${data.team}`} class="profile-club">
                <img class="profile-club-crest" src={`/logos/${data.team}.svg`} alt={data.teamName} onerror="this.style.visibility='hidden'" />
                <span class="profile-club-text">
                  <span class="profile-club-label">Club</span>
                  <span class="profile-club-name">{data.teamName}</span>
                </span>
              </a>
            </div>
          </div>
        </div>
      </header>

      <div class="container profile-page">
        <div class="profile-layout">
          <main class="profile-main">
            <section class="profile-card">
              <h2 class="profile-h2">About {data.name}</h2>
              <div class="profile-prose">
                {data.bio?.split('\n').filter(Boolean).map((p: string) => (
                  <p>{p.trim()}</p>
                ))}
              </div>
            </section>

            {(formerClubs.length > 0 || !!playingPosition) && (
              <section class="profile-card">
                <h2 class="profile-h2">Playing career</h2>
                {playingPosition && <p class="profile-note">Position: <strong>{playingPosition}</strong></p>}
                {formerClubs.length > 0 && (
                  <div class="profile-chips">
                    {formerClubs.map((club) => <span class="profile-chip">{club}</span>)}
                  </div>
                )}
              </section>
            )}

            {honours.length > 0 && (
              <section class="profile-card">
                <h2 class="profile-h2">Honours &amp; achievements</h2>
                <ul class="profile-honours">
                  {honours.map((h) => <li>{h}</li>)}
                </ul>
              </section>
            )}

            {careerHighlights.length > 0 && (
              <section class="profile-card">
                <h2 class="profile-h2">Before Baller League</h2>
                <ul class="profile-honours">
                  {careerHighlights.map((h) => <li>{h}</li>)}
                </ul>
              </section>
            )}

            {managerialCareer.length > 0 && (
              <section class="profile-card">
                <h2 class="profile-h2">Managerial career</h2>
                <ul class="profile-honours">
                  {managerialCareer.map((m) => <li>{m}</li>)}
                </ul>
              </section>
            )}

            {didYouKnow.length > 0 && (
              <section class="profile-card">
                <h2 class="profile-h2">Did you know?</h2>
                <ul class="profile-honours">
                  {didYouKnow.map((d) => <li>{d}</li>)}
                </ul>
              </section>
            )}

            {managerFaqs.length > 0 && (
              <section class="profile-card">
                <h2 class="profile-h2">Frequently asked questions</h2>
                <div class="faq-list">
                  {managerFaqs.map((f) => (
                    <details class="faq-item">
                      <summary>{f.q}</summary>
                      <p>{f.a}</p>
                    </details>
                  ))}
                </div>
              </section>
            )}
          </main>

          <aside class="profile-side">
            <div class="profile-card">
              <h2 class="profile-h2">Quick Facts</h2>
              <dl class="profile-facts">
                {data.nationality && <div class="profile-fact"><dt>Nationality</dt><dd>{data.nationality}</dd></div>}
                {bornDisplay && <div class="profile-fact"><dt>Born</dt><dd>{bornDisplay}</dd></div>}
                {data.birthplace && <div class="profile-fact"><dt>Birthplace</dt><dd>{data.birthplace}</dd></div>}
                {playingPosition && <div class="profile-fact"><dt>Position</dt><dd>{playingPosition}</dd></div>}
                <div class="profile-fact"><dt>Club</dt><dd><img src={`/logos/${data.team}.svg`} alt={data.teamName} class="profile-fact-crest" onerror="this.style.display='none'" /> <a href={`/teams/${data.team}`}>{data.teamName}</a></dd></div>
                <div class="profile-fact"><dt>Seasons managed</dt><dd>{seasonsLabel}</dd></div>
              </dl>
            </div>

            <div class="profile-card">
              <h2 class="profile-h2">Record in charge</h2>
              <p class="profile-note">{seasonsLabel} · {record.played} match{record.played === 1 ? '' : 'es'} with {data.teamName}</p>
              <dl class="profile-facts">
                <div class="profile-fact"><dt>Wins</dt><dd>{record.won}</dd></div>
                <div class="profile-fact"><dt>Draws</dt><dd>{record.drawn}</dd></div>
                <div class="profile-fact"><dt>Losses</dt><dd>{record.lost}</dd></div>
                <div class="profile-fact"><dt>Goals</dt><dd>{record.gf}–{record.ga}</dd></div>
                <div class="profile-fact"><dt>Goal difference</dt><dd>{record.gf - record.ga > 0 ? `+${record.gf - record.ga}` : record.gf - record.ga}</dd></div>
                <div class="profile-fact"><dt>Points per game</dt><dd>{ppg}</dd></div>
              </dl>
              {!isActive && <p class="profile-note">Club now: <a href={`/teams/${data.team}`}>{data.teamName}</a>.</p>}
            </div>

            {isActive && form.length > 0 && (
              <div class="profile-card">
                <h2 class="profile-h2">Recent Form</h2>
                <div class="form-bar">
                  {form.map((f, i) => (
                    <span class={`form-block ${f.cls}`} title={`Match ${i + 1}: ${f.label}`}>{f.label}</span>
                  ))}
                </div>
              </div>
            )}

            {isActive && latestMatch && (
              <div class="profile-card">
                <h2 class="profile-h2">Latest Result</h2>
                <a class="fixture-line" href={`/match/s${SEASON}-${matchSlug(latestMatch)}`}>
                  {latestMatch.homeTeam} {latestMatch.homeScore}–{latestMatch.awayScore} {latestMatch.awayTeam}
                </a>
                <p class="fixture-meta">Gameweek {latestMatch.gameweek}{latestMatch.matchDate ? ` · ${latestMatch.matchDate}` : ''}</p>
              </div>
            )}

            {isActive && nextFixture && (
              <div class="profile-card">
                <h2 class="profile-h2">Next Fixture</h2>
                <p class="fixture-line">{nextFixture.homeTeam} vs {nextFixture.awayTeam}</p>
                <p class="fixture-meta">Gameweek {nextFixture.gameweek}{nextFixture.date ? ` · ${nextFixture.date}` : ''}{nextFixture.time ? ` · ${nextFixture.time}` : ''}</p>
              </div>
            )}

            {isActive && rankedPlayers.length > 0 && (
              <div class="profile-card">
                <h2 class="profile-h2">Top Scorers</h2>
                <div class="scorer-list">
                  {rankedPlayers.map(p => (
                    <div class="scorer-row">
                      {nameBySlug[p.player.toLowerCase()]
                        ? <a class="scorer-name" href={`/players/${nameBySlug[p.player.toLowerCase()]}`}>{p.player}</a>
                        : <span class="scorer-name">{p.player}</span>}
                      <span class="scorer-goals">{p.goals} goal{p.goals !== 1 ? 's' : ''}</span>
                    </div>
                  ))}
                </div>
              </div>
            )}

            <a href={`/teams/${data.team}`} class="btn btn-secondary" style="display:block;text-align:center;">View {data.teamName} Squad</a>
            <a href={`/reports/teams/${data.team}`} class="btn btn-ghost" style="display:block;text-align:center;">Match Reports</a>
            <a href="/explainers" class="btn btn-ghost" style="display:block;text-align:center;">Explainers</a>
            <a href="/managers" class="btn btn-ghost" style="display:block;text-align:center;">All Managers</a>
          </aside>
        </div>
      </div>
    </div>
  </Base>
)}

<style>
.form-bar { display: flex; gap: 4px; flex-wrap: wrap; }
.profile-note { font-size: 0.8rem; color: var(--text-muted); line-height: 1.5; margin-bottom: var(--space-sm); }
.profile-fact-crest { width: 20px; height: 20px; object-fit: contain; vertical-align: middle; margin-right: 6px; }
.faq-list { display: flex; flex-direction: column; gap: var(--space-sm); margin-top: var(--space-sm); }
.faq-item { background: var(--bg-elevated); border: 1px solid var(--border); border-radius: var(--radius); }
.faq-item summary { padding: var(--space-md); font-weight: 600; font-size: 0.92rem; color: var(--text-primary); cursor: pointer; list-style: none; }
.faq-item summary::-webkit-details-marker { display: none; }
.faq-item p { padding: 0 var(--space-md) var(--space-md); font-size: 0.9rem; color: var(--text-secondary); line-height: 1.6; margin: 0; }
.form-block { width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; border-radius: var(--radius-sm); font-size: 0.75rem; font-weight: 700; }
.form-win { background: var(--green-glow); color: var(--green); }
.form-draw { background: rgba(255,193,7,0.15); color: #ffc107; }
.form-loss { background: rgba(255,71,87,0.15); color: #ff4757; }
.scorer-list { display: flex; flex-direction: column; gap: var(--space-sm); }
.scorer-row { display: flex; justify-content: space-between; align-items: center; padding: var(--space-xs) 0; border-bottom: 1px solid var(--border-subtle); }
.scorer-row:last-child { border-bottom: none; }
.scorer-name { font-size: 0.9rem; color: var(--text-primary); font-weight: 500; }
a.scorer-name:hover { color: var(--team-color); }
.scorer-goals { font-size: 0.85rem; color: var(--team-color); font-weight: 600; }
.fixture-line { display: block; font-size: 0.9rem; font-weight: 600; color: var(--text-primary); line-height: 1.45; }
a.fixture-line:hover { color: var(--team-color); }
.fixture-meta { font-size: 0.78rem; color: var(--text-muted); margin-top: 4px; }
</style>
