---
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { getCollection } from 'astro:content';
import playerData from '../../data/players.json';
import { CURRENT_SEASON, playedMatches, standingsFor, teamColor, teamColorSoft } from '../../lib/league';

const nameBySlug: Record<string, string> = {};
for (const p of (playerData.players as any[])) nameBySlug[p.name.toLowerCase()] = p.slug;

export async function getStaticPaths() {
  const managers = await getCollection('managers');
  return managers.map(m => ({ params: { slug: m.slug }, props: { slug: m.slug } }));
}

const { slug } = Astro.props;
const managers = await getCollection('managers');
const manager = managers.find(m => m.slug === slug);
const data = manager?.data;

const SEASON = CURRENT_SEASON;
const standing = standingsFor(SEASON).find((t) => t.slug === data?.team);
const seasonMatches = playedMatches(SEASON);

function initials(name: string): string {
  return name.split(' ').map((n) => n[0]).join('').slice(0, 2).toUpperCase();
}

function getForm(teamSlug: string): { label: string; cls: string }[] {
  return seasonMatches
    .filter((x: any) => x.homeSlug === teamSlug || x.awaySlug === teamSlug)
    .sort((a: any, b: any) => b.gameweek - a.gameweek)
    .slice(0, 5)
    .map((x: any) => {
      const isHome = x.homeSlug === teamSlug;
      const gd = isHome ? x.homeScore - x.awayScore : x.awayScore - x.homeScore;
      if (gd > 0) return { label: 'W', cls: 'form-win' };
      if (gd < 0) return { label: 'L', cls: 'form-loss' };
      return { label: 'D', cls: 'form-draw' };
    });
}

const form = data ? getForm(data.team) : [];

const topPlayers = seasonMatches
  .flatMap((m: any) => {
    if (m.homeSlug !== data?.team && m.awaySlug !== data?.team) return [];
    return (m.goalscorers || []).map((g: any) => ({ ...g, gameweek: m.gameweek }));
  });

const playerTally: Record<string, { player: string; goals: number; lastGW: number }> = {};
for (const g of topPlayers) {
  if (!playerTally[g.player]) playerTally[g.player] = { player: g.player, goals: 0, lastGW: 0 };
  playerTally[g.player].goals++;
  if (g.gameweek > playerTally[g.player].lastGW) playerTally[g.player].lastGW = g.gameweek;
}
const rankedPlayers = Object.values(playerTally).sort((a, b) => b.goals - a.goals).slice(0, 3);

const schema = data ? [
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "name": data.name,
    "description": data.bio?.replace(/\n/g, ' ').trim() || `${data.name} manages ${data.teamName} in Baller League UK.`,
    "jobTitle": data.role,
    "memberOf": { "@type": "SportsTeam", "name": data.teamName, "url": `https://ballerleagueukhub.com/teams/${data.team}`, "sport": "Football" },
    "affiliation": { "@type": "SportsTeam", "name": data.teamName, "sport": "Football" },
    "image": `https://ballerleagueukhub.com/og/managers/${slug}.png`,
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": `Which team does ${data.name} manage in Baller League UK?`,
        "acceptedAnswer": { "@type": "Answer", "text": `${data.name} is the ${data.role} of ${data.teamName} in Baller League UK.` },
      },
    ],
  },
] : undefined;

const color = teamColor(data?.team);
const colorSoft = teamColorSoft(data?.team, 0.18);
const formerClubs: string[] = data?.formerClubs ?? [];
const honours: string[] = data?.honours ?? [];
const hasBackground = formerClubs.length > 0 || honours.length > 0;
---

{!data ? (
  <Base title="Manager Not Found" description="Manager not found.">
    <div class="page-header"><div class="container"><h1>Manager Not Found</h1><a href="/managers">Back to Managers</a></div></div>
  </Base>
) : (
  <Base
    title={`${data.name} — ${data.teamName} ${data.role} | Baller League UK`}
    description={`${data.name} is the ${data.role.toLowerCase()} of ${data.teamName} in Baller League UK Season ${SEASON}. ${data.bio?.replace(/\n/g, ' ').trim().substring(0, 120)}...`}
    schema={schema}
    image={`/og/managers/${slug}.png`}
    keywords={`${data.name}, ${data.teamName}, Baller League UK manager, celebrity manager, ${data.role.toLowerCase()}`}
  >
    <div class="profile" style={`--team-color:${color}; --team-soft:${colorSoft};`}>
      <header class="profile-hero">
        <div class="container">
          <Breadcrumb items={[{name:'Home',url:'/'},{name:'Managers',url:'/managers'},{name:data.name}]} />
          <div class="profile-hero-grid">
            <div class="profile-photo-wrap">
              <img
                src={`/managers/${data.image || slug}.webp`}
                alt={data.name}
                class="profile-photo"
                loading="eager"
                onerror="this.hidden=true;this.nextElementSibling.hidden=false"
              />
              <div class="profile-photo-fallback" hidden>{initials(data.name)}</div>
            </div>
            <div class="profile-hero-info">
              <div class="profile-eyebrow">
                {data.role}{standing && standing.played > 0 ? ` · #${standing.pos} in league` : ''}
              </div>
              <h1 class="profile-name">{data.name}</h1>
              <a href={`/teams/${data.team}`} class="profile-club">
                <img class="profile-club-crest" src={`/logos/${data.team}.svg`} alt={data.teamName} onerror="this.style.visibility='hidden'" />
                <span class="profile-club-text">
                  <span class="profile-club-label">Club</span>
                  <span class="profile-club-name">{data.teamName}</span>
                </span>
              </a>
            </div>
          </div>
        </div>
      </header>

      <div class="container profile-page">
        <div class="profile-layout">
          <main class="profile-main">
            <section class="profile-card">
              <h2 class="profile-h2">About {data.name}</h2>
              <div class="profile-prose">
                {data.bio?.split('\n').filter(Boolean).map((p: string) => (
                  <p>{p.trim()}</p>
                ))}
              </div>
            </section>

            {hasBackground && (
              <section class="profile-card">
                <h2 class="profile-h2">Background</h2>
                {formerClubs.length > 0 && (
                  <div class="profile-block">
                    <h3 class="profile-h3">Career</h3>
                    <div class="profile-chips">
                      {formerClubs.map((club) => <span class="profile-chip">{club}</span>)}
                    </div>
                  </div>
                )}
                {honours.length > 0 && (
                  <div class="profile-block">
                    <h3 class="profile-h3">Honours</h3>
                    <ul class="profile-honours">
                      {honours.map((h) => <li>{h}</li>)}
                    </ul>
                  </div>
                )}
              </section>
            )}
          </main>

          <aside class="profile-side">
            {standing && (
              <div class="profile-card">
                <h2 class="profile-h2">{data.teamName} Record</h2>
                <dl class="profile-facts">
                  <div class="profile-fact"><dt>Wins</dt><dd>{standing.won}</dd></div>
                  <div class="profile-fact"><dt>Draws</dt><dd>{standing.drawn}</dd></div>
                  <div class="profile-fact"><dt>Losses</dt><dd>{standing.lost}</dd></div>
                  <div class="profile-fact"><dt>Points</dt><dd>{standing.pts}</dd></div>
                  <div class="profile-fact"><dt>Goals</dt><dd>{standing.gf}–{standing.ga}</dd></div>
                </dl>
              </div>
            )}

            {form.length > 0 && (
              <div class="profile-card">
                <h2 class="profile-h2">Recent Form</h2>
                <div class="form-bar">
                  {form.map((f, i) => (
                    <span class={`form-block ${f.cls}`} title={`Match ${i + 1}: ${f.label}`}>{f.label}</span>
                  ))}
                </div>
              </div>
            )}

            {rankedPlayers.length > 0 && (
              <div class="profile-card">
                <h2 class="profile-h2">Top Scorers</h2>
                <div class="scorer-list">
                  {rankedPlayers.map(p => (
                    <div class="scorer-row">
                      {nameBySlug[p.player.toLowerCase()]
                        ? <a class="scorer-name" href={`/players/${nameBySlug[p.player.toLowerCase()]}`}>{p.player}</a>
                        : <span class="scorer-name">{p.player}</span>}
                      <span class="scorer-goals">{p.goals} goal{p.goals !== 1 ? 's' : ''}</span>
                    </div>
                  ))}
                </div>
              </div>
            )}

            <a href={`/teams/${data.team}`} class="btn btn-secondary" style="display:block;text-align:center;">View {data.teamName} Squad</a>
            <a href="/managers" class="btn btn-ghost" style="display:block;text-align:center;">All Managers</a>
          </aside>
        </div>
      </div>
    </div>
  </Base>
)}

<style>
.form-bar { display: flex; gap: 4px; flex-wrap: wrap; }
.form-block { width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; border-radius: var(--radius-sm); font-size: 0.75rem; font-weight: 700; }
.form-win { background: var(--green-glow); color: var(--green); }
.form-draw { background: rgba(255,193,7,0.15); color: #ffc107; }
.form-loss { background: rgba(255,71,87,0.15); color: #ff4757; }
.scorer-list { display: flex; flex-direction: column; gap: var(--space-sm); }
.scorer-row { display: flex; justify-content: space-between; align-items: center; padding: var(--space-xs) 0; border-bottom: 1px solid var(--border-subtle); }
.scorer-row:last-child { border-bottom: none; }
.scorer-name { font-size: 0.9rem; color: var(--text-primary); font-weight: 500; }
a.scorer-name:hover { color: var(--team-color); }
.scorer-goals { font-size: 0.85rem; color: var(--team-color); font-weight: 600; }
</style>
