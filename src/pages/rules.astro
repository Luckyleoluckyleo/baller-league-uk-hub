---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { CURRENT_SEASON } from '../lib/league';
import season4 from '../data/season4.json';

const venue = season4.venue;
const firstMD = season4.matchdays?.[0]?.date;
const lastMD = season4.matchdays?.[season4.matchdays.length - 1]?.date;

const faqs = [
  { q: "How does Baller League UK work?", a: "Baller League UK is 6-a-side football played indoors. Each match is 30 minutes, split into two 15-minute halves with a short half-time break and unlimited rolling substitutions. Twelve teams play 11 Monday-night matchdays, and the top four reach the Final Four playoffs to decide the champion." },
  { q: "What are the Game Changers?", a: "Twice per match — at the 12th minute and the 27th minute — a 'wheel of fortune' randomly selects a rule change. It applies for the final three minutes of that half. First-half options are Onside, Plus One and 3Play; second-half options are 1-on-1, The Line and Fairplay." },
  { q: "Are there corner kicks in Baller League UK?", a: "Corners are tallied rather than taken. When a team wins three corners, it is awarded a penalty. Play restarts with a goal kick." },
  { q: "Is there an offside rule in Baller League UK?", a: "Yes. Offside applies, with an offside line between the halfway line and the penalty area. It is only suspended during the Onside Game Changer, and offside is not in effect during a kick-in." },
  { q: "How does the scoring system work?", a: "A win is worth 3 points, a draw 1 point each, and a loss 0. In addition, the winner of the matchday penalty-shootout challenge (the Penalty Point) earns one extra point — shown as EP on the league table." },
  { q: "How many players are in a squad?", a: "Each team can register up to 12 permanent players, plus a manager and a coach. Teams may also nominate up to two wildcard players per matchday." },
  { q: "How do the playoffs work?", a: "After 11 matchdays, the top four teams qualify for the Final Four Day. The 1st-placed team plays 4th and 2nd plays 3rd in the semi-finals, with the winners meeting in the Final to be crowned champions." },
  { q: "Where is Baller League UK played?", a: `Matches are played at ${venue.name} in Dagenham, London (Eastbrook Studios, Yew Tree Avenue, RM10 7FN).` },
  { q: "Who won previous seasons?", a: "SDS FC won Season 1, Wembley Rangers AFC won Season 2 and Prime FC won Season 3. See the full history on the seasons archive." }
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": `Baller League UK Rules & Format — Season ${CURRENT_SEASON} Guide`,
    "description": "The complete Baller League UK rules and format guide: 6v6, 30-minute matches, Game Changers, time penalties, corners, scoring and the Final Four.",
    "author": { "@type": "Organization", "name": "Baller League UK Hub" },
    "dateModified": new Date().toISOString().split('T')[0],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map(f => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } })),
  },
];
---

<Base
  title={`Baller League UK Rules & Format — Season ${CURRENT_SEASON} Guide`}
  description="The complete Baller League UK rules for Season 4: 6v6 format, two 15-minute halves, Game Changers, kick-ins, corners, time penalties, wildcards, scoring and the Final Four playoffs."
  schema={schema}
  keywords="Baller League rules, Baller League UK format, how does Baller League work, 6v6 rules, Game Changers, offside, kick-ins, corners, time penalties, EP, Final Four"
  type="article"
>

  <div class="page-header">
    <div class="container">
      <Breadcrumb items={[{name:'Home',url:'/'},{name:'Rules'}]} />
      <div class="section-label">Official Guide · Season {CURRENT_SEASON}</div>
      <h1>Baller League UK — Rules &amp; Format</h1>
      <p class="section-subtitle">Everything you need to know about how Baller League UK works — from kick-off to the Final Four. Based on the official Season {CURRENT_SEASON} rulebook.</p>
    </div>
  </div>

  <div class="container rules-layout">

    <!-- QUICK SUMMARY STATS -->
    <div class="rules-summary grid-4">
      <div class="stat-box"><div class="stat-box-number">6v6</div><div class="stat-box-label">Players per side</div></div>
      <div class="stat-box"><div class="stat-box-number">2×15</div><div class="stat-box-label">Minute halves</div></div>
      <div class="stat-box"><div class="stat-box-number">12</div><div class="stat-box-label">Teams</div></div>
      <div class="stat-box"><div class="stat-box-number">11</div><div class="stat-box-label">Matchdays</div></div>
    </div>

    <div class="rules-content">

      <!-- 1. FORMAT -->
      <div class="rule-block card" id="format">
        <div class="card-body">
          <div class="rule-icon">⚽</div>
          <h2>The Basic Format</h2>
          <p>Baller League UK is a six-a-side football competition played indoors. Each team fields a maximum of <strong>six players</strong> at a time — five outfield players and a goalkeeper — and a team must have at least <strong>four players</strong> on the pitch for the match to continue.</p>
          <ul class="rule-list">
            <li>Matches last <strong>30 minutes</strong>: two 15-minute halves with a <strong>4–5 minute half-time break</strong>, after which the teams change ends</li>
            <li><strong>Rolling substitutions</strong> — players can be substituted on the fly, as often as the team likes</li>
            <li>Played on a <strong>50 × 29 metre</strong> artificial pitch with <strong>5.5 × 2.2 metre</strong> goals</li>
            <li>Each team is led by a <strong>manager and a coach</strong>, who handle tactics, line-ups and substitutions</li>
          </ul>
        </div>
      </div>

      <!-- 2. SQUAD / DRAFT -->
      <div class="rule-block card" id="squad">
        <div class="card-body">
          <div class="rule-icon">📝</div>
          <h2>Squads, Wildcards &amp; Transfers</h2>
          <p>Each team can register <strong>up to 12 permanent players</strong>, plus a manager and a coach. To keep the league competitive, squads are assembled through a draft and can be adjusted during the season.</p>

          <div class="key-rules-grid">
            <div class="key-rule yes-rule">
              <span class="key-rule-badge yes">DRAFT</span>
              <h4>Player Recruitment</h4>
              <p>Players enter the league via trials and a draft, where managers build their squads from the pool of grassroots, semi-pro and select players.</p>
            </div>
            <div class="key-rule yes-rule">
              <span class="key-rule-badge yes">PER MATCHDAY</span>
              <h4>Wildcards</h4>
              <p>Each team may nominate up to <strong>two wildcard players per matchday</strong> — often ex-pros or special guests — outside the permanent squad. A wildcard can only play for one team per season.</p>
            </div>
            <div class="key-rule yes-rule">
              <span class="key-rule-badge yes">AFTER MATCHDAY 5</span>
              <h4>Transfer Window</h4>
              <p>A trading window opens after Matchday 5: each team can make one direct trade with another team, plus one Wildcard or Draft Pool trade.</p>
            </div>
            <div class="key-rule no-rule">
              <span class="key-rule-badge">DEADLINE</span>
              <h4>Eligibility Lists</h4>
              <p>Teams must submit an eligible squad list of 10 players (8 squad + up to 2 wildcards) before each matchday. Players not on the list cannot feature.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- 3. KEY RULE DIFFERENCES -->
      <div class="rule-block card" id="rules">
        <div class="card-body">
          <div class="rule-icon">🚫</div>
          <h2>How the Rules Differ From Football</h2>
          <p>Baller League removes or rewrites several traditional rules to keep the game fast, high-scoring and easy to follow.</p>

          <div class="key-rules-grid">
            <div class="key-rule no-rule">
              <span class="key-rule-badge">KICK-INS, NOT THROW-INS</span>
              <h4>Kick-ins</h4>
              <p>When the ball goes out of play over the touchline, it is kicked back in rather than thrown. Offside is not in effect during a kick-in, and opponents must retreat two metres.</p>
            </div>
            <div class="key-rule yes-rule">
              <span class="key-rule-badge yes">3 = 1</span>
              <h4>Corners Become Penalties</h4>
              <p>Corners are counted, not taken. Win <strong>three corners</strong> and your team is awarded a <strong>penalty</strong>. The restart after a corner is a goal kick.</p>
            </div>
            <div class="key-rule yes-rule">
              <span class="key-rule-badge yes">INCLUDED</span>
              <h4>Offside Applies</h4>
              <p>Offside is in play, using a dedicated offside line between the halfway line and the penalty area. It is only suspended during the Onside Game Changer.</p>
            </div>
            <div class="key-rule no-rule">
              <span class="key-rule-badge">NO YELLOW CARDS</span>
              <h4>Two-Minute Time Penalties</h4>
              <p>Instead of yellow cards, the referee issues a <strong>two-minute time penalty</strong> (sin-bin), served on the penalty bench. Players can receive multiple in a game.</p>
            </div>
            <div class="key-rule no-rule">
              <span class="key-rule-badge">RED CARD</span>
              <h4>Sendings-off</h4>
              <p>A red card means the player leaves the pitch and cannot be replaced. Their team plays <strong>two minutes short-handed</strong>, or until they concede.</p>
            </div>
            <div class="key-rule yes-rule">
              <span class="key-rule-badge yes">10 SECONDS</span>
              <h4>Penalties</h4>
              <p>A penalty is a one-on-one: the taker runs from the centre line against the goalkeeper with a single attempt, completed within 10 seconds.</p>
            </div>
            <div class="key-rule yes-rule">
              <span class="key-rule-badge yes">VAR</span>
              <h4>Manager Challenges</h4>
              <p>Managers can use a flag to challenge a goal, corner, red card or two-minute penalty (up to three successful-retained challenges). The on-field decision stands unless clearly disproved.</p>
            </div>
            <div class="key-rule no-rule">
              <span class="key-rule-badge">30s CLOCK</span>
              <h4>Shot Clocks</h4>
              <p>During the 3Play and 1-on-1 Game Changers, a shot clock (30 seconds and 15 seconds respectively) forces teams to attack quickly or turn the ball over.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- 4. GAME CHANGERS -->
      <div class="rule-block card gamechanger-card" id="gamechanger">
        <div class="card-body">
          <div class="rule-icon">⚡</div>
          <div class="gc-badge">The Signature Rule</div>
          <h2>Game Changers</h2>
          <p class="gc-intro">Twice per match, a <strong>wheel of fortune</strong> randomly selects a rule change. In the <strong>first half it activates at the 12th minute</strong> and in the <strong>second half at the 27th minute</strong>, applying for the final three minutes of that half. The chosen rule affects both teams equally.</p>

          <h3 style="margin-top: var(--space-xl); margin-bottom: var(--space-lg); color: var(--green);">1st Half — activated at 12'</h3>
          <div class="gc-rules">
            <div class="gc-rule">
              <span class="gc-rule-num">01</span>
              <div>
                <h4>🏃 Onside</h4>
                <p>All offside rules are suspended. Players may position themselves freely anywhere on the pitch — expect chaos and a flurry of chances.</p>
              </div>
            </div>
            <div class="gc-rule">
              <span class="gc-rule-num">02</span>
              <div>
                <h4>➕ Plus One</h4>
                <p>The game restarts as a 1v1 (plus goalkeepers). After each goal, both teams add one outfield player, building up to full 5v5. No time penalties in this mode — fouls give away a penalty instead.</p>
              </div>
            </div>
            <div class="gc-rule">
              <span class="gc-rule-num">03</span>
              <div>
                <h4>⏱️ 3Play</h4>
                <p>Teams shrink to three-a-side, goalkeeper included. A 30-second shot clock runs per possession — lose the ball or run out of time and it is a turnover.</p>
              </div>
            </div>
          </div>

          <h3 style="margin-top: var(--space-xl); margin-bottom: var(--space-lg); color: var(--purple);">2nd Half — activated at 27'</h3>
          <div class="gc-rules">
            <div class="gc-rule">
              <span class="gc-rule-num">04</span>
              <div>
                <h4>⚔️ 1-on-1</h4>
                <p>A one-on-one duel. Each player stays in their own half with a 15-second shot clock per possession. Pure individual skill, with nowhere to hide.</p>
              </div>
            </div>
            <div class="gc-rule">
              <span class="gc-rule-num">05</span>
              <div>
                <h4>📏 The Line</h4>
                <p>Goals scored from in front of the offside line — in the attacking half — count <strong>double</strong>. Long-range shooting suddenly becomes the most valuable skill on the pitch.</p>
              </div>
            </div>
            <div class="gc-rule">
              <span class="gc-rule-num">06</span>
              <div>
                <h4>🟥 Fairplay</h4>
                <p>Any foul, deliberate handball or dissent results in an <strong>immediate send-off</strong> with no replacement. Discipline is everything.</p>
              </div>
            </div>
          </div>

          <div class="gc-callout">
            <strong>⚡ Why it matters:</strong> A lethal finisher wants 1-on-1, a disciplined side wants Fairplay, and a defence-first team dreads Plus One. The draw each half can decide a match — and the season. See our <a href="/news/baller-league-game-changers-explained">Game Changers explained</a> guide, or the full <a href="/gamechangers">Gamechanger analysis</a>.
          </div>
        </div>
      </div>

      <!-- 5. SEASON FORMAT -->
      <div class="rule-block card" id="season">
        <div class="card-body">
          <div class="rule-icon">🏆</div>
          <h2>Season Format</h2>

          <h3>Regular Season — 11 Matchdays</h3>
          <p>All 12 teams play over 11 Monday-night matchdays, each team playing once per matchday (every team plays every other team once). Matchdays run from <strong>{firstMD}</strong> to <strong>{lastMD}</strong>.</p>
          <ul class="rule-list">
            <li><strong>Win:</strong> 3 points</li>
            <li><strong>Draw:</strong> 1 point each</li>
            <li><strong>Loss:</strong> 0 points</li>
            <li><strong>EP (Extra Point):</strong> each matchday a penalty-shootout challenge (the Penalty Point) runs between matches; its winner earns <strong>+1 point</strong>, shown as EP on the <a href="/table">league table</a></li>
          </ul>
          <p>Where teams finish level on points, the tie is broken by goal difference, then goals scored, then the head-to-head result — and a shoot-out if still level.</p>

          <h3>Final Four Day</h3>
          <p>After 11 matchdays, the <strong>top four teams</strong> qualify for the Final Four, held on a single day at the end of the season.</p>
          <ul class="rule-list">
            <li><strong>Semi-final 1:</strong> 1st vs 4th</li>
            <li><strong>Semi-final 2:</strong> 2nd vs 3rd</li>
            <li><strong>Final:</strong> the two semi-final winners meet to decide the champion</li>
          </ul>
          <p>The Game Changers apply in every playoff match. If a Final Four tie is level after 30 minutes, it goes to a penalty shootout.</p>
        </div>
      </div>

      <!-- 6. MANAGERS -->
      <div class="rule-block card" id="managers">
        <div class="card-body">
          <div class="rule-icon">🎽</div>
          <h2>Managers &amp; Touchline</h2>
          <p>Every team is fronted by a celebrity or footballing manager, supported by a coach. The manager sets the tone and represents the club, while on matchdays the dugout has real influence through substitutions, the manager's VAR challenge and handling the Game Changers.</p>
          <a href="/managers" class="btn btn-secondary" style="margin-top: var(--space-md);">Meet the Managers</a>
        </div>
      </div>

      <!-- 7. FAQ -->
      <div class="rule-block card" id="faq">
        <div class="card-body">
          <div class="rule-icon">❓</div>
          <h2>Rules FAQ</h2>
          <div class="faq-list">
            {faqs.map(f => (
              <details class="faq-item">
                <summary>{f.q}</summary>
                <p>{f.a}</p>
              </details>
            ))}
          </div>
          <a href="/faq" class="btn btn-ghost" style="margin-top: var(--space-lg);">More questions? Read the full FAQ →</a>
        </div>
      </div>

    </div>

    <!-- SIDEBAR -->
    <aside class="rules-aside">
      <div class="card aside-card">
        <div class="card-body">
          <h4>On this page</h4>
          <ul class="aside-links">
            <li><a href="#format">Basic Format</a></li>
            <li><a href="#squad">Squads &amp; Wildcards</a></li>
            <li><a href="#rules">How the Rules Differ</a></li>
            <li><a href="#gamechanger">Game Changers</a></li>
            <li><a href="#season">Season Format</a></li>
            <li><a href="#managers">Managers</a></li>
            <li><a href="#faq">Rules FAQ</a></li>
          </ul>
        </div>
      </div>
      <div class="card aside-card">
        <div class="card-body">
          <h4>Related</h4>
          <ul class="aside-links">
            <li><a href="/faq">Frequently Asked Questions</a></li>
            <li><a href="/news/baller-league-game-changers-explained">Game Changers Explained</a></li>
            <li><a href="/news/baller-league-uk-glossary">Baller League Glossary</a></li>
            <li><a href="/teams">All 12 Teams</a></li>
            <li><a href="/table">Current Standings</a></li>
            <li><a href="/watch">Where to Watch</a></li>
          </ul>
        </div>
      </div>
    </aside>

  </div>

</Base>

<style>
.rules-layout {
  display: grid;
  grid-template-columns: 1fr 260px;
  grid-template-rows: auto auto;
  gap: var(--space-xl);
  padding-bottom: var(--space-3xl);
}
.rules-summary { grid-column: 1 / -1; margin-bottom: var(--space-sm); }
.rules-content { display: flex; flex-direction: column; gap: var(--space-lg); }
.rules-aside { display: flex; flex-direction: column; gap: var(--space-lg); align-self: start; position: sticky; top: calc(var(--nav-height) + 24px); }

.rule-icon { font-size: 2.4rem; margin-bottom: var(--space-md); }
.rule-block h2 { margin-bottom: var(--space-md); }
.rule-block h3 { font-size: 1.1rem; margin-top: var(--space-lg); margin-bottom: var(--space-sm); color: var(--text-primary); font-family: var(--font-body); font-weight: 700; }
.rule-block p  { margin-bottom: var(--space-md); }

.rule-list { list-style: none; display: flex; flex-direction: column; gap: var(--space-sm); }
.rule-list li { font-size: 0.92rem; color: var(--text-secondary); padding-left: var(--space-md); position: relative; }
.rule-list li::before { content: '→'; position: absolute; left: 0; color: var(--green); }
.rule-list li strong { color: var(--text-primary); }

/* Key Rules */
.key-rules-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-md); margin-top: var(--space-lg); }
.key-rule { background: var(--bg-elevated); border: 1px solid var(--border); border-radius: var(--radius); padding: var(--space-md); }
.key-rule.no-rule  { border-left: 3px solid var(--orange); }
.key-rule.yes-rule { border-left: 3px solid var(--green); }
.key-rule h4 { font-size: 0.95rem; font-family: var(--font-body); font-weight: 700; color: var(--text-primary); margin-bottom: var(--space-sm); }
.key-rule p { font-size: 0.85rem; margin: 0; }

.key-rule-badge {
  display: inline-block;
  font-size: 0.6rem;
  font-weight: 800;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--orange);
  border: 1px solid var(--orange);
  border-radius: var(--radius-full);
  padding: 2px 8px;
  margin-bottom: var(--space-sm);
}
.key-rule-badge.yes { color: var(--green); border-color: var(--green); }

/* Game Changer */
.gamechanger-card { border: 1px solid rgba(0,230,118,0.25); background: linear-gradient(135deg, var(--bg-card), rgba(0,230,118,0.04)); }
.gc-badge { display: inline-block; font-size: 0.68rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--green); border: 1px solid var(--green); border-radius: var(--radius-full); padding: 3px 10px; margin-bottom: var(--space-sm); }
.gc-intro { margin-bottom: var(--space-xl); }
.gc-rules { display: flex; flex-direction: column; gap: var(--space-lg); margin-bottom: var(--space-xl); }
.gc-rule { display: flex; gap: var(--space-lg); align-items: flex-start; }
.gc-rule-num { font-family: var(--font-display); font-size: 3rem; color: var(--green); opacity: 0.3; line-height: 1; flex-shrink: 0; width: 48px; }
.gc-rule h4 { font-size: 1rem; font-family: var(--font-body); font-weight: 700; color: var(--text-primary); margin-bottom: var(--space-xs); }
.gc-rule p { font-size: 0.88rem; margin: 0; }

.gc-callout {
  background: var(--green-glow);
  border: 1px solid rgba(0,230,118,0.2);
  border-radius: var(--radius);
  padding: var(--space-md);
  font-size: 0.9rem;
  color: var(--text-secondary);
  line-height: 1.6;
}
.gc-callout a { color: var(--green); text-decoration: underline; text-underline-offset: 2px; }

/* Aside */
.aside-card h4 { font-size: 0.8rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-muted); margin-bottom: var(--space-md); }
.aside-links { list-style: none; display: flex; flex-direction: column; gap: var(--space-sm); }
.aside-links li a { font-size: 0.88rem; color: var(--text-secondary); transition: color var(--transition); }
.aside-links li a:hover { color: var(--green); }

/* FAQ */
.faq-list { display: flex; flex-direction: column; gap: var(--space-sm); }
.faq-item { background: var(--bg-elevated); border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; }
.faq-item summary { padding: var(--space-md); font-weight: 600; font-size: 0.95rem; color: var(--text-primary); cursor: pointer; list-style: none; display: flex; justify-content: space-between; align-items: center; }
.faq-item summary::-webkit-details-marker { display: none; }
.faq-item summary::after { content: '+'; font-size: 1.2rem; color: var(--green); font-weight: 700; margin-left: var(--space-sm); transition: transform var(--transition); }
.faq-item[open] summary::after { content: '−'; }
.faq-item p { padding: 0 var(--space-md) var(--space-md); font-size: 0.9rem; color: var(--text-secondary); line-height: 1.6; margin: 0; }

@media (max-width: 900px) {
  .rules-layout { grid-template-columns: 1fr; }
  .rules-aside { position: static; }
  .key-rules-grid { grid-template-columns: 1fr; }
}
</style>
