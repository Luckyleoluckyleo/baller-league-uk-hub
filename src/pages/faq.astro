---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { CURRENT_SEASON } from '../lib/league';
import season4 from '../data/season4.json';

const venue = season4.venue;

const groups = [
  {
    title: "The Basics",
    items: [
      {
        q: "What is Baller League UK?",
        a: "Baller League UK is a <strong>6-a-side celebrity football competition</strong>. Twelve teams, each fronted by a famous manager, play fast, high-scoring indoor matches that include special rule twists called <strong>Game Changers</strong>. It is built for entertainment first — short matches, unlimited substitutions and a shot at the playoffs every season."
      },
      {
        q: "How does Baller League UK work?",
        a: `Twelve teams play <strong>11 Monday-night matchdays</strong>, each team playing once per matchday. Teams earn 3 points for a win, 1 for a draw, plus bonus <strong>EP</strong> points. After the regular season the top four reach the <strong>Final Four</strong> playoffs to decide the champion. Read the full <a href='/rules'>rules &amp; format guide</a>.`
      },
      {
        q: "How many teams are in Baller League UK?",
        a: "There are <strong>12 teams</strong> in Season 4: <a href='/teams/clutch-fc'>Clutch</a>, <a href='/teams/deportrio'>Deportrio</a>, <a href='/teams/gold-devils-fc'>Gold Devils</a>, <a href='/teams/n5-fc'>N5</a>, <a href='/teams/ndl-fc'>NDL</a>, <a href='/teams/rukkas-fc'>P17 FC</a>, <a href='/teams/prime-fc'>Prime</a>, <a href='/teams/yanited'>RTG FC</a>, <a href='/teams/sds-fc'>SDS</a>, <a href='/teams/toma'>Toma</a>, <a href='/teams/vzn-fc'>VZN</a> and <a href='/teams/wembley-rangers-afc'>Wembley Rangers</a>. See the <a href='/teams'>teams hub</a> and the <a href='/table'>league table</a>."
      },
      {
        q: "Who are the Baller League UK managers?",
        a: "The Season 4 managers include <a href='/managers/ksi'>KSI</a> (Prime), <a href='/managers/niko-omilana'>Niko Omilana</a> (NDL), <a href='/managers/micah-richards'>Micah Richards</a> (Deportrio), <a href='/managers/chloe-kelly'>Chloe Kelly</a> (Clutch), <a href='/managers/mark-goldbridge'>Mark Goldbridge</a> and <a href='/managers/spencer-owen'>Spencer Owen</a> (Gold Devils), <a href='/managers/jens-lehmann'>Jens Lehmann</a> (N5), <a href='/managers/alex-iwobi'>Alex Iwobi</a> (P17 FC), <a href='/managers/danny-aarons'>Danny Aarons</a> (RTG FC), <a href='/managers/sharky'>Sharky</a> (SDS), <a href='/managers/jay-jay-okocha'>Jay-Jay Okocha</a> (Toma) and <a href='/managers/tobi-brown'>Tobi Brown</a> (VZN). Wembley Rangers' manager is yet to be announced. See <a href='/managers'>all manager profiles</a>."
      },
      {
        q: "Where is Baller League UK played?",
        a: `Matches are played at the <strong>${venue.name}</strong> in Dagenham, London (${venue.address}).`
      }
    ]
  },
  {
    title: "Rules & Game Changers",
    items: [
      {
        q: "How long is a Baller League match?",
        a: "Matches last <strong>30 minutes</strong>, split into <strong>two 15-minute halves</strong> with a 4–5 minute half-time break. The clock is controlled by an official game clock and stops for penalties and stoppages."
      },
      {
        q: "How many players are in a Baller League squad?",
        a: "Each team can register up to <strong>12 permanent players</strong>, plus a manager and a coach. Teams may also nominate up to <strong>two wildcard players per matchday</strong>."
      },
      {
        q: "What are the Game Changers?",
        a: "Game Changers are the league's signature rule twists. Twice per match a 'wheel of fortune' selects one, which applies for the final three minutes of the half. First-half options are <strong>Onside</strong>, <strong>Plus One</strong> and <strong>3Play</strong>; second-half options are <strong>1-on-1</strong>, <strong>The Line</strong> and <strong>Fairplay</strong>. See our <a href='/news/baller-league-game-changers-explained'>Game Changers explained</a> guide."
      },
      {
        q: "When do the Game Changers happen?",
        a: "The first-half Game Changer activates at the <strong>12th minute</strong> and the second-half one at the <strong>27th minute</strong>. A 60-second countdown signals the change, which is then played out for the last three minutes of that half."
      },
      {
        q: "Are there corner kicks in Baller League UK?",
        a: "Corners are <strong>counted, not taken</strong>. When a team wins <strong>three corners</strong>, it is awarded a <strong>penalty</strong>. Play restarts with a goal kick."
      },
      {
        q: "Is there an offside rule?",
        a: "Yes. Offside applies, using a dedicated offside line between the halfway line and the penalty area. It is only suspended during the <strong>Onside</strong> Game Changer, and offside is not in effect during a kick-in."
      },
      {
        q: "Are there yellow cards?",
        a: "No. Instead of yellow cards, referees issue <strong>two-minute time penalties</strong> (sin-bins), served on the penalty bench. A red card means the player is sent off and their team plays two minutes short-handed or until they concede."
      },
      {
        q: "How do penalties work?",
        a: "A penalty is a one-on-one: the taker runs from the centre line against the goalkeeper and gets a single shot attempt, which must be completed within <strong>10 seconds</strong>."
      },
      {
        q: "What is the Wildcard rule?",
        a: "Each team can nominate up to <strong>two wildcards per matchday</strong> — special guest players, often ex-professionals — on top of their permanent squad. A wildcard can only play for one team in a season."
      },
      {
        q: "How do players join Baller League UK?",
        a: "Players enter via trials and a draft, with managers building squads from a pool of grassroots, semi-pro and select players. Squads can then be adjusted in a transfer window that opens after Matchday 5."
      }
    ]
  },
  {
    title: "Season, Table & Playoffs",
    items: [
      {
        q: "How many gameweeks are there?",
        a: `Season ${CURRENT_SEASON} features <strong>11 regular-season matchdays</strong>, followed by a <strong>Final Four Day</strong> to crown the champion. All 12 teams play on every matchday.`
      },
      {
        q: "How does the scoring system work?",
        a: "A win is worth <strong>3 points</strong>, a draw <strong>1 point</strong> each and a loss <strong>0</strong>. On top of that, the winner of each matchday's penalty-shootout challenge earns an extra point, shown as <strong>EP</strong> on the <a href='/table'>league table</a>. Where teams are level on points, goal difference then goals scored decide the order."
      },
      {
        q: "What is EP (the Pressure Point / Penalty Point)?",
        a: "Each matchday there is a penalty-shootout challenge between matches (referred to as the Penalty Point, or Pressure Point). The last player standing earns <strong>one extra point</strong> for their team. It appears as the <strong>EP</strong> column on the league table."
      },
      {
        q: "How do the playoffs work?",
        a: "After 11 matchdays, the <strong>top four teams</strong> reach the Final Four. The 1st-placed team plays 4th and 2nd plays 3rd in the semi-finals, with the winners meeting in the Final to decide the champion. A level Final Four tie goes to a penalty shootout."
      }
    ]
  },
  {
    title: "Watching",
    items: [
      {
        q: "Is Baller League UK on TV?",
        a: "No — from Season 4 the league is <strong>online-only</strong>. Matches stream on the league's own channels, including <strong>YouTube, Twitch and Kick</strong>, following the end of its Sky Sports deal. See our <a href='/watch'>where to watch guide</a>."
      },
      {
        q: "Is it free to watch?",
        a: "Yes. Because the league streams directly, matchdays are <strong>free to watch</strong> online from anywhere with an internet connection, alongside highlight clips on its social channels."
      },
      {
        q: "When are matches played?",
        a: "Matchdays are on <strong>Monday nights</strong>, with the first match around <strong>17:30</strong> and the last around <strong>22:20</strong>. Six matches are played across each evening."
      }
    ]
  },
  {
    title: "History",
    items: [
      {
        q: "Who won previous Baller League UK seasons?",
        a: "<strong>SDS FC</strong> won Season 1, <strong>Wembley Rangers</strong> won Season 2 and <strong>Prime FC</strong> won Season 3. See the full <a href='/season'>seasons archive</a> and our <a href='/news/baller-league-uk-history'>complete history</a>."
      },
      {
        q: "Is Baller League connected to the Kings League?",
        a: "They are separate competitions. Baller League began in Germany and expanded to the UK in 2025, sharing some DNA with Spain's Kings League (founded by Gerard Piqué) — 6v6 football, celebrity involvement and special rules — but with its own format and Game Changer system."
      }
    ]
  }
];

const stripTags = (s: string) =>
  s.replace(/<[^>]+>/g, "").replace(/&amp;/g, "&").replace(/&middot;/g, "·").replace(/\s+/g, " ").trim();

const schema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": groups.flatMap(g => g.items).map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": stripTags(f.a) }
  }))
};
---

<Base
  title="Baller League UK FAQ — Rules, Format, Game Changers & Watching"
  description="Frequently asked questions about Baller League UK: how the 6v6 format works, the Game Changers, wildcards, EP, the Final Four, managers, and how to watch for free."
  schema={schema}
  keywords="Baller League FAQ, how does Baller League work, Baller League rules explained, Baller League Game Changers, Baller League wildcard, is Baller League free, who won Baller League"
>
  <div class="page-header">
    <div class="container">
      <Breadcrumb items={[{name:'Home',url:'/'},{name:'FAQ'}]} />
      <div class="section-label">Questions &amp; Answers</div>
      <h1>Baller League UK — FAQ</h1>
      <p class="section-subtitle">Everything you need to know about the 6v6 celebrity football league — rules, Game Changers, the season, and how to watch, updated for Season {CURRENT_SEASON}.</p>
    </div>
  </div>

  <div class="container faq-page">
    <div class="faq-intro card">
      <div class="card-body">
        <p><strong>New to the Baller League?</strong> This FAQ covers the basics of the format, the signature Game Changers, squads and wildcards, how the table and playoffs work, and where to watch. For the full detail, read the <a href="/rules">rules &amp; format guide</a>.</p>
      </div>
    </div>

    {groups.map(group => (
      <section class="faq-group">
        <h2 class="faq-group-title">{group.title}</h2>
        <div class="faq-list">
          {group.items.map(faq => (
            <div class="faq-item card">
              <div class="card-body">
                <h3>{faq.q}</h3>
                <p set:html={faq.a} />
              </div>
            </div>
          ))}
        </div>
      </section>
    ))}

    <div class="faq-cta card" style="margin-top: var(--space-xl);">
      <div class="card-body text-center">
        <h3 style="margin-bottom: var(--space-md);">Still have questions?</h3>
        <p class="text-muted" style="margin-bottom: var(--space-lg);">Explore the full site for detailed stats, tables and analysis.</p>
        <div style="display: flex; gap: var(--space-md); justify-content: center; flex-wrap: wrap;">
          <a href="/rules" class="btn btn-primary">Rules &amp; Format</a>
          <a href="/guide" class="btn btn-ghost">Ultimate Guide</a>
          <a href="/news/baller-league-uk-glossary" class="btn btn-ghost">Glossary</a>
          <a href="/table" class="btn btn-ghost">League Table</a>
        </div>
      </div>
    </div>
  </div>
</Base>

<style>
.faq-page {
  padding: var(--space-2xl) 0 var(--space-3xl);
  max-width: 820px;
}

.faq-intro {
  margin-bottom: var(--space-2xl);
  border-left: 3px solid var(--green);
}
.faq-intro a { color: var(--green); text-decoration: underline; text-underline-offset: 2px; }

.faq-group { margin-bottom: var(--space-2xl); }
.faq-group-title {
  font-family: var(--font-display);
  font-size: 1.5rem;
  letter-spacing: 0.02em;
  color: var(--text-primary);
  margin-bottom: var(--space-md);
  padding-bottom: var(--space-sm);
  border-bottom: 1px solid var(--border);
}

.faq-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
}

.faq-item h3 {
  font-size: 1.1rem;
  color: var(--green);
  margin-bottom: var(--space-sm);
  font-family: var(--font-body);
  font-weight: 700;
  line-height: 1.4;
}

.faq-item p {
  font-size: 0.98rem;
  line-height: 1.7;
  color: var(--text-secondary);
  margin: 0;
}

.faq-item :global(a) {
  color: var(--green);
  text-decoration: underline;
  text-underline-offset: 2px;
}
.faq-item :global(a:hover) { color: var(--green-mid); }
.faq-item :global(strong) { color: var(--text-primary); font-weight: 700; }
</style>
