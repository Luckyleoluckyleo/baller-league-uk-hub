---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import season4 from '../data/season4.json';

const venue = season4.venue;
const tickets = season4.tickets;
const ticketsUrl = season4.ticketsUrl;
const matchdays = season4.matchdays;

const faqs = [
  { q: "Where is the Baller League Arena?", a: `The Baller League Arena is at ${venue.name}, ${venue.address}.` },
  { q: "How do I get Baller League tickets?", a: "Tickets are sold through the league's official partner, Fever. Use the Buy tickets link on this page for Single Matchday, Baller Bundle and Baller Pass options." },
  { q: "What time do Baller League matches start?", a: "Matchdays are on Monday nights, with six matches running back-to-back and kick-offs from around 17:15 to 21:50." },
  { q: "How many matches are on at one matchday?", a: "All 12 teams are in action, so a single ticket covers six matches across the evening." },
  { q: "Can I watch Baller League UK online?", a: "Yes. Season 4 matches are streamed online-only. See the where to watch page for the latest options." },
  { q: "Is the Baller League Arena indoors?", a: "Yes — the Baller League Arena is an indoor studio venue built for the league's fast 6v6 format." },
];

const placeSchema = {
  "@context": "https://schema.org",
  "@type": "Place",
  "name": venue.name,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Eastbrook Studios, Yew Tree Avenue",
    "addressLocality": "Dagenham",
    "addressRegion": "London",
    "postalCode": "RM10 7FN",
    "addressCountry": "GB",
  },
  "description": "Indoor home of Baller League UK Season 4, hosting six back-to-back 6v6 matches on Monday nights.",
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((f) => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } })),
};
---

<Base
  title="Baller League Arena 2026 — Tickets, Travel & Matchday Guide"
  description={`The Baller League Arena at Eastbrook Studios, Dagenham: how to get there, ticket options, Monday matchday schedule and what to expect at Baller League UK Season 4.`}
  keywords="Baller League Arena, Baller League Arena Dagenham, Baller League tickets, Baller League venue, Eastbrook Studios, Baller League matchday"
  schema={[placeSchema, faqSchema]}
>
  <div class="page-header">
    <div class="container">
      <Breadcrumb items={[{ name: 'Home', url: '/' }, { name: 'Arena & Tickets' }]} />
      <div class="section-label">Venue &amp; tickets</div>
      <h1>Baller League Arena</h1>
      <p class="section-subtitle">
        {venue.name} · {venue.address}
      </p>
      <div class="arena-actions">
        <a href={ticketsUrl} target="_blank" rel="noopener noreferrer" class="btn btn-gold btn-lg">Buy tickets →</a>
        <a href="/news/baller-league-arena-tickets-guide" class="btn btn-secondary">Full tickets guide</a>
      </div>
    </div>
  </div>

  <div class="container arena-page">
    <div class="arena-stats">
      <div class="stat-box"><div class="stat-box-number">6v6</div><div class="stat-box-label">Format</div></div>
      <div class="stat-box"><div class="stat-box-number">6</div><div class="stat-box-label">Matches a night</div></div>
      <div class="stat-box"><div class="stat-box-number">Mon</div><div class="stat-box-label">Matchday</div></div>
      <div class="stat-box"><div class="stat-box-number">17:15</div><div class="stat-box-label">First kick-off</div></div>
    </div>

    <section class="arena-section">
      <h2>Where is the Baller League Arena?</h2>
      <p>
        Baller League UK Season 4 is played at the <strong>{venue.name}</strong> at <strong>{venue.address}</strong>.
        The venue is an indoor studio arena in Dagenham, East London, built around the league's fast 6v6 format with the crowd close to the action.
      </p>
      <p>
        For the full venue, travel and ticket breakdown, read our
        <a href="/news/baller-league-arena-tickets-guide">Baller League Arena tickets guide</a>.
      </p>
    </section>

    <section class="arena-section">
      <h2>Tickets</h2>
      <div class="ticket-grid">
        <div class="card"><div class="card-body"><h3>Single Matchday</h3><p>{tickets.singleMatchday}</p></div></div>
        <div class="card"><div class="card-body"><h3>Baller Bundle</h3><p>{tickets.ballerBundle}</p></div></div>
        <div class="card"><div class="card-body"><h3>Baller Pass</h3><p>{tickets.ballerPass}</p></div></div>
      </div>
      <p class="arena-cta">
        <a href={ticketsUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary">Check availability on Fever →</a>
      </p>
    </section>

    <section class="arena-section">
      <h2>Getting there</h2>
      <p>
        Dagenham is in East London and is served by the District line and National Rail. Check Transport for London
        and National Rail before you travel, allow extra time at peak hours, and follow the venue's guidance on gates and entry times.
      </p>
    </section>

    <section class="arena-section">
      <h2>Season 4 matchdays</h2>
      <div class="matchday-grid">
        {matchdays.map((md) => (
          <div class="matchday-item"><span class="matchday-num">MD{md.n}</span><span class="matchday-date">{md.date}</span></div>
        ))}
      </div>
      <p><a href="/fixtures">See the full fixture schedule →</a></p>
    </section>

    <section class="arena-section">
      <h2>Baller League Arena FAQ</h2>
      <div class="faq-list">
        {faqs.map((f) => (
          <details class="faq-item">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <p class="arena-related">
      Planning your visit? Read the <a href="/news/baller-league-arena-tickets-guide">venue and tickets guide</a>,
      check the <a href="/fixtures">fixtures</a>, or learn the <a href="/rules">rules</a> before you go.
    </p>
  </div>
</Base>

<style>
.arena-page { padding-bottom: var(--space-3xl); }
.arena-actions { display: flex; flex-wrap: wrap; gap: var(--space-sm); margin-top: var(--space-md); }
.arena-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-sm); margin-bottom: var(--space-2xl); }
.arena-section { margin-bottom: var(--space-2xl); }
.arena-section h2 { font-size: 1.6rem; margin-bottom: var(--space-md); }
.arena-section p { color: var(--text-secondary); line-height: 1.8; max-width: 820px; }
.arena-section a { color: var(--green); }
.ticket-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: var(--space-md); }
.ticket-grid h3 { font-size: 1rem; color: var(--text-primary); margin-bottom: var(--space-sm); }
.ticket-grid p { color: var(--text-secondary); line-height: 1.6; margin: 0; }
.arena-cta { margin-top: var(--space-lg); }
.matchday-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: var(--space-sm); margin-bottom: var(--space-md); }
.matchday-item { display: flex; justify-content: space-between; gap: var(--space-sm); padding: var(--space-sm) var(--space-md); background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius); }
.matchday-num { font-weight: 700; color: var(--green); font-size: 0.78rem; }
.matchday-date { color: var(--text-secondary); font-size: 0.82rem; }
.faq-list { display: flex; flex-direction: column; gap: var(--space-sm); max-width: 820px; }
.faq-item { background: var(--bg-elevated); border: 1px solid var(--border); border-radius: var(--radius); }
.faq-item summary { padding: var(--space-md); font-weight: 600; color: var(--text-primary); cursor: pointer; list-style: none; }
.faq-item summary::-webkit-details-marker { display: none; }
.faq-item p { padding: 0 var(--space-md) var(--space-md); color: var(--text-secondary); line-height: 1.7; margin: 0; }
.arena-related { margin-top: var(--space-xl); color: var(--text-secondary); }
.arena-related a { color: var(--green); }
@media (max-width: 640px) { .arena-stats { grid-template-columns: 1fr 1fr; } }
</style>
