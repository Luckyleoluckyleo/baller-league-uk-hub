---
import Base from '../layouts/Base.astro';
import NewsCard from '../components/NewsCard.astro';
import TeamCard from '../components/TeamCard.astro';
import MiniLeaderboard from '../components/MiniLeaderboard.astro';
import { getCollection } from 'astro:content';
import fixturesData from '../data/fixtures.json';
import playersData from '../data/players.json';
import season4 from '../data/season4.json';
import { CURRENT_SEASON, playedMatches, standingsFor, formFor, matchSlug } from '../lib/league';

const updateDate = new Date().toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });

const allNews = await getCollection('news');

function extractGW(slug: string): number {
  const m = slug.match(/(?:gw|gameweek[-]?)(\d+)/i);
  return m ? parseInt(m[1]) : 0;
}

const latestNews = allNews
  .filter(a => a.data.category === 'Match Report')
  .sort((a, b) => extractGW(b.slug) - extractGW(a.slug))
  .slice(0, 3);

const upcomingFixtures = fixturesData.upcoming;
const isFinalFour = upcomingFixtures[0]?.round != null;
const upcomingGW = upcomingFixtures[0]?.gameweek ?? 1;

// Played matches for the current season.
const currentMatches = playedMatches(CURRENT_SEASON);
const gws = [...new Set(currentMatches.map((m) => m.gameweek))].sort((a, b) => b - a);
const lastGW = gws[0] ?? 0;
const recentResults = currentMatches.filter((m) => m.gameweek === lastGW);

// Table is computed centrally: from results once played, else the official table.
const computedTable = standingsFor(CURRENT_SEASON);

// ---- Leaderboards (latest season that actually has stats) ----
const players = playersData.players as any[];
const hasCurrentStats = players.some((p: any) => (p.seasons?.[String(CURRENT_SEASON)]?.apps || 0) > 0);
const statsSeason = String(hasCurrentStats ? CURRENT_SEASON : CURRENT_SEASON - 1);
const st = (p: any) => p.seasons?.[statsSeason] || {};
const detail = (p: any, key: string) => (st(p).detailed ? st(p).detailed[key] : 0) || 0;
const topScorers = [...players].sort((a, b) => (st(b).goals || 0) - (st(a).goals || 0)).slice(0, 5);
const topAssists = [...players].sort((a, b) => (st(b).assists || 0) - (st(a).assists || 0)).slice(0, 5);
const bestDefence = [...computedTable].sort((a, b) => a.ga - b.ga).slice(0, 5);
const leader = computedTable[0];
const topScorer = topScorers[0];
const topAssist = topAssists[0];
const totalGoals = currentMatches.reduce((n, m) => n + m.homeScore + m.awayScore, 0);
const avgGoals = currentMatches.length ? (totalGoals / currentMatches.length).toFixed(1) : '0';

// Hero "at a glance" panel: show live stats once games are played, otherwise the
// Season 4 launch info + opening fixture.
const seasonStarted = currentMatches.length > 0;
const nextFixture = upcomingFixtures[0] ?? null;
const shortStart = (season4.startDate || '').replace(/\s*\d{4}$/, '');

function previewSlug(match: any): string {
  if (match.round) return `${match.homeSlug}-vs-${match.awaySlug}-final-four-preview`;
  return `${match.homeSlug}-vs-${match.awaySlug}-gw${match.gameweek}-preview`;
}

const schema = {
  "@context": "https://schema.org",
  "@type": "SportsOrganization",
  "name": "Baller League UK Hub",
  "url": "https://ballerleagueukhub.com",
  "description": "The unofficial hub for Baller League UK — the 6v6 celebrity and influencer football league. Live standings, match results, team profiles, player stats and Gamechanger analysis.",
  "sport": "Football",
  "location": { "@type": "Place", "name": "London, United Kingdom" },
  "sameAs": [
    "https://www.youtube.com/@BallerLeagueUK",
    "https://www.twitch.tv/ballerleagueuk",
    "https://www.instagram.com/ballerleagueuk",
    "https://www.tiktok.com/@BallerLeagueUK",
    "https://twitter.com/BallerLeagueUK"
  ]
};
---

<Base
  title="Baller League UK Hub — Stats, Table, Teams & Gamechangers"
  description="The unofficial Baller League UK fan hub. Live league table, upcoming fixtures, team profiles, player stats, Gamechanger analysis, weekly roundups and latest news."
  schema={schema}
  keywords="fixtures, results, standings, teams, players, gameweek, roundup"
>

  <!-- HERO -->
  <section class="hero">
    <div class="hero-grid-bg"></div>
    <div class="container hero-inner">
      <div class="hero-copy">
        <div class="hero-eyebrow">{seasonStarted ? `⚽ Season ${CURRENT_SEASON} — Gameweek ${lastGW} of 11` : `⚽ Season ${CURRENT_SEASON} kicks off ${shortStart}`}</div>
        <h1 class="hero-title">
          Your Hub for
          <span class="accent">Baller League UK</span>
        </h1>
        <p class="hero-subtitle">
          6v6 football. Celebrity managers. Every result, table, goal and Gamechanger — all in one place.
        </p>
        <div class="hero-actions">
          <a href="/table" class="btn btn-primary btn-lg">View League Table</a>
          <a href="/gamechangers" class="btn btn-secondary btn-lg">Gamechanger Stats</a>
          <a href="/watch" class="btn btn-ghost btn-lg">Watch Live</a>
        </div>
      </div>

      <aside class="hero-panel" aria-label={`Season ${CURRENT_SEASON} at a glance`}>
        <div class="hero-panel-head">
          <span class="hero-panel-title">Season {CURRENT_SEASON} at a glance</span>
          <span class="hero-panel-sub">{seasonStarted ? `${totalGoals} goals · ${avgGoals} per game` : `Starts ${shortStart}`}</span>
        </div>

        {seasonStarted ? (
          <div class="hero-panel-grid">
            <a href={`/teams/${leader.slug}`} class="hero-metric">
              <img src={`/logos/${leader.slug}.svg`} alt="" class="hero-metric-img" width="40" height="40" loading="lazy" onerror="this.remove()" />
              <span class="hero-metric-label">Leaders</span>
              <span class="hero-metric-value">{leader.team}</span>
              <span class="hero-metric-sub">{leader.pts} pts</span>
            </a>
            <a href={`/players/${topScorer.slug}`} class="hero-metric">
              <img src={`/players/thumb/${topScorer.slug}.webp`} alt="" class="hero-metric-img hero-metric-img--round" width="40" height="40" loading="lazy" onerror="this.style.visibility='hidden'" />
              <span class="hero-metric-label">Top scorer</span>
              <span class="hero-metric-value">{topScorer.name}</span>
              <span class="hero-metric-sub">{st(topScorer).goals || 0} goals</span>
            </a>
            <a href={`/players/${topAssist.slug}`} class="hero-metric">
              <img src={`/players/thumb/${topAssist.slug}.webp`} alt="" class="hero-metric-img hero-metric-img--round" width="40" height="40" loading="lazy" onerror="this.style.visibility='hidden'" />
              <span class="hero-metric-label">Most assists</span>
              <span class="hero-metric-value">{topAssist.name}</span>
              <span class="hero-metric-sub">{st(topAssist).assists || 0} assists</span>
            </a>
            <a href={`/teams/${bestDefence[0].slug}`} class="hero-metric">
              <img src={`/logos/${bestDefence[0].slug}.svg`} alt="" class="hero-metric-img" width="40" height="40" loading="lazy" onerror="this.remove()" />
              <span class="hero-metric-label">Best defence</span>
              <span class="hero-metric-value">{bestDefence[0].team}</span>
              <span class="hero-metric-sub">{bestDefence[0].ga} conceded</span>
            </a>
          </div>
        ) : (
          <>
            <div class="hero-facts">
              <a class="hero-fact" href="/season-4">
                <span class="hero-fact-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg></span>
                <span class="hero-fact-num">{shortStart.split(' ')[0]}<span class="hero-fact-cap"> {shortStart.split(' ')[1] ?? ''}</span></span>
                <span class="hero-fact-lbl">Kick-off</span>
              </a>
              <a class="hero-fact" href="/teams">
                <span class="hero-fact-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg></span>
                <span class="hero-fact-num">{season4.format.teams}</span>
                <span class="hero-fact-lbl">Teams</span>
              </a>
              <a class="hero-fact" href="/fixtures">
                <span class="hero-fact-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m17 2 4 4-4 4"/><path d="M3 11v-1a4 4 0 0 1 4-4h14"/><path d="m7 22-4-4 4-4"/><path d="M21 13v1a4 4 0 0 1-4 4H3"/></svg></span>
                <span class="hero-fact-num">{season4.format.regularSeasonMatchdays}</span>
                <span class="hero-fact-lbl">Matchdays</span>
              </a>
              <a class="hero-fact" href="/rules">
                <span class="hero-fact-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg></span>
                <span class="hero-fact-num">{season4.format.matchesPerMatchday}</span>
                <span class="hero-fact-lbl">Games a night</span>
              </a>
            </div>

            {nextFixture && (
              <a class="hero-fixture" href={`/news/${previewSlug(nextFixture)}`}>
                <span class="hero-fixture-head">Opening night · Gameweek {nextFixture.gameweek}</span>
                <span class="hero-fixture-row">
                  <span class="hero-fixture-side">
                    <img src={`/logos/${nextFixture.homeSlug}.svg`} alt="" loading="lazy" onerror="this.style.visibility='hidden'" />
                    <span class="hero-fixture-name">{nextFixture.homeTeam}</span>
                  </span>
                  <span class="hero-fixture-vs">VS</span>
                  <span class="hero-fixture-side">
                    <img src={`/logos/${nextFixture.awaySlug}.svg`} alt="" loading="lazy" onerror="this.style.visibility='hidden'" />
                    <span class="hero-fixture-name">{nextFixture.awayTeam}</span>
                  </span>
                </span>
                <span class="hero-fixture-foot">
                  <span class="hero-fixture-date">{nextFixture.date} · {nextFixture.time}</span>
                  <span class="hero-fixture-cta">Preview →</span>
                </span>
              </a>
            )}
          </>
        )}

        <a href={seasonStarted ? '/gamechangers' : '/season-4'} class="hero-panel-link">{seasonStarted ? 'Full Gamechanger analysis' : 'Season 4 hub'} <span aria-hidden="true">→</span></a>
      </aside>
    </div>
  </section>

  <!-- LEADERBOARDS AT A GLANCE -->
  <section class="section section--sm">
    <div class="container">
      <div class="section-header flex-between">
        <div>
          <div class="section-label">Season {statsSeason}</div>
          <h2 class="section-title">Leaderboards</h2>
        </div>
        <a href="/players" class="view-all">All Players</a>
      </div>
      <div class="leaderboard-grid">
        <MiniLeaderboard
          title="Top Scorers"
          icon="⚽"
          rows={topScorers.map((p: any) => ({ name: p.name, url: `/players/${p.slug}`, photo: `/players/thumb/${p.slug}.webp`, team: p.team, teamLogo: `/logos/${p.teamSlug}.svg`, value: st(p).goals }))}
        />
        <MiniLeaderboard
          title="Top Assists"
          icon="🅰️"
          rows={topAssists.map((p: any) => ({ name: p.name, url: `/players/${p.slug}`, photo: `/players/thumb/${p.slug}.webp`, team: p.team, teamLogo: `/logos/${p.teamSlug}.svg`, value: st(p).assists }))}
        />
        <MiniLeaderboard
          title="Best Defence"
          icon="🛡️"
          valueLabel=" GA"
          rows={bestDefence.map((t: any) => ({ name: t.team, url: `/teams/${t.slug}`, photo: `/logos/${t.slug}.svg`, value: t.ga }))}
        />
      </div>
    </div>
  </section>

  <!-- TOP 3 TABLE WIDGET -->
  <section class="section section--sm">
    <div class="container">
      <div class="section-header flex-between">
        <div>
          <div class="section-label">Standings</div>
          <h2 class="section-title">Top of the Table</h2>
        </div>
        <a href="/table" class="view-all">Full Table</a>
      </div>

      <div class="table-wrap home-table-wrap">
        <table class="standings-compact">
          <caption class="visually-hidden">Baller League UK Season {CURRENT_SEASON} table — top of the standings with form and points.</caption>
          <thead>
            <tr>
              <th scope="col">#</th>
              <th scope="col">Team</th>
              <th scope="col">GP</th>
              <th scope="col">W</th>
              <th scope="col">D</th>
              <th scope="col">L</th>
              <th scope="col">GF</th>
              <th scope="col">GA</th>
              <th scope="col">GD</th>
              <th scope="col" title="Extra Points">EP</th>
              <th scope="col">Form</th>
              <th scope="col">PTS</th>
            </tr>
          </thead>
          <tbody>
            {computedTable.map(row => (
              <tr>
                <td><span class={`pos-num ${row.pos <= 4 ? 'top-4' : ''}`}>{row.pos}</span></td>
                <td>
                  <a href={`/teams/${row.slug}`} class="td-team-name">
                    <img src={`/logos/${row.slug}.svg`} class="td-logo" onerror="this.hidden=true" alt={row.team} />
                    <span class="team-badge td-emoji-fallback">{row.emoji}</span>
                    {row.team}
                  </a>
                </td>
                <td>{row.played}</td>
                <td>{row.won}</td>
                <td>{row.drawn}</td>
                <td>{row.lost}</td>
                <td>{row.gf}</td>
                <td>{row.ga}</td>
                <td class={row.gd > 0 ? 'text-green' : row.gd < 0 ? 'text-orange' : ''}>{row.gd > 0 ? `+${row.gd}` : row.gd}</td>
                <td class={row.ep > 0 ? 'text-gold' : 'text-muted'}>{row.ep > 0 ? `+${row.ep}` : row.ep}</td>
                <td class="form-cell" style="display:flex;gap:3px;">
                  {formFor(row.slug, CURRENT_SEASON).map(f => (
                    <span class={`form-badge ${f.cls}`}>{f.label}</span>
                  ))}
                </td>
                <td class="pts-cell">{row.pts}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="table-note text-muted">🟢 Top 4 qualify for the Final Four playoffs &middot; Stats updated {updateDate}</p>
    </div>
  </section>

  <!-- FIXTURES AND RESULTS TWO-COL -->
  <section class="section section--sm" style="background: var(--bg-secondary); padding-top: var(--space-2xl); padding-bottom: var(--space-2xl);">
    <div class="container">
      <div class="fixtures-grid">

        <div>
          <div class="section-header flex-between">
            <div>
              <div class="section-label">{isFinalFour ? 'Final Four' : `Gameweek ${upcomingGW}`}</div>
              <h2 class="section-title">{upcomingFixtures.length > 0 ? 'Upcoming Fixtures' : 'Season Complete'}</h2>
            </div>
            <a href="/final-four" class="view-all">Final Four recap</a>
          </div>
          {upcomingFixtures.length > 0 ? (
            <div class="fixtures-list">
              {upcomingFixtures.map(f => (
                <a href={`/news/${previewSlug(f)}`} class="fixture-card">
                  <div class="fixture-team home">
                    <img src={`/logos/${f.homeSlug}.svg`} class="td-logo"  onerror="this.hidden=true" alt={f.homeTeam} />
                    <span class="fixture-team-name">{f.homeTeam}</span>
                  </div>
                  <div class="fixture-vs-box">
                    <div class="fixture-score">vs</div>
                    <div class="fixture-date">{f.time}</div>
                    {f.round && <div class="fixture-date" style="color: var(--purple-light); font-weight: 600; font-size: 0.65rem;">{f.round}</div>}
                  </div>
                  <div class="fixture-team away">
                    <img src={`/logos/${f.awaySlug}.svg`} class="td-logo"  onerror="this.hidden=true" alt={f.awayTeam} />
                    <span class="fixture-team-name">{f.awayTeam}</span>
                  </div>
                </a>
              ))}
            </div>
          ) : (
            <div class="card empty-state">
              <div class="card-body">
                <div class="empty-icon" aria-hidden="true">🏆</div>
                <p class="empty-title">Season 3 is in the books</p>
                <p class="empty-desc">Prime FC beat NDL FC 5-2 in the Final at The O2 to be crowned Baller League UK champions.</p>
                <a href="/final-four" class="btn btn-secondary">See the Final Four</a>
              </div>
            </div>
          )}
        </div>

        <div>
          <div class="section-header flex-between">
            <div>
              <div class="section-label">Gameweek {lastGW}</div>
              <h2 class="section-title">Recent Results</h2>
            </div>
          </div>
          {recentResults.length > 0 ? (
          <div class="fixtures-list">
            {recentResults.map(r => (
              <a href={`/news/${matchSlug(r)}`} class="fixture-card fixture-result-card">
                <div class="fixture-team home">
                  <img src={`/logos/${r.homeSlug}.svg`} class="td-logo"  onerror="this.hidden=true" alt={r.homeTeam} />
                  <span class="fixture-team-name">{r.homeTeam}</span>
                </div>
                <div class="fixture-vs-box">
                  <div class="fixture-score">{r.homeScore}–{r.awayScore}</div>
                  <div class="fixture-date">FT</div>
                </div>
                <div class="fixture-team away">
                  <img src={`/logos/${r.awaySlug}.svg`} class="td-logo"  onerror="this.hidden=true" alt={r.awayTeam} />
                  <span class="fixture-team-name">{r.awayTeam}</span>
                </div>
              </a>
            ))}
          </div>
          ) : (
            <div class="card empty-state">
              <div class="card-body">
                <div class="empty-icon" aria-hidden="true">📅</div>
                <p class="empty-title">Season {CURRENT_SEASON} kicks off 12 October</p>
                <p class="empty-desc">Six matches every Monday from the new Baller League Arena in Dagenham.</p>
                <a href="/season-4" class="btn btn-secondary">Season 4 preview</a>
              </div>
            </div>
          )}
        </div>

      </div>
    </div>
  </section>

  <!-- LATEST NEWS -->
  <section class="section">
    <div class="container">
      <div class="section-header flex-between">
        <div>
          <div class="section-label">Latest</div>
          <h2 class="section-title">News & Reports</h2>
        </div>
        <a href="/news" class="view-all">All News</a>
      </div>
      <div class="grid-3">
        {latestNews.map(article => (
          <NewsCard
            title={article.data.title}
            slug={article.slug}
            date={article.data.date}
            category={article.data.category}
            excerpt={article.data.excerpt}
            featured={article.data.featured}
            gameweek={extractGW(article.slug)}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- ABOUT CALLOUT -->
  <section class="section--sm about-callout">
    <div class="container">
      <div class="callout-card card">
        <div class="card-body callout-inner">
          <div>
            <div class="section-label">New to Baller League?</div>
            <h2 class="section-title">What is Baller League UK?</h2>
            <p>
              Baller League UK is a 6-a-side celebrity football league where influencers, footballers
              and entertainers manage teams in a fast-paced, entertainment-first competition.
              Think King League, but British — with Sky Sports coverage, a packed arena
              and a packed roster of UK talent.
            </p>
            <div class="callout-actions">
              <a href="/rules" class="btn btn-primary">Read the Rules</a>
              <a href="/teams" class="btn btn-ghost">Meet the Teams</a>
            </div>
          </div>
          <div class="callout-stats">
            <div class="stat-box"><div class="stat-box-number">6v6</div><div class="stat-box-label">Players per side</div></div>
            <div class="stat-box"><div class="stat-box-number">30</div><div class="stat-box-label">Minutes per game</div></div>
            <div class="stat-box"><div class="stat-box-number">1-on-1</div><div class="stat-box-label">1-on-1 Gauntlet</div></div>
            <div class="stat-box"><div class="stat-box-number">3v3</div><div class="stat-box-label">Game Changer</div></div>
          </div>
        </div>
      </div>
    </div>
  </section>

</Base>

<style>
/* Hero: copy + live "at a glance" panel */
.hero-inner { display: grid; grid-template-columns: 1.15fr 0.85fr; gap: var(--space-2xl); align-items: center; }
.hero-copy { max-width: 620px; }

.hero-panel {
  background: linear-gradient(160deg, var(--bg-card), var(--bg-secondary));
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: var(--space-lg);
  box-shadow: var(--shadow-lg);
}
.hero-panel-head { display: flex; align-items: baseline; justify-content: space-between; gap: var(--space-sm); margin-bottom: var(--space-md); flex-wrap: wrap; }
.hero-panel-title { font-family: var(--font-body); font-weight: 800; font-size: 0.85rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-primary); }
.hero-panel-sub { font-size: 0.75rem; color: var(--text-muted); }
.hero-panel-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-sm); }
.hero-metric {
  display: flex; flex-direction: column; gap: 2px;
  background: var(--bg-primary); border: 1px solid var(--border); border-radius: var(--radius);
  padding: var(--space-md); min-width: 0;
  transition: border-color var(--transition), transform var(--transition), background var(--transition);
}
.hero-metric:hover { border-color: rgba(0,230,118,0.35); background: var(--bg-card-hover); transform: translateY(-2px); }
.hero-metric-img { width: 40px; height: 40px; object-fit: contain; margin-bottom: 4px; }
.hero-metric-img--round { border-radius: 50%; object-fit: cover; border: 1px solid var(--border); background: var(--bg-elevated); }
.hero-metric-label { font-size: 0.66rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-muted); }
.hero-metric-value { font-weight: 700; color: var(--text-primary); font-size: 0.98rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.hero-metric-sub { font-size: 0.78rem; color: var(--green); font-weight: 600; }
.hero-panel-link { display: inline-block; margin-top: var(--space-md); color: var(--green); font-size: 0.85rem; font-weight: 600; }
.hero-panel-link:hover { color: var(--green-mid); }

/* Pre-season "at a glance" */
.hero-facts { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-sm); }
.hero-fact {
  position: relative; display: flex; flex-direction: column; align-items: flex-start; gap: 2px;
  background: linear-gradient(160deg, var(--bg-elevated), var(--bg-primary));
  border: 1px solid var(--border); border-radius: var(--radius);
