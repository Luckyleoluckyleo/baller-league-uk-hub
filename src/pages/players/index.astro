---
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import StatLeaderboard from '../../components/StatLeaderboard.astro';
import StatStrip from '../../components/StatStrip.astro';
import playerData from '../../data/players.json';
import gcData from '../../data/gamechangers.json';

const players = playerData.players;
const gcMatches = Object.values(gcData.seasons).flatMap((s: any) => s.matches);

interface Player { slug: string; name: string; team: string | null; teamSlug: string | null; position: string | null; age: number | null; number: number | null; seasons: Record<string, any>; }

const enrich = (p: any): Player => ({
  slug: p.slug,
  name: p.name,
  team: p.team,
  teamSlug: p.teamSlug,
  position: p.position,
  age: p.age,
  number: p.number,
  seasons: p.seasons,
});

const enriched: Player[] = players.map(enrich);

// Sort by goals for display
const byGoals = [...enriched].sort((a, b) => (b.seasons?.['3']?.goals || 0) - (a.seasons?.['3']?.goals || 0));
const byGCGoals = [...enriched].sort((a, b) => (b._gcGoals || 0) - (a._gcGoals || 0));

// Detailed per-player metrics scraped from the official player pages.
const metric = (p: any, key: string): number => {
  const s = p.seasons?.['3'] || {};
  if (key === 'goals' || key === 'assists' || key === 'apps') return s[key] || 0;
  return (s.detailed && s.detailed[key]) || 0;
};
const rank = (key: string, n = 10) =>
  enriched
    .map((p) => ({ name: p.name, slug: p.slug, team: p.team, teamSlug: p.teamSlug, value: metric(p, key) }))
    .filter((r) => r.value > 0)
    .sort((a, b) => b.value - a.value)
    .slice(0, n);

const snapshot = {
  scorer: rank('goals', 1)[0],
  assists: rank('assists', 1)[0],
  shots: rank('Total Shots', 1)[0],
  saves: rank('Saves Made', 1)[0],
};
const totalGoals = enriched.reduce((n, p) => n + (p.seasons?.['3']?.goals || 0), 0);

// One combined leaderboard, switched by a category selector.
const leaderboards = [
  { key: 'goals', title: 'Top Scorers', icon: '⚽', label: 'G', rows: rank('goals') },
  { key: 'assists', title: 'Top Assists', icon: '🅰️', label: 'A', rows: rank('assists') },
  { key: 'apps', title: 'Most Appearances', icon: '🏟️', label: 'Apps', rows: rank('apps') },
  { key: 'shots', title: 'Most Shots', icon: '🎯', label: 'SH', rows: rank('Total Shots') },
  { key: 'saves', title: 'Most Saves', icon: '🧤', label: 'SV', rows: rank('Saves Made') },
  { key: 'passes', title: 'Most Passes', icon: '🔗', label: 'P', rows: rank('Total Passes') },
  { key: 'tackles', title: 'Most Tackles', icon: '🛡️', label: 'T', rows: rank('Total Tackles') },
  { key: 'duels', title: 'Most Duels Won', icon: '💪', label: 'D', rows: rank('Duels won') },
  { key: 'minutes', title: 'Most Minutes', icon: '⏱️', label: 'MIN', rows: rank('Time Played') },
];

const teams = [...new Set(enriched.filter(p => p.team).map(p => p.team))].sort() as string[];
const positions = [...new Set(enriched.filter(p => p.position).map(p => p.position))].sort() as string[];

// Calculate initials for avatar
function initials(name: string): string {
  return name.split(' ').map(n => n[0]).join('').slice(0, 2).toUpperCase();
}

const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Baller League UK Players",
  "description": "All Baller League UK players for Season 3 with goals, assists, appearances and detailed stats. Leaderboards and filtering.",
  "about": { "@type": "SportsOrganization", "name": "Baller League UK", "sport": "Football" },
};
---

<Base
  title="Baller League UK Players — Stats, Goals & Player Profiles"
  description="Browse all Baller League UK players for Season 3. Leaderboards by goals and GC goals, search by name, filter by team or position."
  keywords="players, goals, assists, stats, top scorers, squad, Season 3"
  schema={schema}
>

  <div class="page-header">
    <div class="container">
      <Breadcrumb items={[{name:'Home',url:'/'},{name:'Players'}]} />
      <div class="section-label">Season 3 — {enriched.length} Players</div>
      <h1>Player Database</h1>
      <p class="section-subtitle">
        Full directory of every Baller League UK player with stats. Leaderboards, search and filter to find any player.
      </p>
    </div>
  </div>

  <div class="container players-page">

    <StatStrip
      stats={[
        { icon: '👥', label: 'Players', value: enriched.length, sub: `${totalGoals} goals scored` },
        { icon: '⚽', label: 'Top scorer', value: snapshot.scorer?.name, sub: `${snapshot.scorer?.value} goals`, href: `/players/${snapshot.scorer?.slug}` },
        { icon: '🅰️', label: 'Most assists', value: snapshot.assists?.name, sub: `${snapshot.assists?.value} assists`, href: `/players/${snapshot.assists?.slug}` },
        { icon: '🎯', label: 'Most shots', value: snapshot.shots?.name, sub: `${snapshot.shots?.value} shots`, href: `/players/${snapshot.shots?.slug}` },
      ]}
    />

    <!-- LEADERBOARD SELECTOR -->
    <section>
      <div class="section-label">Leaderboards</div>
      <h2 class="section-title">Top Performers</h2>
      <div class="lb-tabs" id="lb-tabs" role="tablist" aria-label="Leaderboard category">
        {leaderboards.map((lb, i) => (
          <button type="button" role="tab" id={`lbtab-${lb.key}`} aria-controls={`lbpanel-${lb.key}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} class={`lb-tab ${i === 0 ? 'active' : ''}`} data-lb={lb.key}>{lb.icon} {lb.title}</button>
        ))}
      </div>
      <div class="lb-panels">
        {leaderboards.map((lb, i) => (
          <div role="tabpanel" id={`lbpanel-${lb.key}`} aria-labelledby={`lbtab-${lb.key}`} data-lb={lb.key} class="lb-panel" hidden={i !== 0}>
            <StatLeaderboard title={lb.title} icon={lb.icon} valueLabel={lb.label} rows={lb.rows} />
          </div>
        ))}
      </div>
    </section>

    <!-- FILTER BAR -->
    <div class="filter-bar">
      <input type="search" id="player-search" placeholder="Search players..." aria-label="Search players" />
      <select id="team-filter" aria-label="Filter by team">
        <option value="">All Teams</option>
        {teams.map(t => <option value={t}>{t}</option>)}
      </select>
      <select id="position-filter" aria-label="Filter by position">
        <option value="">All Positions</option>
        {positions.map(p => <option value={p}>{p}</option>)}
      </select>
    </div>

    <!-- ALL PLAYERS TABLE -->
    <div class="card">
      <div class="card-body" style="padding: 0;">
        <div class="table-wrap" style="border-radius: var(--radius-lg);">
          <table id="players-table" class="table-cards">
            <caption class="visually-hidden">All Baller League UK Season 3 players — goals, assists, appearances, shots, passes, tackles and saves. Columns are sortable.</caption>
            <thead>
              <tr>
                <th scope="col">#</th>
                <th scope="col">Player</th>
                <th scope="col">Team</th>
                <th scope="col">Pos</th>
                <th scope="col" class="num-col sortable" data-sort="goals">G</th>
                <th scope="col" class="num-col sortable" data-sort="assists">A</th>
                <th scope="col" class="num-col sortable" data-sort="apps">Apps</th>
                <th scope="col" class="num-col sortable" data-sort="shots">SH</th>
                <th scope="col" class="num-col sortable" data-sort="passes">P</th>
                <th scope="col" class="num-col sortable" data-sort="tackles">T</th>
                <th scope="col" class="num-col sortable" data-sort="saves">SV</th>
              </tr>
            </thead>
            <tbody>
              {byGoals.map((p, i) => (
                <tr class="player-row" data-name={p.name.toLowerCase()} data-team={p.team || ''} data-position={p.position || ''} data-goals={p.seasons?.['3']?.goals || 0} data-assists={p.seasons?.['3']?.assists || 0} data-apps={p.seasons?.['3']?.apps || 0} data-shots={metric(p, 'Total Shots')} data-passes={metric(p, 'Total Passes')} data-tackles={metric(p, 'Total Tackles')} data-saves={metric(p, 'Saves Made')}>
                  <td class="text-muted" style="width: 40px;" data-label="#">{i + 1}</td>
                  <td data-label="Player">
                    <div class="lb-player">
                      <a href={`/players/${p.slug}`} class="td-team-name" style="gap: 6px;">
                        <img src={`/players/thumb/${p.slug}.webp`} alt={p.name} class="player-thumb" loading="lazy" onerror="this.hidden=true;this.nextElementSibling.hidden=false" />
                        <span class="player-thumb-fallback lb-avatar">{initials(p.name)}</span>
                        <span>{p.name}</span>
                      </a>
                    </div>
                  </td>
                  <td data-label="Team">{p.teamSlug ? <a href={`/teams/${p.teamSlug}`} class="text-green" style="font-size: 0.88rem;">{p.team}</a> : <span class="text-muted">—</span>}</td>
                  <td data-label="Pos"><span class="badge badge-green" style="font-size: 0.7rem;">{p.position || '—'}</span></td>
                  <td class="num-col pts-cell" data-label="Goals">{p.seasons?.['3']?.goals ?? 0}</td>
                  <td class="num-col" data-label="Assists">{p.seasons?.['3']?.assists ?? 0}</td>
                  <td class="num-col" data-label="Apps">{p.seasons?.['3']?.apps ?? 0}</td>
                  <td class="num-col" data-label="Shots">{metric(p, 'Total Shots')}</td>
                  <td class="num-col" data-label="Passes">{metric(p, 'Total Passes')}</td>
                  <td class="num-col" data-label="Tackles">{metric(p, 'Total Tackles')}</td>
                  <td class="num-col" data-label="Saves">{metric(p, 'Saves Made')}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <div id="no-results" class="card" style="margin-top: var(--space-lg); display: none;">
      <div class="card-body text-center">
        <p class="text-muted">No players match your search. Try different filters.</p>
      </div>
    </div>

  </div>
</Base>

<script>
  const search = document.getElementById('player-search') as HTMLInputElement;
  const teamFilter = document.getElementById('team-filter') as HTMLSelectElement;
  const posFilter = document.getElementById('position-filter') as HTMLSelectElement;
  const rows = document.querySelectorAll<HTMLTableRowElement>('.player-row');
  const noEl = document.getElementById('no-results')!;

  function apply() {
    const q = search.value.toLowerCase().trim();
    const t = teamFilter.value;
    const p = posFilter.value;
    let shown = 0;
    rows.forEach(r => {
      const ok = (!q || r.dataset.name!.includes(q)) && (!t || r.dataset.team === t) && (!p || r.dataset.position === p);
      (r as any).style.display = ok ? '' : 'none';
      if (ok) shown++;
    });
    noEl.style.display = shown > 0 ? 'none' : '';
  }

  search.addEventListener('input', apply);
  teamFilter.addEventListener('change', apply);
  posFilter.addEventListener('change', apply);

  // Leaderboard category tabs
  const lbTabs = document.getElementById('lb-tabs');
  if (lbTabs) {
    const tabs = Array.from(lbTabs.querySelectorAll<HTMLButtonElement>('.lb-tab'));
    const panels = Array.from(document.querySelectorAll<HTMLElement>('.lb-panel'));
    const select = (key: string) => {
      tabs.forEach((t) => {
        const on = t.dataset.lb === key;
        t.classList.toggle('active', on);
        t.setAttribute('aria-selected', on ? 'true' : 'false');
        t.tabIndex = on ? 0 : -1;
      });
      panels.forEach((p) => { p.hidden = p.dataset.lb !== key; });
    };
    lbTabs.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('.lb-tab');
      if (btn) select((btn as HTMLElement).dataset.lb!);
    });
    lbTabs.addEventListener('keydown', (e) => {
      const idx = tabs.indexOf(document.activeElement as HTMLButtonElement);
      if (idx === -1) return;
      let next = -1;
      if (e.key === 'ArrowRight' || e.key === 'ArrowDown') next = (idx + 1) % tabs.length;
      else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') next = (idx - 1 + tabs.length) % tabs.length;
      else if (e.key === 'Home') next = 0;
      else if (e.key === 'End') next = tabs.length - 1;
      if (next !== -1) { e.preventDefault(); tabs[next].focus(); select(tabs[next].dataset.lb!); }
    });
  }

  // Sortable columns
  document.querySelectorAll<HTMLTableCellElement>('.sortable').forEach(th => {
    th.addEventListener('click', () => {
      const sortKey = th.dataset.sort!;
      const dir = th.dataset.dir === 'desc' ? 'asc' : 'desc';
      th.dataset.dir = dir;
      document.querySelectorAll('.sortable').forEach(t => t.classList.remove('sorted-asc', 'sorted-desc'));
      th.classList.add(dir === 'desc' ? 'sorted-desc' : 'sorted-asc');

      const tbody = document.getElementById('players-table')!.querySelector('tbody')!;
      const sorted = [...rows].sort((a, b) => {
        const av = parseInt(a.dataset[sortKey] || '0');
        const bv = parseInt(b.dataset[sortKey] || '0');
        return dir === 'desc' ? bv - av : av - bv;
      });
      sorted.forEach(r => tbody.appendChild(r));
    });
  });
</script>

<style>
.players-page { padding-bottom: var(--space-3xl); display: flex; flex-direction: column; gap: var(--space-2xl); }

/* Leaderboard */
.leaderboard-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: var(--space-lg); }

/* Leaderboard selector */
.lb-tabs { display: flex; flex-wrap: wrap; gap: var(--space-sm); margin-bottom: var(--space-lg); }
.lb-tab {
  padding: 8px 14px; border-radius: var(--radius-full);
  background: var(--bg-card); border: 1px solid var(--border);
  color: var(--text-secondary); font-size: 0.82rem; font-weight: 600;
  cursor: pointer; transition: all var(--transition); font-family: inherit;
}
.lb-tab:hover { border-color: var(--green); color: var(--text-primary); }
.lb-tab.active { background: var(--green-glow); border-color: var(--green); color: var(--green); }
.lb-panel[hidden] { display: none; }
.lb-card { }
.lb-title { font-size: 0.82rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-muted); margin-bottom: var(--space-md); font-family: var(--font-body); }
.lb-table-wrap { }
.lb-table { width: 100%; border-collapse: collapse; }
.lb-table th { font-size: 0.7rem; font-weight: 600; color: var(--text-muted); padding: 6px 8px; text-align: left; border-bottom: 1px solid var(--border); }
.lb-table td { padding: 7px 8px; font-size: 0.84rem; }
.lb-table tr:not(:last-child) td { border-bottom: 1px solid var(--border-subtle); }
.lb-table .top-row td { }
.lb-rank { width: 28px; color: var(--text-muted); font-variant-numeric: tabular-nums; }
.lb-player { display: flex; align-items: center; gap: var(--space-sm); color: var(--text-primary); font-weight: 500; }
.lb-avatar { width: 28px; height: 28px; background: var(--green-glow); color: var(--green); border-radius: var(--radius-sm); display: flex; align-items: center; justify-content: center; font-size: 0.65rem; font-weight: 800; flex-shrink: 0; }
.player-thumb { width: 44px; height: 44px; border-radius: 50%; object-fit: cover; flex-shrink: 0; }
.player-thumb-fallback { display: none; }
.player-thumb[hidden] + .player-thumb-fallback { display: flex; }
.lb-team { font-size: 0.8rem; }
.num-col { text-align: center; font-variant-numeric: tabular-nums; width: 50px; }

/* Filter bar */
.filter-bar { display: flex; gap: var(--space-md); flex-wrap: wrap; }
.filter-bar input { flex: 2; min-width: 200px; }
.filter-bar select { flex: 1; min-width: 150px; }

/* Sortable */
.sortable { cursor: pointer; user-select: none; transition: color var(--transition); }
.sortable:hover { color: var(--green); }
.sortable.sorted-desc::after { content: ' ▼'; font-size: 0.6rem; color: var(--green); }
.sortable.sorted-asc::after { content: ' ▲'; font-size: 0.6rem; color: var(--green); }

@media (max-width: 900px) {
  .leaderboard-grid { grid-template-columns: 1fr; }
}
</style>
