---
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import playerData from '../../data/players.json';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const contentPlayers = await getCollection('players');
  const scraped = (playerData.players as any[]).map((p) => p.slug);
  const extra = contentPlayers.map((p) => p.slug);
  const slugs = [...new Set([...scraped, ...extra])];
  return slugs.map((slug) => ({ params: { slug }, props: { playerSlug: slug } }));
}

const contentPlayers = await getCollection('players');
const contentBySlug = Object.fromEntries(contentPlayers.map((p) => [p.slug, p]));

const { playerSlug } = Astro.props;
const scraped = (playerData.players as any[]).find((p) => p.slug === playerSlug);
const entry = contentBySlug[playerSlug];

// Normalise a player from either the scraped data or a hand-written profile.
const player = scraped
  ? scraped
  : entry
    ? {
        slug: playerSlug,
        name: entry.data.name,
        team: entry.data.teamName,
        teamSlug: entry.data.team,
        position: entry.data.position,
        number: entry.data.number ?? null,
        age: null,
        seasons: {},
      }
    : null;

const stats = player?.seasons?.['3'];
const avatarFallback = player ? player.name.split(' ').map((n: string) => n[0]).join('').slice(0, 2).toUpperCase() : '??';

// Hand-written biography (markdown) if one exists.
const bio = entry ? await entry.render() : null;
const BioContent = bio?.Content;

// Related players for internal linking.
const scrapedPlayers = playerData.players as any[];
const byScorers = (list: any[]) => [...list].sort((a, b) => (b.seasons?.['3']?.goals || 0) - (a.seasons?.['3']?.goals || 0));
const teammates = player && player.teamSlug
  ? byScorers(scrapedPlayers.filter((p) => p.teamSlug === player.teamSlug && p.slug !== player.slug)).slice(0, 6)
  : [];
const samePosition = player && player.position
  ? byScorers(scrapedPlayers.filter((p) => p.position === player.position && p.slug !== player.slug)).slice(0, 6)
  : [];

function generateBlurb(player: any, stats: any): string {
  const name = player.name;
  const team = player.team || 'their team';
  const pos = player.position || 'player';
  if (!stats || stats.apps === undefined || stats.apps === null) {
    return `${name} is a footballer for ${team} in Baller League UK.`;
  }
  const apps = stats.apps;
  const goals = stats.goals ?? 0;
  const assists = stats.assists ?? 0;
  const gpg = apps > 0 ? (goals / apps).toFixed(2) : '0';
  if (apps === 0) {
    return `${name} is a ${pos} for ${team} in Baller League UK Season 3. They are yet to make their debut this season.`;
  }
  let blurb = `${name} is a ${pos} for ${team} in Baller League UK Season 3, making ${apps} appearance${apps !== 1 ? 's' : ''}`;
  if (goals > 0) blurb += `, scoring ${goals} goal${goals !== 1 ? 's' : ''}`;
  if (assists > 0) {
    if (goals > 0) blurb += ` and providing ${assists} assist${assists !== 1 ? 's' : ''}`;
    else blurb += `, providing ${assists} assist${assists !== 1 ? 's' : ''}`;
  }
  blurb += `.`;
  if (goals > 0 && apps > 0) {
    blurb += ` They average ${gpg} goals per game.`;
  }
  return blurb;
}

const personSchema = player ? {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": player.name,
  "jobTitle": player.position || 'Footballer',
  "description": stats
    ? `${player.name} – ${stats.goals ?? 0} goals, ${stats.assists ?? 0} assists in ${stats.apps ?? 0} appearances for ${player.team} in Baller League UK Season 3.`
    : `${player.name} plays for ${player.team} in Baller League UK.`,
  "memberOf": player.teamSlug ? { "@type": "SportsTeam", "name": player.team, "url": `https://ballerleagueukhub.com/teams/${player.teamSlug}` } : undefined,
  "affiliation": { "@type": "SportsTeam", "name": player.team, "sport": "Football" },
  "nationality": entry?.data.nationality ? { "@type": "Country", "name": entry.data.nationality } : undefined,
  "image": `https://ballerleagueukhub.com/players/${player.slug}.webp`,
} : undefined;

const faqSchema = player ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": `Which team does ${player.name} play for?`,
      "acceptedAnswer": { "@type": "Answer", "text": `${player.name} plays for ${player.team} in Baller League UK.` },
    },
    ...(player.position ? [{
      "@type": "Question",
      "name": `What position does ${player.name} play?`,
      "acceptedAnswer": { "@type": "Answer", "text": `${player.name} plays as a ${player.position} for ${player.team} in Baller League UK.` },
    }] : []),
    ...(stats && stats.apps > 0 ? [{
      "@type": "Question",
      "name": `How many goals has ${player.name} scored in Baller League UK?`,
      "acceptedAnswer": { "@type": "Answer", "text": `${player.name} has scored ${stats.goals ?? 0} goals and provided ${stats.assists ?? 0} assists in ${stats.apps} appearances for ${player.team} in Baller League UK Season 3.` },
    }] : []),
  ],
} : undefined;

const schema = [personSchema, faqSchema].filter(Boolean);
---

<Base
  title={player ? `${player.name} — Baller League UK Player Profile` : 'Player Not Found'}
  description={player ? `${player.name}${stats ? ` — ${stats.goals ?? 0} goals, ${stats.assists ?? 0} assists in ${stats.apps ?? 0} apps for ${player.team} in Baller League UK Season 3.` : ''}` : 'Player not found.'}
  schema={schema}
  image={player ? `/og/players/${player.slug}.png` : undefined}
  keywords={player ? `${player.name}, ${player.team}, Baller League UK player, ${player.position ?? ''}, Season 3` : ''}
>

  {!player ? (
    <div class="page-header"><div class="container"><h1>Player Not Found</h1><a href="/players">Back to Players</a></div></div>
  ) : (
    <>
      <div class="page-header">
        <div class="container">
          <Breadcrumb items={[{name:'Home',url:'/'},{name:'Players',url:'/players'},{name:player.name}]} />
          <div class="player-hero">
            <div class="player-photo-wrap">
              <img src={`/players/${player.slug}.webp`} alt={player.name} class="player-photo-hero" loading="lazy" onerror="this.hidden=true;this.nextElementSibling.hidden=false" />
              <div class="player-avatar-fallback" hidden>{avatarFallback}</div>
            </div>
            <div class="player-hero-info">
              <div class="player-hero-meta">
                {player.position && <span class="badge badge-green">{player.position}</span>}
                {player.number && <span class="badge badge-gw">#{player.number}</span>}
                {player.age && <span class="text-muted" style="font-size:0.85rem;">Age {player.age}</span>}
              </div>
              <h1 class="player-name">{player.name}</h1>
              {player.teamSlug ? (
                <a href={`/teams/${player.teamSlug}`} class="player-team-link">
                  <img src={`/logos/${player.teamSlug}.svg`} alt={player.team} style="width:20px;height:20px;object-fit:contain;vertical-align:middle;margin-right:6px;" onerror="this.hidden=true" />
                  {player.team}
                </a>
              ) : (
                <span class="text-muted">{player.team}</span>
              )}
            </div>
          </div>
        </div>
      </div>

      <div class="container player-page">
        {stats && (
          <div class="player-stats-row grid-4">
            <div class="stat-box"><div class="stat-box-number">{stats?.goals ?? 0}</div><div class="stat-box-label">Goals</div></div>
            <div class="stat-box"><div class="stat-box-number">{stats?.assists ?? 0}</div><div class="stat-box-label">Assists</div></div>
            <div class="stat-box"><div class="stat-box-number">{stats?.apps ?? 0}</div><div class="stat-box-label">Appearances</div></div>
            <div class="stat-box"><div class="stat-box-number">{stats?.apps ? ((stats.goals || 0) / stats.apps).toFixed(2) : '—'}</div><div class="stat-box-label">Goals / Game</div></div>
          </div>
        )}

        <div class="player-blurb card">
          <div class="card-body">
            {BioContent
              ? <div class="blurb-text bio-content"><BioContent /></div>
              : <p class="blurb-text">{generateBlurb(player, stats)}</p>}
          </div>
        </div>

        {stats?.detailed && Object.keys(stats.detailed).length > 0 && (
          <div class="player-detailed card">
            <div class="card-body">
              <h2 class="detail-heading">Detailed Stats — Season 3</h2>
              <div class="detail-grid">
                {Object.entries(stats.detailed).map(([key, val]: any) => (
                  <div class="detail-item">
                    <span class="detail-val">{val}</span>
                    <span class="detail-key">{String(key).replace(/&amp;/g, '&')}</span>
                  </div>
                ))}
              </div>
            </div>
          </div>
        )}

        {(teammates.length > 0 || samePosition.length > 0) && (
          <div class="player-related">
            {teammates.length > 0 && (
              <section>
                <h2 class="detail-heading">More {player.team} Players</h2>
                <div class="related-grid">
                  {teammates.map((t: any) => (
                    <a href={`/players/${t.slug}`} class="related-card">
                      <img src={`/players/thumb/${t.slug}.webp`} alt="" width="40" height="40" loading="lazy" onerror="this.style.visibility='hidden'" />
                      <span class="related-name">{t.name}</span>
                      <span class="related-meta">{t.seasons?.['3']?.goals ?? 0} G</span>
                    </a>
                  ))}
                </div>
              </section>
            )}
            {samePosition.length > 0 && (
              <section>
                <h2 class="detail-heading">Top {player.position}s — Season 3</h2>
                <div class="related-grid">
                  {samePosition.map((t: any) => (
                    <a href={`/players/${t.slug}`} class="related-card">
                      <img src={`/players/thumb/${t.slug}.webp`} alt="" width="40" height="40" loading="lazy" onerror="this.style.visibility='hidden'" />
                      <span class="related-name">{t.name}</span>
                      <span class="related-meta">{t.seasons?.['3']?.goals ?? 0} G</span>
                    </a>
                  ))}
                </div>
              </section>
            )}
          </div>
        )}

        <div class="player-cta">
          {player.teamSlug && <a href={`/teams/${player.teamSlug}`} class="btn btn-secondary">View {player.team}</a>}
          <a href="/players" class="btn btn-ghost">All Players</a>
          <a href="/table" class="btn btn-ghost">League Table</a>
        </div>
      </div>
    </>
  )}
</Base>

<style>
.player-hero { display: flex; align-items: center; gap: var(--space-xl); }
.player-photo-wrap { position: relative; flex-shrink: 0; }
.player-photo-hero { width: 120px; height: 120px; border-radius: 50%; object-fit: cover; border: 3px solid var(--green); box-shadow: var(--shadow-green); }
.player-avatar-fallback {
  width: 120px; height: 120px; border-radius: 50%;
  background: linear-gradient(135deg, var(--bg-elevated), var(--bg-card));
  border: 3px solid var(--green);
  display: flex; align-items: center; justify-content: center;
  font-family: var(--font-display); font-size: 3rem; color: var(--green);
  box-shadow: var(--shadow-green);
}
.player-hero-info { flex: 1; }
.player-hero-meta { display: flex; align-items: center; gap: var(--space-sm); margin-bottom: var(--space-sm); flex-wrap: wrap; }
.player-name { margin-bottom: var(--space-sm); font-size: 2rem; }
.player-team-link { color: var(--green); font-weight: 600; font-size: 1.05rem; transition: color var(--transition); display: inline-flex; align-items: center; }
.player-team-link:hover { color: var(--green-mid); }
.badge-gw { background: var(--bg-elevated); color: var(--text-secondary); font-size: 0.7rem; font-weight: 700; letter-spacing: 0.04em; }

.player-page { padding-bottom: var(--space-3xl); }
.player-stats-row { margin-bottom: var(--space-xl); }
.player-blurb { margin-bottom: var(--space-xl); background: linear-gradient(135deg, var(--bg-elevated), var(--bg-card)); border: 1px solid var(--green-glow); }
.blurb-text { color: var(--text-secondary); line-height: 1.7; font-size: 0.95rem; }
.bio-content p { margin-bottom: var(--space-md); }
.bio-content p:last-child { margin-bottom: 0; }
.player-detailed { margin-bottom: var(--space-xl); }
.detail-heading { font-size: 0.85rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-muted); margin-bottom: var(--space-lg); font-family: var(--font-body); }
.detail-grid { display: grid; grid-template-columns: 1fr 1fr 1fr 1fr; gap: var(--space-md); }
.detail-item { background: var(--bg-elevated); border: 1px solid var(--border); border-radius: var(--radius); padding: var(--space-md); text-align: center; }
.detail-val { display: block; font-family: var(--font-display); font-size: 1.8rem; color: var(--text-primary); line-height: 1; }
.detail-key { display: block; font-size: 0.68rem; color: var(--text-muted); margin-top: 4px; text-transform: uppercase; letter-spacing: 0.04em; }
.player-cta { display: flex; gap: var(--space-sm); flex-wrap: wrap; }

.player-related { display: flex; flex-direction: column; gap: var(--space-xl); margin-bottom: var(--space-xl); }
.related-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: var(--space-sm); }
.related-card { display: flex; align-items: center; gap: var(--space-sm); background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius); padding: var(--space-sm); transition: border-color var(--transition), transform var(--transition); }
.related-card:hover { border-color: var(--green); transform: translateY(-2px); }
.related-card img { width: 40px; height: 40px; border-radius: 50%; object-fit: cover; flex-shrink: 0; background: var(--bg-elevated); }
.related-name { flex: 1; min-width: 0; font-size: 0.85rem; font-weight: 600; color: var(--text-primary); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.related-meta { font-size: 0.75rem; font-weight: 700; color: var(--green); }

@media (max-width: 768px) {
  .detail-grid { grid-template-columns: 1fr 1fr; }
}
@media (max-width: 640px) {
  .player-hero { flex-direction: column; text-align: center; }
  .player-hero-meta { justify-content: center; }
  .detail-grid { grid-template-columns: 1fr 1fr; }
}
</style>
