---
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import playerData from '../../data/players.json';
import { getCollection } from 'astro:content';
import { CURRENT_SEASON, teamColor, teamColorSoft } from '../../lib/league';

export async function getStaticPaths() {
  const contentPlayers = await getCollection('players');
  const scraped = (playerData.players as any[]).map((p) => p.slug);
  const extra = contentPlayers.map((p) => p.slug);
  const slugs = [...new Set([...scraped, ...extra])];
  return slugs.map((slug) => ({ params: { slug }, props: { playerSlug: slug } }));
}

const contentPlayers = await getCollection('players');
const contentBySlug = Object.fromEntries(contentPlayers.map((p) => [p.slug, p]));

// Featured spotlight article, if one exists for this player.
const allNews = await getCollection('news');
const spotlight = allNews.find((a) => a.slug === `player-spotlight-${Astro.props.playerSlug}`);

const { playerSlug } = Astro.props;
const scraped = (playerData.players as any[]).find((p) => p.slug === playerSlug);
const entry = contentBySlug[playerSlug];

// Normalise a player from either the scraped data or a hand-written profile.
const player = scraped
  ? scraped
  : entry
    ? {
        slug: playerSlug,
        name: entry.data.name,
        team: entry.data.teamName,
        teamSlug: entry.data.team,
        position: entry.data.position,
        number: entry.data.number ?? null,
        age: null,
        seasons: {},
      }
    : null;

const statsSeason = String(
  Object.keys(player?.seasons ?? {})
    .map(Number)
    .sort((a, b) => b - a)
    .find((k) => (player?.seasons?.[k]?.apps || 0) > 0) ?? CURRENT_SEASON
);
const stats = player?.seasons?.[statsSeason];

// Hand-written biography (markdown) if one exists.
const bio = entry ? await entry.render() : null;
const BioContent = bio?.Content;

// Background data (optional, hand-written).
const data = entry?.data;
const nationality = data?.nationality;
const bioLine = data?.bio;
const formerClubs: string[] = data?.formerClubs ?? [];
const honours: string[] = data?.honours ?? [];
const hasBackground = formerClubs.length > 0 || honours.length > 0;

// Related players for internal linking.
const scrapedPlayers = playerData.players as any[];
const byScorers = (list: any[]) => [...list].sort((a, b) => (b.seasons?.[statsSeason]?.goals || 0) - (a.seasons?.[statsSeason]?.goals || 0));
const teammates = player && player.teamSlug
  ? byScorers(scrapedPlayers.filter((p) => p.teamSlug === player.teamSlug && p.slug !== player.slug)).slice(0, 6)
  : [];

function generateBlurb(player: any, stats: any): string {
  const name = player.name;
  const team = player.team || 'their team';
  const pos = player.position || 'player';
  if (!stats || stats.apps === undefined || stats.apps === null) {
    return `${name} is a footballer for ${team} in Baller League UK.`;
  }
  const apps = stats.apps;
  const goals = stats.goals ?? 0;
  const assists = stats.assists ?? 0;
  const gpg = apps > 0 ? (goals / apps).toFixed(2) : '0';
  if (apps === 0) {
    return `${name} is a ${pos} for ${team} in Baller League UK Season ${statsSeason}. They are yet to make their debut this season.`;
  }
  let blurb = `${name} is a ${pos} for ${team} in Baller League UK Season ${statsSeason}, making ${apps} appearance${apps !== 1 ? 's' : ''}`;
  if (goals > 0) blurb += `, scoring ${goals} goal${goals !== 1 ? 's' : ''}`;
  if (assists > 0) {
    if (goals > 0) blurb += ` and providing ${assists} assist${assists !== 1 ? 's' : ''}`;
    else blurb += `, providing ${assists} assist${assists !== 1 ? 's' : ''}`;
  }
  blurb += `.`;
  if (goals > 0 && apps > 0) {
    blurb += ` They average ${gpg} goals per game.`;
  }
  return blurb;
}

const personSchema = player ? {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": player.name,
  "jobTitle": player.position || 'Footballer',
  "description": stats
    ? `${player.name} – ${stats.goals ?? 0} goals, ${stats.assists ?? 0} assists in ${stats.apps ?? 0} appearances for ${player.team} in Baller League UK Season ${statsSeason}.`
    : `${player.name} plays for ${player.team} in Baller League UK.`,
  "memberOf": player.teamSlug ? { "@type": "SportsTeam", "name": player.team, "url": `https://ballerleagueukhub.com/teams/${player.teamSlug}` } : undefined,
  "affiliation": { "@type": "SportsTeam", "name": player.team, "sport": "Football" },
  "nationality": nationality ? { "@type": "Country", "name": nationality } : undefined,
  "image": `https://ballerleagueukhub.com/players/${player.slug}.webp`,
} : undefined;

const faqSchema = player ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": `Which team does ${player.name} play for?`,
      "acceptedAnswer": { "@type": "Answer", "text": `${player.name} plays for ${player.team} in Baller League UK.` },
    },
    ...(player.position ? [{
      "@type": "Question",
      "name": `What position does ${player.name} play?`,
      "acceptedAnswer": { "@type": "Answer", "text": `${player.name} plays as a ${player.position} for ${player.team} in Baller League UK.` },
    }] : []),
    ...(stats && stats.apps > 0 ? [{
      "@type": "Question",
      "name": `How many goals has ${player.name} scored in Baller League UK?`,
      "acceptedAnswer": { "@type": "Answer", "text": `${player.name} has scored ${stats.goals ?? 0} goals and provided ${stats.assists ?? 0} assists in ${stats.apps} appearances for ${player.team} in Baller League UK Season ${statsSeason}.` },
    }] : []),
  ],
} : undefined;

const schema = [personSchema, faqSchema].filter(Boolean);

const color = teamColor(player?.teamSlug);
const colorSoft = teamColorSoft(player?.teamSlug, 0.18);

// Auto-generated historical players have little unique content. Keep them
// accessible, but out of the index; hand-written profiles and current S4
// players stay indexable.
const hasCurrentSeasonApps = (player?.seasons?.[String(CURRENT_SEASON)]?.apps || 0) > 0;
const isThinHistoricalPlayer = !entry && !hasCurrentSeasonApps;
---

<Base
  title={player ? `${player.name} — Baller League UK Player Profile` : 'Player Not Found'}
  description={player ? `${player.name}${stats ? ` — ${stats.goals ?? 0} goals, ${stats.assists ?? 0} assists in ${stats.apps ?? 0} apps for ${player.team} in Baller League UK Season ${statsSeason}.` : ''}` : 'Player not found.'}
  schema={schema}
  image={player ? `/og/players/${player.slug}.png` : undefined}
  noindex={isThinHistoricalPlayer}
  keywords={player ? `${player.name}, ${player.team}, Baller League UK player, ${player.position ?? ''}, Season ${statsSeason}` : ''}
>

  {!player ? (
    <div class="page-header"><div class="container"><h1>Player Not Found</h1><a href="/players">Back to Players</a></div></div>
  ) : (
    <div class="profile" style={`--team-color:${color}; --team-soft:${colorSoft};`}>
      <header class="profile-hero">
        <div class="container">
          <Breadcrumb items={[{name:'Home',url:'/'},{name:'Players',url:'/players'},{name:player.name}]} />
          <div class="profile-hero-grid">
            <div class="profile-photo-wrap">
              <img src={`/players/${player.slug}.webp`} alt={player.name} class="profile-photo" loading="eager" onerror="this.style.display='none'" />
            </div>
            <div class="profile-hero-info">
              {player.position && <div class="profile-eyebrow">{player.position}{player.number ? ` · #${player.number}` : ''}</div>}
              <h1 class="profile-name">{player.name}</h1>
              {player.teamSlug ? (
                <a href={`/teams/${player.teamSlug}`} class="profile-club">
                  <img class="profile-club-crest" src={`/logos/${player.teamSlug}.svg`} alt={player.team} onerror="this.style.visibility='hidden'" />
                  <span class="profile-club-text">
                    <span class="profile-club-label">Club</span>
                    <span class="profile-club-name">{player.team}</span>
                  </span>
                </a>
              ) : (
                <span class="profile-club"><span class="profile-club-text"><span class="profile-club-name">{player.team}</span></span></span>
              )}
              {nationality && <div class="profile-meta" style="margin-top:var(--space-sm)"><span class="profile-meta-item">{nationality}</span></div>}
              {bioLine && <p class="profile-lede">{bioLine}</p>}
            </div>
          </div>
        </div>
      </header>

      <div class="container profile-page">
        {stats && (
          <div class="profile-stats">
            <div class="profile-stat"><span class="profile-stat-num">{stats?.goals ?? 0}</span><span class="profile-stat-label">Goals</span></div>
            <div class="profile-stat"><span class="profile-stat-num">{stats?.assists ?? 0}</span><span class="profile-stat-label">Assists</span></div>
            <div class="profile-stat"><span class="profile-stat-num">{stats?.apps ?? 0}</span><span class="profile-stat-label">Appearances</span></div>
            <div class="profile-stat"><span class="profile-stat-num">{stats?.apps ? ((stats.goals || 0) / stats.apps).toFixed(2) : '—'}</span><span class="profile-stat-label">Goals / Game</span></div>
          </div>
        )}

        <div class="profile-layout">
          <main class="profile-main">
            <section class="profile-card">
              <h2 class="profile-h2">Player Profile</h2>
              {BioContent
                ? <div class="profile-prose"><BioContent /></div>
                : <div class="profile-prose"><p>{generateBlurb(player, stats)}</p></div>}
            </section>

            {hasBackground && (
              <section class="profile-card">
                <h2 class="profile-h2">Background</h2>
                {formerClubs.length > 0 && (
                  <div class="profile-block">
                    <h3 class="profile-h3">Previous Clubs</h3>
                    <div class="profile-chips">
                      {formerClubs.map((club) => <span class="profile-chip">{club}</span>)}
                    </div>
                  </div>
                )}
                {honours.length > 0 && (
                  <div class="profile-block">
                    <h3 class="profile-h3">Honours</h3>
                    <ul class="profile-honours">
                      {honours.map((h) => <li>{h}</li>)}
                    </ul>
                  </div>
                )}
              </section>
            )}

            {stats?.detailed && Object.keys(stats.detailed).length > 0 && (
              <section class="profile-card">
                <h2 class="profile-h2">Detailed Stats <span class="profile-h2-sub">Season {statsSeason}</span></h2>
                <div class="profile-detail-grid">
                  {Object.entries(stats.detailed).map(([key, val]: any) => (
                    <div class="profile-detail">
                      <span class="profile-detail-val">{val}</span>
                      <span class="profile-detail-key">{String(key).replace(/&amp;/g, '&')}</span>
                    </div>
                  ))}
                </div>
              </section>
            )}
          </main>

          <aside class="profile-side">
            <div class="profile-card">
              <h2 class="profile-h2">At a Glance</h2>
              <dl class="profile-facts">
                {player.position && <div class="profile-fact"><dt>Position</dt><dd>{player.position}</dd></div>}
                {player.number && <div class="profile-fact"><dt>Shirt</dt><dd>#{player.number}</dd></div>}
                {nationality && <div class="profile-fact"><dt>Nationality</dt><dd>{nationality}</dd></div>}
                <div class="profile-fact"><dt>Club</dt><dd>{player.team}</dd></div>
                {stats && <div class="profile-fact"><dt>Season {statsSeason}</dt><dd>{stats?.goals ?? 0}G · {stats?.assists ?? 0}A · {stats?.apps ?? 0} apps</dd></div>}
              </dl>
            </div>

            {teammates.length > 0 && (
              <div class="profile-card">
                <h2 class="profile-h2">More {player.team} Players</h2>
                <div class="profile-people">
                  {teammates.map((t: any) => (
                    <a href={`/players/${t.slug}`} class="profile-person">
                      <img src={`/players/thumb/${t.slug}.webp`} alt="" width="40" height="40" loading="lazy" onerror="this.style.visibility='hidden'" />
                      <span class="profile-person-name">{t.name}</span>
                      <span class="profile-person-meta">{t.seasons?.[statsSeason]?.goals ?? 0} G</span>
                    </a>
                  ))}
                </div>
              </div>
            )}

            {spotlight && (
              <div class="profile-card">
                <h2 class="profile-h2">Featured</h2>
                <div class="profile-articles">
                  <a href={`/news/${spotlight.slug}`}>
                    <span class="pa-cat">{spotlight.data.category}</span>
                    <span class="pa-title">{spotlight.data.title}</span>
                  </a>
                </div>
              </div>
            )}

            <a href={player.teamSlug ? `/teams/${player.teamSlug}` : '/teams'} class="btn btn-secondary" style="display:block;text-align:center;">View Squad</a>
            <a href="/players" class="btn btn-ghost" style="display:block;text-align:center;">All Players</a>
          </aside>
        </div>
      </div>
    </div>
  )}
</Base>
