---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import StatStrip from '../components/StatStrip.astro';
import fixturesData from '../data/fixtures.json';
import playersData from '../data/players.json';
import { CURRENT_SEASON, playedMatches, standingsFor, formFor, matchSlug } from '../lib/league';

const updateDate = new Date().toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const isFinalFour = fixturesData.upcoming[0]?.round != null;
const upcomingGW = fixturesData.upcoming[0]?.gameweek ?? 1;

// Played matches for the current season (regular season incl. playoffs).
const currentMatches = playedMatches(CURRENT_SEASON);
const gws = [...new Set(currentMatches.map((m) => m.gameweek))].sort((a, b) => b - a);
const maxGW = gws[0] ?? 0;

// Table is computed centrally: from results once games are played, else the official table.
const computedTable = standingsFor(CURRENT_SEASON);

// ---- Snapshot stats for the header strip ----
const players = playersData.players as any[];
const seasonOf = (p: any) => p.seasons?.[String(CURRENT_SEASON)] || {};
const leader = computedTable[0];
const topScorer = [...players].sort((a, b) => (seasonOf(b).goals || 0) - (seasonOf(a).goals || 0))[0];
const bestDefence = [...computedTable].sort((a, b) => a.ga - b.ga)[0];
const totalGoals = currentMatches.reduce((n, m) => n + m.homeScore + m.awayScore, 0);
const avgGoals = currentMatches.length ? (totalGoals / currentMatches.length).toFixed(1) : '0';

// Build results by gameweek
const resultsByGW: Record<number, any[]> = {};
for (const m of currentMatches) {
  if (!resultsByGW[m.gameweek]) resultsByGW[m.gameweek] = [];
  resultsByGW[m.gameweek].push(m);
}

function previewSlug(match: any): string {
  if (match.round) return `${match.homeSlug}-vs-${match.awaySlug}-final-four-preview`;
  return `${match.homeSlug}-vs-${match.awaySlug}-gw${match.gameweek}-preview`;
}
---

<Base
  title={`Baller League UK Table — Season ${CURRENT_SEASON} Standings${maxGW ? ` & Gameweek ${maxGW} Results` : ''}`}
  description={`Baller League UK Season ${CURRENT_SEASON} league table. Full standings${maxGW ? `, Gameweek ${maxGW} results` : ''}, upcoming GW${upcomingGW} fixtures, team form and goals stats.`}
  keywords={`league table, standings, fixtures, results, gameweek, Season ${CURRENT_SEASON}, playoffs, top 4`}
>

  <div class="page-header">
    <div class="container">
      <Breadcrumb items={[{name:'Home',url:'/'},{name:'Table'}]} />
      <div class="section-label">Season {CURRENT_SEASON}{maxGW ? ` · Gameweek ${maxGW} of 11` : ' · Pre-season'}</div>
      <h1>League Table & Fixtures</h1>
      <p class="section-subtitle">Current standings. Top 4 qualify for the Final Four playoffs. EP = Extra Points from the Pressure Point challenge.</p>
    </div>
  </div>

  <div class="container table-page">

    <StatStrip
      stats={[
        { icon: '🏆', label: 'Leaders', value: leader.team, sub: `${leader.pts} pts`, href: `/teams/${leader.slug}` },
        { icon: '⚽', label: 'Top scorer', value: topScorer.name, sub: `${seasonOf(topScorer).goals || 0} goals`, href: `/players/${topScorer.slug}` },
        { icon: '🛡️', label: 'Best defence', value: bestDefence.team, sub: `${bestDefence.ga} conceded`, href: `/teams/${bestDefence.slug}` },
        { icon: '🥅', label: 'Goals / game', value: avgGoals, sub: `${totalGoals} total` },
      ]}
    />

    <div class="table-legend">
      <span class="legend-item"><span class="legend-dot green"></span>Final Four places (1–4)</span>
    </div>

    <div class="table-wrap standings-table">
      <table class="standings-compact">
        <caption class="visually-hidden">Baller League UK Season 3 league table — position, played, wins, draws, losses, goals for, goals against, goal difference, extra points, form and points.</caption>
        <thead>
          <tr>
            <th scope="col">#</th>
            <th scope="col">Team</th>
            <th scope="col" title="Games Played">GP</th>
            <th scope="col">W</th>
            <th scope="col">D</th>
            <th scope="col">L</th>
            <th scope="col" title="Goals For">GF</th>
            <th scope="col" title="Goals Against">GA</th>
            <th scope="col" title="Goal Difference">GD</th>
            <th scope="col" title="Extra Points">EP</th>
            <th scope="col">Form</th>
            <th scope="col" title="Points">PTS</th>
          </tr>
        </thead>
        <tbody>
          {computedTable.map(row => (
            <tr class={row.pos === 4 ? 'border-row' : ''}>
              <td><span class={`pos-num ${row.pos <= 4 ? 'top-4' : ''}`}>{row.pos}</span></td>
              <td>
                <a href={`/teams/${row.slug}`} class="td-team-name">
                  <img src={`/logos/${row.slug}.svg`} class="td-logo" onerror="this.hidden=true" alt={row.team} />
                  <span class="team-badge td-emoji-fallback">{row.emoji}</span>
                  {row.team}
                </a>
              </td>
              <td>{row.played}</td>
              <td>{row.won}</td>
              <td>{row.drawn}</td>
              <td>{row.lost}</td>
              <td class="pts-cell">{row.gf}</td>
              <td>{row.ga}</td>
              <td class={row.gd > 0 ? 'text-green' : row.gd < 0 ? 'text-orange' : ''}>{row.gd > 0 ? `+${row.gd}` : row.gd}</td>
              <td class={row.ep > 0 ? 'text-gold' : 'text-muted'}>{row.ep > 0 ? `+${row.ep}` : row.ep}</td>
              <td class="form-cell">
                {formFor(row.slug, CURRENT_SEASON).map(f => (
                  <span class={`form-badge ${f.cls}`}>{f.label}</span>
                ))}
              </td>
              <td class="pts-cell">{row.pts}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="table-fixtures-grid">

      <!-- RESULTS WITH GW NAVIGATION -->
      <div>
        <div class="section-header">
          <div class="section-label">Results</div>
          <h2 class="section-title" id="results-gw-title">{maxGW > 0 ? `Gameweek ${maxGW}` : `Season ${CURRENT_SEASON}`}</h2>
        </div>

        {maxGW === 0 ? (
          <div class="card" style="padding: var(--space-lg); text-align: center;">
            <p class="text-muted">Season {CURRENT_SEASON} kicks off soon — results will appear here after the first gameweek.</p>
          </div>
        ) : (<>
        <div class="gw-nav" id="table-gw-nav" role="tablist" aria-label="Gameweek results">
          {gws.map(gw => (
            <button
              type="button"
              role="tab"
              id={`gw-tab-${gw}`}
              aria-controls={`gw-panel-${gw}`}
              aria-selected={gw === maxGW ? 'true' : 'false'}
              tabindex={gw === maxGW ? 0 : -1}
              data-gw={gw}
              class={`gw-nav-link ${gw === maxGW ? 'active' : ''}`}
            >
              GW{gw}
            </button>
          ))}
        </div>

        <div class="fixtures-list" id="table-results">
          {gws.map(gw => (
            <div role="tabpanel" id={`gw-panel-${gw}`} aria-labelledby={`gw-tab-${gw}`} data-gw={gw} style={`display:${gw === maxGW ? 'contents' : 'none'}`}>
              {(resultsByGW[gw] || []).map((m: any) => (
                <a href={`/news/${matchSlug(m)}`} class="fixture-card fixture-result-card">
                  <div class="fixture-team home">
                    <img src={`/logos/${m.homeSlug}.svg`} class="td-logo"  onerror="this.hidden=true" alt={m.homeTeam} />
                    <span class="fixture-team-name">{m.homeTeam}</span>
                  </div>
                  <div class="fixture-vs-box">
                    <div class="fixture-score">{m.homeScore}–{m.awayScore}</div>
                    <div class="fixture-date">FT</div>
                  </div>
                  <div class="fixture-team away">
                    <img src={`/logos/${m.awaySlug}.svg`} class="td-logo"  onerror="this.hidden=true" alt={m.awayTeam} />
                    <span class="fixture-team-name">{m.awayTeam}</span>
                  </div>
                </a>
              ))}
              {(!resultsByGW[gw] || resultsByGW[gw].length === 0) && (
                <div class="card" style="padding: var(--space-lg); text-align: center;">
                  <p class="text-muted">No results available for this gameweek.</p>
                </div>
              )}
            </div>
          ))}
        </div>
        </>)}
      </div>

      <!-- UPCOMING -->
      <div>
        <div class="section-header">
          <div class="section-label">Upcoming</div>
          <h2 class="section-title">{isFinalFour ? 'Final Four' : `Gameweek ${upcomingGW} Fixtures`}</h2>
        </div>
        <div class="fixtures-list">
          {fixturesData.upcoming.map(f => (
            <a href={`/news/${previewSlug(f)}`} class="fixture-card">
              <div class="fixture-team home">
                <img src={`/logos/${f.homeSlug}.svg`} class="td-logo"  onerror="this.hidden=true" alt={f.homeTeam} />
                <div>
                  <div class="fixture-team-name">{f.homeTeam}</div>
                </div>
              </div>
              <div class="fixture-vs-box">
                <div class="fixture-score">vs</div>
                <div class="fixture-date">{f.date}</div>
                <div class="fixture-date">{f.time}</div>
                {f.round && <div class="fixture-date" style="color: var(--purple-light); font-weight: 600;">{f.round}</div>}
              </div>
              <div class="fixture-team away">
                <img src={`/logos/${f.awaySlug}.svg`} class="td-logo"  onerror="this.hidden=true" alt={f.awayTeam} />
                <div>
                  <div class="fixture-team-name">{f.awayTeam}</div>
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>

    </div>

    <div class="update-note card">
      <div class="card-body update-inner">
        <span>🔄</span>
        <p>Table and results updated after each gameweek. Stats refreshed {updateDate}. {isFinalFour ? 'Next up: Final Four.' : `Upcoming fixtures for Gameweek ${upcomingGW}.`}</p>
      </div>
    </div>

  </div>
</Base>

<script>
  const nav = document.getElementById('table-gw-nav');
  const results = document.getElementById('table-results');
  const title = document.getElementById('results-gw-title');
  if (nav && results && title) {
    const tabs = Array.from(nav.querySelectorAll<HTMLButtonElement>('button[data-gw]'));

    function select(gw: string) {
      tabs.forEach((t) => {
        const on = t.dataset.gw === gw;
        t.classList.toggle('active', on);
        t.setAttribute('aria-selected', on ? 'true' : 'false');
        t.tabIndex = on ? 0 : -1;
      });
      title.textContent = 'Gameweek ' + gw;
      results.querySelectorAll<HTMLElement>('[data-gw]').forEach((el) => {
        el.style.display = el.dataset.gw === gw ? 'contents' : 'none';
      });
    }

    nav.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('button[data-gw]');
      if (btn) select(btn.dataset.gw!);
    });

    nav.addEventListener('keydown', (e) => {
      const idx = tabs.indexOf(document.activeElement as HTMLButtonElement);
      if (idx === -1) return;
      let next = -1;
      if (e.key === 'ArrowRight' || e.key === 'ArrowDown') next = (idx + 1) % tabs.length;
      else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') next = (idx - 1 + tabs.length) % tabs.length;
      else if (e.key === 'Home') next = 0;
      else if (e.key === 'End') next = tabs.length - 1;
      if (next !== -1) {
        e.preventDefault();
        tabs[next].focus();
        select(tabs[next].dataset.gw!);
      }
    });
  }
</script>

<style>
.table-page { padding-bottom: var(--space-3xl); }

.table-legend { display: flex; gap: var(--space-lg); margin-bottom: var(--space-lg); flex-wrap: wrap; }
.legend-item { display: flex; align-items: center; gap: var(--space-sm); font-size: 0.9rem; color: var(--text-secondary); font-weight: 500; }
.legend-dot { width: 12px; height: 12px; border-radius: 50%; }
.legend-dot.green { background: var(--green); box-shadow: 0 0 10px var(--green); }

.standings-table { background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius-lg); margin-bottom: var(--space-3xl); overflow-x: auto; }
.standings-table table tr:hover { background: rgba(255,255,255,0.02); }
.border-row td { border-bottom: 3px solid var(--green) !important; }

.pos-num { 
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40px; 
  height: 40px;
  background: var(--bg-elevated);
  border-radius: var(--radius-sm);
  font-family: var(--font-display);
  font-size: 1.4rem;
  color: var(--text-muted); 
}
.pos-num.top-4 { 
  color: var(--green); 
  background: var(--green-glow);
  border: 1px solid rgba(0,230,118,0.2);
}

.td-team-name {
  font-size: 1.2rem;
  font-weight: 700;
}

.table-fixtures-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-3xl); margin-bottom: var(--space-2xl); }
.fixtures-list { display: flex; flex-direction: column; gap: var(--space-sm); }

/* GW Nav */
.gw-nav { display: flex; flex-wrap: wrap; gap: 4px; margin-bottom: var(--space-md); }
.gw-nav-link {
  background: var(--bg-card); color: var(--text-secondary); border: 1px solid var(--border);
  padding: 5px 12px; border-radius: var(--radius-sm); font-size: 0.78rem; font-weight: 600;
  text-decoration: none; transition: all var(--transition); font-variant-numeric: tabular-nums;
}
.gw-nav-link:hover { border-color: var(--green); color: var(--green); }
.gw-nav-link.active { background: var(--green-glow); border-color: var(--green); color: var(--green); }

.fixture-result-card { text-decoration: none; }
.fixture-result-card:hover .fixture-score { color: var(--green); }

.form-cell { white-space: nowrap; }
.form-badge { width: 22px; height: 22px; display: inline-flex; align-items: center; justify-content: center; border-radius: 4px; font-size: 0.65rem; font-weight: 800; margin-right: 2px; }
.form-win { background: rgba(0,230,118,0.15); color: var(--green); }
.form-loss { background: rgba(255,107,53,0.12); color: var(--orange); }
.form-draw { background: rgba(255,214,0,0.12); color: var(--gold); }

.update-note { border: 1px solid var(--border); }
.update-inner { display: flex; align-items: flex-start; gap: var(--space-md); }
.update-inner p { margin: 0; font-size: 0.85rem; }

@media (max-width: 768px) {
  .table-fixtures-grid { grid-template-columns: 1fr; }
}
</style>
