---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import gcData from '../data/gamechangers.json';
import playerData from '../data/players.json';

const s3Matches = (gcData.seasons['3']?.matches as any[] || []).filter((m: any) => m.homeScore > 0 || m.awayScore > 0);

const teams = [
  { name: 'NDL FC', slug: 'ndl-fc', pos: 1, pts: 26, manager: 'Niko Omilana', emoji: '🏆' },
  { name: 'Deportrio', slug: 'deportrio', pos: 2, pts: 23, manager: 'Micah Richards', emoji: '🔵' },
  { name: 'Prime FC', slug: 'prime-fc', pos: 3, pts: 21, manager: 'KSI', emoji: '🔴' },
  { name: 'SDS FC', slug: 'sds-fc', pos: 4, pts: 20, manager: 'Tobi Brown', emoji: '🟢' },
];

teams.forEach(t => {
  const ms = s3Matches.filter((m: any) => m.homeSlug === t.slug || m.awaySlug === t.slug);
  let w = 0, d = 0, l = 0, gf = 0, ga = 0;
  ms.forEach((m: any) => {
    const isH = m.homeSlug === t.slug;
    gf += isH ? m.homeScore : m.awayScore;
    ga += isH ? m.awayScore : m.homeScore;
    if (isH ? m.homeScore > m.awayScore : m.awayScore > m.homeScore) w++;
    else if (m.homeScore === m.awayScore) d++;
    else l++;
  });
  (t as any).stats = { p: ms.length, w, d, l, gf, ga, gd: gf - ga };
  (t as any).topScorers = playerData.players
    .filter((p: any) => p.teamSlug === t.slug && (p.seasons?.['3']?.goals || 0) > 0)
    .sort((a: any, b: any) => (b.seasons?.['3']?.goals || 0) - (a.seasons?.['3']?.goals || 0))
    .slice(0, 3)
    .map((p: any) => ({ name: p.name, goals: p.seasons['3'].goals, slug: p.slug }));
  const form = ms.sort((a: any, b: any) => b.gameweek - a.gameweek).slice(0, 6);
  (t as any).form = form.map((m: any) => {
    const isH = m.homeSlug === t.slug;
    const gd = isH ? m.homeScore - m.awayScore : m.awayScore - m.homeScore;
    return gd > 0 ? 'W' : gd < 0 ? 'L' : 'D';
  }).join('');
});

function getH2H(s1: string, s2: string) {
  return s3Matches
    .filter((m: any) => (m.homeSlug === s1 && m.awaySlug === s2) || (m.homeSlug === s2 && m.awaySlug === s1))
    .sort((a: any, b: any) => a.gameweek - b.gameweek)
    .map((m: any) => ({
      gw: m.gameweek, home: m.homeTeam, away: m.awayTeam, hs: m.homeScore, as: m.awayScore,
      gc1: m.gamechanger1?.type || '?', gc2: m.gamechanger2?.type || '?',
      gc1g: m.gamechanger1?.goalsScored || 0, gc2g: m.gamechanger2?.goalsScored || 0,
    }));
}

const semi1 = { home: teams[0], away: teams[3], h2h: getH2H(teams[0].slug, teams[3].slug) };
const semi2 = { home: teams[1], away: teams[2], h2h: getH2H(teams[1].slug, teams[2].slug) };

const schema = {
  "@context": "https://schema.org",
  "@type": "SportsEvent",
  "name": "Baller League UK Season 3 Final Four",
  "description": "The Baller League UK Season 3 Final Four at The O2 London on Monday 25 May 2026. NDL FC, Deportrio, Prime FC, and SDS FC battle for the championship.",
  "startDate": "2026-05-25T18:00:00+01:00",
  "location": { "@type": "Place", "name": "The O2 Arena", "address": { "@type": "PostalAddress", "addressLocality": "London", "addressCountry": "GB" } },
  "organizer": { "@type": "Organization", "name": "Baller League UK", "url": "https://ballerleague.uk" },
  "performer": teams.map(t => ({ "@type": "SportsTeam", "name": t.name, "url": `https://ballerleagueukhub.com/teams/${t.slug}` }))
};

function formBadge(label: string) {
  if (label === 'W') return '<span class="form-badge form-win">W</span>';
  if (label === 'D') return '<span class="form-badge form-draw">D</span>';
  return '<span class="form-badge form-loss">L</span>';
}
---

<Base
  title="Baller League UK Final Four 2026 — Teams, Matchups & H2H Preview"
  description="Baller League UK Season 3 Final Four at The O2 London, Monday 25 May 2026. NDL FC vs SDS FC and Deportrio vs Prime FC semi-finals. Full team profiles, head-to-head history, form guides, and key player stats."
  schema={schema}
  keywords="Baller League Final Four, The O2 London, NDL FC, Deportrio, Prime FC, SDS FC, semi-final playoffs, 25 May 2026, Baller League champion, season 3 final"
>
  <div class="ff-hero">
    <div class="container">
      <Breadcrumb items={[{name:'Home',url:'/'},{name:'Final Four'}]} />
      <div class="ff-hero-badge">Season 3 Playoffs</div>
      <h1 class="ff-hero-title">The Final Four</h1>
      <p class="ff-hero-subtitle">Monday 25 May 2026 &middot; The O2 Arena, London &middot; Live on Sky Sports, YouTube &amp; Twitch</p>
      <a href="https://www.theo2.co.uk/events/detail/baller-league-uk-2026-final-four" target="_blank" rel="noopener" class="btn btn-primary btn-lg">Get Tickets</a>
    </div>
  </div>

  <div class="container ff-body">

    <section class="ff-block card">
      <div class="card-body">
        <h2>What is the Final Four?</h2>
        <p>The Final Four is Baller League UK's season-ending playoff tournament. After 11 gameweeks, the <strong>top 4 teams</strong> qualify for a single-elimination knockout at a major venue — this season it's <strong>The O2 Arena in London</strong>. The 1st-place team faces 4th, and 2nd faces 3rd in the semi-finals. The two winners meet in the final to be crowned <strong>Baller League UK Season 3 champion</strong>. Every match is 30 minutes of 6v6 action with full Game Changer rules in play.</p>
        <div class="ff-format-row">
          <div class="ff-format-step"><span class="ff-step-num">1</span><strong>Semi-Final 1</strong><span class="text-muted">1st vs 4th</span></div>
          <span class="ff-format-arrow">→</span>
          <div class="ff-format-step"><span class="ff-step-num">2</span><strong>Semi-Final 2</strong><span class="text-muted">2nd vs 3rd</span></div>
          <span class="ff-format-arrow">→</span>
          <div class="ff-format-step ff-format-final"><span class="ff-step-num">🏆</span><strong>The Final</strong><span class="text-muted">Champion crowned</span></div>
        </div>
        <p class="text-muted" style="font-size: 0.85rem; margin-top: var(--space-md);">Past champions: <strong>SDS FC</strong> (Season 1) &middot; <strong>Wembley Rangers AFC</strong> (Season 2). <a href="/season">View all past seasons →</a></p>
      </div>
    </section>

    <section class="ff-block">
      <h2 style="margin-bottom: var(--space-lg);">The Qualified Teams</h2>
      <div class="ff-cards">
        {teams.map(t => (<a href={`/teams/${t.slug}`} class="ff-card ff-team-card">
          <div class="ff-card-top">
            <div class="ff-card-img-wrap">
              <img src={`/managers/${t.slug}.webp`} alt={t.manager} class="ff-card-img" loading="lazy" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'" />
              <span class="ff-card-fallback">{t.emoji}</span>
            </div>
            <div class="ff-card-meta">
              <span class="ff-pos">{t.pos}</span>
              <div>
                <h3 class="ff-card-name">
                  <img src={`/logos/${t.slug}.svg`} alt="" class="ff-card-badge" aria-hidden="true" onerror="this.style.display='none'" />
                  {t.name}
                </h3>
                <span class="text-muted">{t.manager}</span>
              </div>
            </div>
          </div>
          <div class="ff-card-stats">
            <div class="ff-stat"><span class="ff-stat-num">{t.stats.p}</span><span class="ff-stat-lbl">Played</span></div>
            <div class="ff-stat"><span class="ff-stat-num">{t.stats.w}</span><span class="ff-stat-lbl">Won</span></div>
            <div class="ff-stat"><span class="ff-stat-num">{t.stats.d}</span><span class="ff-stat-lbl">Drawn</span></div>
            <div class="ff-stat"><span class="ff-stat-num">{t.stats.l}</span><span class="ff-stat-lbl">Lost</span></div>
            <div class="ff-stat"><span class="ff-stat-num">{t.stats.gf}</span><span class="ff-stat-lbl">GF</span></div>
            <div class="ff-stat"><span class="ff-stat-num">{t.stats.gd > 0 ? '+' + t.stats.gd : t.stats.gd}</span><span class="ff-stat-lbl">GD</span></div>
            <div class="ff-stat ff-stat-pts"><span class="ff-stat-num">{t.pts}</span><span class="ff-stat-lbl">Pts</span></div>
            <div class="ff-stat"><span class="ff-stat-num" set:html={t.form.split('').map(l => formBadge(l)).join('')}></span><span class="ff-stat-lbl">Form</span></div>
          </div>
          <div class="ff-card-scorers">
            <span class="ff-scorers-label">Top Scorers:</span>
            {t.topScorers.map(ts => (<a href={`/players/${ts.slug}`} class="ff-scorer">{ts.name} <strong>{ts.goals}g</strong></a>))}
          </div>
        </a>))}
      </div>
    </section>

    <section class="ff-block">
      <h2 style="margin-bottom: var(--space-lg);">Semi-Final Matchups</h2>
      <div class="ff-semifinals">
        {[semi1, semi2].map((sf, i) => (<div class="ff-semi card">
          <div class="card-body">
            <div class="ff-semi-header">Semi-Final {i + 1}</div>
            <div class="ff-semi-row">
              <a href={`/teams/${sf.home.slug}`} class="ff-semi-team">
                <img src={`/managers/${sf.home.slug}.webp`} alt={sf.home.manager} class="ff-semi-img" loading="lazy" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'" />
                <span class="ff-semi-fb">{sf.home.emoji}</span>
                <div class="ff-semi-info">
                  <strong class="ff-semi-name">
                    <img src={`/logos/${sf.home.slug}.svg`} alt="" class="ff-semi-badge" aria-hidden="true" onerror="this.style.display='none'" />
                    {sf.home.name}
                  </strong>
                  <span class="text-muted">#{sf.home.pos} seed &middot; {sf.home.pts} pts &middot; {sf.home.manager}</span>
                </div>
              </a>
              <div class="ff-semi-vs">VS</div>
              <a href={`/teams/${sf.away.slug}`} class="ff-semi-team">
                <img src={`/managers/${sf.away.slug}.webp`} alt={sf.away.manager} class="ff-semi-img" loading="lazy" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'" />
                <span class="ff-semi-fb">{sf.away.emoji}</span>
                <div class="ff-semi-info">
                  <strong class="ff-semi-name">
                    <img src={`/logos/${sf.away.slug}.svg`} alt="" class="ff-semi-badge" aria-hidden="true" onerror="this.style.display='none'" />
                    {sf.away.name}
                  </strong>
                  <span class="text-muted">#{sf.away.pos} seed &middot; {sf.away.pts} pts &middot; {sf.away.manager}</span>
                </div>
              </a>
            </div>
            <div class="ff-h2h-block">
              <h4>Season 3 Head-to-Head</h4>
              {sf.h2h.length > 0 ? (<div class="ff-h2h-list">
                {sf.h2h.map(m => (<a href={`/news/${sf.home.slug}-vs-${sf.away.slug}-gw${m.gw}`} class="ff-h2h-row">
                  <span class="ff-h2h-gw">GW{m.gw}</span>
                  <span class="ff-h2h-score">{m.home} {m.hs}–{m.as} {m.away}</span>
                  <span class="ff-h2h-gc">{m.gc1} ({m.gc1g}) / {m.gc2} ({m.gc2g})</span>
                  <span class="ff-h2h-outcome">{m.hs > m.as ? m.home + ' won' : m.as > m.hs ? m.away + ' won' : 'Draw'}</span>
                </a>))}
              </div>) : (<p class="text-muted">No previous meetings this season.</p>)}
              <a href={`/h2h?t1=${sf.home.slug}&t2=${sf.away.slug}`} class="btn btn-ghost btn-sm" style="margin-top: 12px;">Full H2H Comparison</a>
            </div>
          </div>
        </div>))}
      </div>
    </section>

    <section class="ff-block card">
      <div class="card-body ff-watch-section">
        <h2>How to Watch</h2>
        <div class="ff-watch-grid">
          <div class="ff-watch-item"><strong>Sky Sports</strong><span>Live broadcast UK</span></div>
          <div class="ff-watch-item"><strong>YouTube</strong><a href="https://youtube.com/@BallerLeagueUK" target="_blank" rel="noopener">@BallerLeagueUK</a></div>
          <div class="ff-watch-item"><strong>Twitch</strong><a href="https://twitch.tv/ballerleagueuk" target="_blank" rel="noopener">ballerleagueuk</a></div>
          <div class="ff-watch-item"><strong>In Person</strong><a href="https://www.theo2.co.uk/events/detail/baller-league-uk-2026-final-four" target="_blank" rel="noopener">Get tickets →</a></div>
        </div>
      </div>
    </section>

  </div>
</Base>

<style>
/* ── HERO ── */
.ff-hero {
  background: linear-gradient(180deg, #1a0a2e 0%, var(--bg-primary) 100%);
  padding: var(--space-2xl) 0;
  border-bottom: 2px solid rgba(124,77,255,0.25);
  text-align: center;
}
.ff-hero-badge {
  display: inline-block;
  font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.12em;
  color: var(--purple-light); background: rgba(124,77,255,0.15);
  padding: 4px 16px; border-radius: 999px; margin-bottom: var(--space-md);
}
.ff-hero-title {
  font-size: 4rem; margin: 0 0 var(--space-sm); line-height: 1;
}
.ff-hero-subtitle {
  font-size: 1.1rem; color: var(--text-secondary); max-width: 640px;
  margin: 0 auto var(--space-xl);
}

/* ── BODY ── */
.ff-body {
  padding: var(--space-2xl) 0 var(--space-3xl);
  display: flex; flex-direction: column; gap: var(--space-2xl);
  max-width: 1000px;
}
.ff-block h2 { margin-bottom: var(--space-md); }

/* ── FORMAT ── */
.ff-format-row {
  display: flex; align-items: center; gap: var(--space-md); margin-top: var(--space-xl);
  flex-wrap: wrap; justify-content: center;
}
.ff-format-step {
  display: flex; flex-direction: column; align-items: center; gap: var(--space-xs);
  padding: var(--space-md) var(--space-xl); background: var(--bg-elevated);
  border: 1px solid var(--border); border-radius: var(--radius);
  text-align: center; min-width: 140px;
}
.ff-step-num {
  font-family: var(--font-display); font-size: 1.5rem; color: var(--purple-light);
}
.ff-format-final { border-color: rgba(124,77,255,0.3); }
.ff-format-arrow { font-size: 1.5rem; color: var(--purple-light); font-weight: 700; }

/* ── TEAM CARDS: flexbox wrap ── */
.ff-cards {
  display: flex; flex-wrap: wrap; gap: var(--space-lg);
}
.ff-team-card {
  flex: 1 1 calc(50% - var(--space-lg)); min-width: 340px;
  border: 1px solid var(--border); border-radius: var(--radius-lg);
  background: var(--bg-card); padding: var(--space-lg);
  transition: transform var(--transition), border-color var(--transition);
}
.ff-team-card:hover { transform: translateY(-3px); border-color: var(--purple-light); }

.ff-card-top {
  display: flex; gap: var(--space-md); align-items: center; margin-bottom: var(--space-md);
}
.ff-card-img-wrap { width: 80px; height: 80px; flex-shrink: 0; position: relative; }
.ff-card-img {
  width: 80px; height: 80px; border-radius: var(--radius); object-fit: cover; border: 2px solid var(--border);
}
.ff-card-fallback {
  display: none; width: 80px; height: 80px; border-radius: var(--radius);
  background: linear-gradient(135deg, var(--bg-elevated), var(--bg-card));
  border: 2px solid var(--border); align-items: center; justify-content: center; font-size: 2rem;
}
.ff-card-meta { flex: 1; min-width: 0; }
.ff-pos {
  font-family: var(--font-display); font-size: 2rem; color: var(--purple-light); line-height: 1;
}
.ff-card-name {
  font-size: 1.4rem; margin: 0; display: flex; align-items: center; gap: 6px;
}
.ff-card-badge { width: 22px; height: 22px; object-fit: contain; flex-shrink: 0; }

.ff-card-stats {
  display: flex; gap: var(--space-xs); flex-wrap: wrap; margin-bottom: var(--space-md);
}
.ff-stat {
  text-align: center; padding: 4px 10px; background: var(--bg-elevated);
  border-radius: var(--radius-sm); min-width: 40px;
}
.ff-stat-num {
  display: block; font-family: var(--font-display); font-size: 0.95rem; color: var(--text-primary); line-height: 1.2;
}
.ff-stat-lbl {
  display: block; font-size: 0.45rem; text-transform: uppercase; color: var(--text-muted); letter-spacing: 0.06em;
}
.ff-stat-pts { background: rgba(124,77,255,0.12); }
.ff-stat-pts .ff-stat-num { color: var(--purple-light); }

.ff-card-scorers {
  display: flex; flex-wrap: wrap; gap: var(--space-sm); align-items: center;
  padding-top: var(--space-sm); border-top: 1px solid var(--border-subtle);
}
.ff-scorers-label { font-size: 0.6rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-muted); }
.ff-scorer { font-size: 0.8rem; color: var(--text-secondary); }
.ff-scorer:hover { color: var(--green); }
.ff-scorer strong { color: var(--green); font-family: var(--font-display); font-size: 0.85rem; }

/* ── FORM BADGES ── */
:global(.form-badge) {
  display: inline-block; width: 18px; height: 18px; font-size: 0.55rem; font-weight: 800;
  line-height: 18px; text-align: center; border-radius: 3px;
}
:global(.form-badge.form-win) { background: rgba(0,230,118,0.15); color: var(--green); }
:global(.form-badge.form-draw) { background: rgba(245,158,11,0.12); color: var(--gold); }
:global(.form-badge.form-loss) { background: rgba(255,107,53,0.12); color: var(--orange); }

/* ── SEMI-FINALS ── */
.ff-semifinals { display: flex; flex-direction: column; gap: var(--space-lg); }
.ff-semi-header {
  font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em;
  color: var(--purple-light); margin-bottom: var(--space-md);
}
.ff-semi-row {
  display: flex; align-items: center; gap: var(--space-md);
}
.ff-semi-team {
  flex: 1; display: flex; align-items: center; gap: var(--space-sm);
  padding: var(--space-md); background: var(--bg-elevated); border-radius: var(--radius); min-width: 0;
  transition: background var(--transition);
}
.ff-semi-team:hover { background: var(--bg-card-hover); }
.ff-semi-img {
  width: 52px; height: 52px; border-radius: var(--radius-sm); object-fit: cover; flex-shrink: 0;
  border: 2px solid var(--border);
}
.ff-semi-fb {
  display: none; width: 52px; height: 52px; border-radius: var(--radius-sm);
  background: var(--bg-elevated); border: 2px solid var(--border); flex-shrink: 0;
  align-items: center; justify-content: center; font-size: 1.4rem;
}
.ff-semi-info { min-width: 0; }
.ff-semi-name {
  display: flex; align-items: center; gap: 6px; font-size: 1.05rem;
}
.ff-semi-badge { width: 20px; height: 20px; object-fit: contain; flex-shrink: 0; }
.ff-semi-vs {
  font-family: var(--font-display); font-size: 1.4rem; color: var(--purple-light); flex-shrink: 0;
}

.ff-h2h-block { margin-top: var(--space-lg); }
.ff-h2h-block h4 {
  font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em;
  color: var(--text-muted); margin-bottom: var(--space-sm);
}
.ff-h2h-list { display: flex; flex-direction: column; gap: var(--space-xs); }
.ff-h2h-row {
  display: flex; align-items: center; gap: var(--space-md); padding: var(--space-sm) var(--space-md);
  background: var(--bg-elevated); border-radius: var(--radius-sm); flex-wrap: wrap;
  transition: background var(--transition);
}
.ff-h2h-row:hover { background: var(--bg-card-hover); }
.ff-h2h-gw { font-size: 0.65rem; font-weight: 700; color: var(--text-muted); min-width: 30px; }
.ff-h2h-score { flex: 1; font-size: 0.88rem; font-weight: 600; color: var(--text-primary); min-width: 160px; }
.ff-h2h-gc { font-size: 0.7rem; color: var(--text-muted); }
.ff-h2h-outcome { font-size: 0.75rem; color: var(--text-muted); }

/* ── WATCH ── */
.ff-watch-section { }
.ff-watch-grid { display: flex; flex-wrap: wrap; gap: var(--space-md); margin-top: var(--space-lg); }
.ff-watch-item {
  flex: 1 1 150px; display: flex; flex-direction: column; gap: 4px;
  padding: var(--space-md); background: var(--bg-elevated); border: 1px solid var(--border);
  border-radius: var(--radius); text-align: center;
}
.ff-watch-item a { font-size: 0.85rem; color: var(--purple-light); }
.ff-watch-item a:hover { color: var(--green); }
.ff-watch-item strong { font-size: 0.95rem; }
.ff-watch-item span { font-size: 0.8rem; color: var(--text-muted); }

@media (max-width: 768px) {
  .ff-hero-title { font-size: 2.5rem; }
  .ff-team-card { flex: 1 1 100%; min-width: 0; }
  .ff-semi-row { flex-direction: column; }
  .ff-semi-vs { padding: var(--space-xs); }
}
</style>
