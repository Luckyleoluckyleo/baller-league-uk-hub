---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import gcData from '../data/gamechangers.json';
import playerData from '../data/players.json';

const s3Matches = (gcData.seasons['3']?.matches as any[] || []).filter((m: any) => m.homeScore > 0 || m.awayScore > 0);

const teams = [
  { name: 'NDL FC', slug: 'ndl-fc', pos: 1, pts: 26, manager: 'Niko Omilana', emoji: '🏆', color: '#00e676' },
  { name: 'Deportrio', slug: 'deportrio', pos: 2, pts: 23, manager: 'Micah Richards', emoji: '🔵', color: '#2196f3' },
  { name: 'Prime FC', slug: 'prime-fc', pos: 3, pts: 21, manager: 'KSI', emoji: '🔴', color: '#f44336' },
  { name: 'SDS FC', slug: 'sds-fc', pos: 4, pts: 20, manager: 'Tobi Brown', emoji: '🟢', color: '#4caf50' },
];

function getTopScorers(slug: string) {
  return playerData.players
    .filter((p: any) => p.teamSlug === slug && (p.seasons?.['3']?.goals || 0) > 0)
    .sort((a: any, b: any) => (b.seasons?.['3']?.goals || 0) - (a.seasons?.['3']?.goals || 0))
    .slice(0, 3)
    .map((p: any) => ({ name: p.name, goals: p.seasons['3'].goals, slug: p.slug }));
}

function getTeamStats(slug: string) {
  const ms = s3Matches.filter((m: any) => m.homeSlug === slug || m.awaySlug === slug);
  let w = 0, d = 0, l = 0, gf = 0, ga = 0;
  ms.forEach((m: any) => {
    const isHome = m.homeSlug === slug;
    gf += isHome ? m.homeScore : m.awayScore;
    ga += isHome ? m.awayScore : m.homeScore;
    if (isHome ? m.homeScore > m.awayScore : m.awayScore > m.homeScore) w++;
    else if (m.homeScore === m.awayScore) d++;
    else l++;
  });
  return { played: ms.length, w, d, l, gf, ga, gd: gf - ga };
}

function getH2H(s1: string, s2: string) {
  return s3Matches
    .filter((m: any) => (m.homeSlug === s1 && m.awaySlug === s2) || (m.homeSlug === s2 && m.awaySlug === s1))
    .map((m: any) => ({
      gw: m.gameweek,
      home: m.homeTeam,
      away: m.awayTeam,
      hs: m.homeScore,
      as: m.awayScore,
    }))
    .sort((a: any, b: any) => a.gw - b.gw);
}

const semi1 = { home: teams[0], away: teams[3], h2h: getH2H(teams[0].slug, teams[3].slug) };
const semi2 = { home: teams[1], away: teams[2], h2h: getH2H(teams[1].slug, teams[2].slug) };

teams.forEach(t => {
  (t as any).stats = getTeamStats(t.slug);
  (t as any).topScorers = getTopScorers(t.slug);
});

const schema = {
  "@context": "https://schema.org",
  "@type": "SportsEvent",
  "name": "Baller League UK Season 3 Final Four",
  "description": "The Baller League UK Season 3 Final Four at The O2 London on Monday 25 May 2026. NDL FC, Deportrio, Prime FC, and SDS FC battle for the championship.",
  "startDate": "2026-05-25T18:00:00+01:00",
  "location": { "@type": "Place", "name": "The O2 Arena", "address": { "@type": "PostalAddress", "addressLocality": "London", "addressCountry": "GB" } },
  "organizer": { "@type": "Organization", "name": "Baller League UK", "url": "https://ballerleague.uk" },
  "performer": [
    { "@type": "SportsTeam", "name": "NDL FC", "url": "https://ballerleagueukhub.com/teams/ndl-fc" },
    { "@type": "SportsTeam", "name": "Deportrio", "url": "https://ballerleagueukhub.com/teams/deportrio" },
    { "@type": "SportsTeam", "name": "Prime FC", "url": "https://ballerleagueukhub.com/teams/prime-fc" },
    { "@type": "SportsTeam", "name": "SDS FC", "url": "https://ballerleagueukhub.com/teams/sds-fc" }
  ]
};
---

<Base
  title="Baller League UK Final Four 2026 — Teams, Matchups, H2H & Preview"
  description="The Baller League UK Season 3 Final Four at The O2 London on Monday 25 May 2026. NDL FC vs SDS FC and Deportrio vs Prime FC in the semi-finals. Full team profiles, H2H history, key players, and format guide."
  schema={schema}
  keywords="Baller League Final Four, The O2, NDL FC, Deportrio, Prime FC, SDS FC, semi-final, playoffs, champion, 25 May 2026"
>
  <div class="page-header ff-header">
    <div class="container">
      <Breadcrumb items={[{name:'Home',url:'/'},{name:'Final Four'}]} />
      <div class="ff-badge-pulse">
        <span class="ff-badge-dot"></span>
        <span class="ff-badge-text">Season 3 Playoffs</span>
      </div>
      <h1 class="ff-main-title">The Final Four</h1>
      <p class="section-subtitle ff-subtitle">
        Monday 25 May 2026 — The O2, London — Live on Sky Sports, YouTube & Twitch
      </p>
      <a href="https://www.theo2.co.uk/events/detail/baller-league-uk-2026-final-four" target="_blank" rel="noopener noreferrer" class="btn btn-gold btn-lg ff-ticket-btn">Secure Your Tickets</a>
    </div>
  </div>

  <div class="container ff-page">

    <!-- THE QUALIFIED TEAMS -->
    <section class="ff-section">
      <div class="ff-section-header">
        <h2 class="ff-section-title">The Qualified Teams</h2>
        <p class="text-muted">The top 4 teams that battled through 11 gameweeks to reach the grand finale.</p>
      </div>
      
      <div class="ff-teams-grid">
        {teams.map(t => (
          <a href={`/teams/${t.slug}`} class={`ff-team-card card rank-${t.pos}`}>
            <div class="ff-team-rank">#{t.pos}</div>
            <div class="card-body ff-team-body">
              
              <div class="ff-team-header">
                <div class="ff-logo-container">
                  <img src={`/logos/${t.slug}.svg`} alt={t.name} class="ff-team-logo" loading="lazy" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'" />
                  <span class="ff-team-logo-fallback">{t.emoji}</span>
                </div>
                <div class="ff-team-info">
                  <h3 class="ff-team-name">{t.name}</h3>
                  <div class="ff-manager-tag">
                    <img src={`/managers/${t.slug}.webp`} alt={t.manager} class="ff-manager-avatar" loading="lazy" onerror="this.hidden=true" />
                    <span>{t.manager}</span>
                  </div>
                </div>
                <div class="ff-points-box">
                  <span class="ff-points-val">{t.pts}</span>
                  <span class="ff-points-lbl">PTS</span>
                </div>
              </div>

              <div class="ff-stats-row">
                <div class="ff-stat-pill"><span class="val">{t.stats.played}</span> <span class="lbl">GP</span></div>
                <div class="ff-stat-pill"><span class="val">{t.stats.w}</span> <span class="lbl">W</span></div>
                <div class="ff-stat-pill"><span class="val">{t.stats.d}</span> <span class="lbl">D</span></div>
                <div class="ff-stat-pill"><span class="val">{t.stats.l}</span> <span class="lbl">L</span></div>
                <div class="ff-stat-pill"><span class="val">{t.stats.gf}</span> <span class="lbl">GF</span></div>
                <div class="ff-stat-pill"><span class="val">{t.stats.gd > 0 ? '+' + t.stats.gd : t.stats.gd}</span> <span class="lbl">GD</span></div>
              </div>

              <div class="ff-scorers-box">
                <div class="ff-scorers-title">Top Scorers</div>
                <div class="ff-scorers-list">
                  {t.topScorers.map(ts => (
                    <div class="ff-scorer-item">
                      <span class="name" set:html={ts.name}></span>
                      <span class="goals">{ts.goals}</span>
                    </div>
                  ))}
                </div>
              </div>

            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- SEMI-FINALS -->
    <section class="ff-section">
      <div class="ff-section-header">
        <h2 class="ff-section-title">Semi-Final Matchups</h2>
        <p class="text-muted">Single elimination. Winner advances to the Final to be crowned Champion.</p>
      </div>

      <div class="ff-matchups-container">
        {[semi1, semi2].map((sf, i) => (
          <div class="ff-matchup-card card">
            <div class="ff-matchup-badge">Semi-Final {i + 1}</div>
            
            <div class="ff-matchup-battle">
              <!-- Home Team -->
              <a href={`/teams/${sf.home.slug}`} class="ff-battle-team home">
                <div class="ff-battle-info">
                  <span class="ff-seed">#{sf.home.pos} Seed</span>
                  <h3 class="ff-battle-name">{sf.home.name}</h3>
                  <span class="ff-battle-manager">{sf.home.manager}</span>
                </div>
                <div class="ff-battle-logo-wrap">
                  <img src={`/logos/${sf.home.slug}.svg`} alt={sf.home.name} class="ff-battle-logo" loading="lazy" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'" />
                  <span class="ff-battle-fallback">{sf.home.emoji}</span>
                </div>
              </a>

              <!-- VS Badge -->
              <div class="ff-battle-vs">
                <span>VS</span>
              </div>

              <!-- Away Team -->
              <a href={`/teams/${sf.away.slug}`} class="ff-battle-team away">
                <div class="ff-battle-logo-wrap">
                  <img src={`/logos/${sf.away.slug}.svg`} alt={sf.away.name} class="ff-battle-logo" loading="lazy" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'" />
                  <span class="ff-battle-fallback">{sf.away.emoji}</span>
                </div>
                <div class="ff-battle-info">
                  <span class="ff-seed">#{sf.away.pos} Seed</span>
                  <h3 class="ff-battle-name">{sf.away.name}</h3>
                  <span class="ff-battle-manager">{sf.away.manager}</span>
                </div>
              </a>
            </div>

            <!-- H2H Section -->
            <div class="ff-h2h-section">
              <div class="ff-h2h-header">
                <h4>Season 3 Head-to-Head</h4>
                <a href={`/h2h?t1=${sf.home.slug}&t2=${sf.away.slug}`} class="ff-h2h-link">Full Comparison →</a>
              </div>
              
              {sf.h2h.length > 0 ? (
                <div class="ff-h2h-table">
                  {sf.h2h.map(m => (
                    <a href={`/news/${sf.home.slug}-vs-${sf.away.slug}-gw${m.gw}`} class="ff-h2h-row">
                      <span class="gw">GW{m.gw}</span>
                      <span class="match">{m.home} <strong>{m.hs}–{m.as}</strong> {m.away}</span>
                      <span class="result">{m.hs > m.as ? `${m.home} won` : m.as > m.hs ? `${m.away} won` : 'Draw'}</span>
                    </a>
                  ))}
                </div>
              ) : (
                <div class="ff-h2h-empty">No previous meetings this season.</div>
              )}
            </div>

          </div>
        ))}
      </div>
    </section>

    <!-- WHAT IS THE FINAL FOUR -->
    <section class="ff-section card ff-format-section">
      <div class="card-body">
        <h2 class="ff-section-title">Tournament Format</h2>
        <p class="text-secondary" style="max-width: 800px; margin-bottom: var(--space-xl);">
          After 11 gameweeks of intense regular-season action, only the <strong>top 4 teams</strong> qualify. The format is a high-stakes, single-elimination knockout tournament all taking place on one massive night.
        </p>
        <div class="ff-bracket-grid">
          <div class="ff-bracket-item">
            <div class="step">1</div>
            <h4>Semi-Final 1</h4>
            <p>1st Place vs 4th Place</p>
          </div>
          <div class="ff-bracket-item">
            <div class="step">2</div>
            <h4>Semi-Final 2</h4>
            <p>2nd Place vs 3rd Place</p>
          </div>
          <div class="ff-bracket-item final">
            <div class="step">3</div>
            <h4>The Final</h4>
            <p>Winner SF1 vs Winner SF2</p>
          </div>
        </div>
      </div>
    </section>

    <!-- PAST WINNERS -->
    <section class="ff-section">
      <h2 class="ff-section-title">Hall of Fame</h2>
      <div class="ff-past-grid">
        <div class="ff-past-card">
          <div class="season-badge">Season 1</div>
          <div class="trophy-icon">🏆</div>
          <h3 class="champion">SDS FC</h3>
          <p class="details">Manager: Tobi Brown<br/>Beat MVPs United</p>
        </div>
        <div class="ff-past-card">
          <div class="season-badge">Season 2</div>
          <div class="trophy-icon">🏆</div>
          <h3 class="champion">Wembley Rangers</h3>
          <p class="details">Manager: Ian Wright<br/>Beat SDS FC</p>
        </div>
        <div class="ff-past-card current">
          <div class="season-badge gold-text">Season 3</div>
          <div class="trophy-icon glow">⏳</div>
          <h3 class="champion gold-text">To Be Decided</h3>
          <p class="details">25 May 2026<br/>The O2, London</p>
        </div>
      </div>
    </section>

    <!-- WHERE TO WATCH -->
    <section class="ff-section">
      <h2 class="ff-section-title text-center">Where to Watch</h2>
      <div class="ff-watch-grid">
        <a href="https://www.youtube.com/@BallerLeagueUK" target="_blank" rel="noopener noreferrer" class="ff-watch-item youtube">
          <span class="icon">▶</span>
          <strong>YouTube</strong>
          <span>@BallerLeagueUK</span>
        </a>
        <a href="https://www.twitch.tv/ballerleagueuk" target="_blank" rel="noopener noreferrer" class="ff-watch-item twitch">
          <span class="icon">💬</span>
          <strong>Twitch</strong>
          <span>ballerleagueuk</span>
        </a>
        <div class="ff-watch-item sky">
          <span class="icon">📺</span>
          <strong>Sky Sports</strong>
          <span>Live Broadcast</span>
        </div>
        <a href="https://www.theo2.co.uk/events/detail/baller-league-uk-2026-final-four" target="_blank" rel="noopener noreferrer" class="ff-watch-item live">
          <span class="icon">🎟️</span>
          <strong>The O2 Arena</strong>
          <span>Get Tickets</span>
        </a>
      </div>
    </section>

  </div>
</Base>

<style>
/* Header & Hero */
.ff-header {
  background: radial-gradient(circle at 50% 100%, rgba(245, 158, 11, 0.15) 0%, var(--bg-primary) 70%), 
              linear-gradient(180deg, #111 0%, var(--bg-primary) 100%);
  padding-bottom: var(--space-3xl);
  border-bottom: 1px solid rgba(245, 158, 11, 0.3);
  text-align: center;
  position: relative;
  overflow: hidden;
}

.ff-header::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background-image: linear-gradient(rgba(255,255,255,0.03) 1px, transparent 1px),
                    linear-gradient(90deg, rgba(255,255,255,0.03) 1px, transparent 1px);
  background-size: 40px 40px;
  pointer-events: none;
}

.ff-badge-pulse {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: rgba(245, 158, 11, 0.1);
  border: 1px solid rgba(245, 158, 11, 0.3);
  padding: 6px 16px;
  border-radius: var(--radius-full);
  margin-bottom: var(--space-lg);
  position: relative;
  z-index: 1;
}

.ff-badge-dot {
  width: 8px; height: 8px;
  background: var(--gold);
  border-radius: 50%;
  box-shadow: 0 0 10px var(--gold);
  animation: pulseGold 2s infinite;
}

@keyframes pulseGold {
  0% { box-shadow: 0 0 0 0 rgba(245, 158, 11, 0.7); }
  70% { box-shadow: 0 0 0 10px rgba(245, 158, 11, 0); }
  100% { box-shadow: 0 0 0 0 rgba(245, 158, 11, 0); }
}

.ff-badge-text {
  color: var(--gold);
  font-size: 0.8rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.1em;
}

.ff-main-title {
  font-size: clamp(3rem, 8vw, 6rem);
  text-transform: uppercase;
  background: linear-gradient(to bottom, #fff, #bbb);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  margin-bottom: var(--space-md);
  text-shadow: 0 10px 30px rgba(0,0,0,0.5);
  position: relative;
  z-index: 1;
}

.ff-subtitle {
  margin: 0 auto var(--space-xl);
  font-size: 1.2rem;
  color: var(--text-secondary);
  position: relative;
  z-index: 1;
}

.btn-gold {
  background: linear-gradient(135deg, var(--gold), #d97706);
  color: #fff;
  border: none;
  font-family: var(--font-display);
  font-size: 1.2rem;
  letter-spacing: 0.05em;
  padding: 16px 32px;
  border-radius: var(--radius);
  position: relative;
  z-index: 1;
  box-shadow: 0 4px 15px rgba(245, 158, 11, 0.4);
}
.btn-gold:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 20px rgba(245, 158, 11, 0.6);
}

.ff-page {
  padding: var(--space-xl) 0 var(--space-3xl);
  display: flex;
  flex-direction: column;
  gap: var(--space-3xl);
}

.ff-section-header {
  margin-bottom: var(--space-xl);
  text-align: center;
}
.ff-section-title {
  font-size: 2.5rem;
  margin-bottom: var(--space-sm);
  color: var(--text-primary);
}

/* -------------------------------------
   QUALIFIED TEAMS (FIXED GRID)
------------------------------------- */
.ff-teams-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--space-xl);
}

.ff-team-card {
  position: relative;
  display: block;
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  overflow: hidden;
  transition: all var(--transition-slow);
  text-decoration: none;
}

.ff-team-card:hover {
  transform: translateY(-4px);
  box-shadow: var(--shadow-lg);
  border-color: rgba(255,255,255,0.2);
}

/* Rank-based styling */
.ff-team-card.rank-1 { border-top: 3px solid var(--gold); }
.ff-team-card.rank-2 { border-top: 3px solid #e2e8f0; } /* Silver */
.ff-team-card.rank-3 { border-top: 3px solid #cd7f32; } /* Bronze */
.ff-team-card.rank-4 { border-top: 3px solid var(--green); }

.ff-team-rank {
  position: absolute;
  top: 16px;
  right: 16px;
  font-family: var(--font-display);
  font-size: 3rem;
  color: rgba(255,255,255,0.05);
  line-height: 1;
  pointer-events: none;
}

.ff-team-body {
  padding: var(--space-xl);
  display: flex;
  flex-direction: column;
  gap: var(--space-lg);
}

.ff-team-header {
  display: flex;
  align-items: center;
  gap: var(--space-md);
  position: relative;
  z-index: 2;
}

.ff-logo-container {
  width: 80px;
  height: 80px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ff-team-logo {
  width: 100%;
  height: 100%;
  object-fit: contain;
  filter: drop-shadow(0 4px 10px rgba(0,0,0,0.3));
}

.ff-team-logo-fallback {
  display: none;
  font-size: 3rem;
}

.ff-team-info {
  flex: 1;
}

.ff-team-name {
  font-size: 1.8rem;
  margin: 0 0 4px 0;
  color: var(--text-primary);
  line-height: 1.1;
}

.ff-manager-tag {
  display: flex;
  align-items: center;
  gap: 12px;
  font-size: 1rem;
  font-weight: 600;
  color: var(--text-secondary);
  margin-top: 6px;
}

.ff-manager-avatar {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  object-fit: cover;
  border: 2px solid var(--border);
}

.ff-points-box {
  text-align: right;
}
.ff-points-val {
  display: block;
  font-family: var(--font-display);
  font-size: 2.5rem;
  color: var(--text-primary);
  line-height: 1;
}
.ff-points-lbl {
  font-size: 0.7rem;
  text-transform: uppercase;
  color: var(--text-muted);
  letter-spacing: 0.1em;
}

.ff-stats-row {
  display: flex;
  gap: 8px;
  background: var(--bg-elevated);
  padding: 12px;
  border-radius: var(--radius);
  justify-content: space-between;
}

.ff-stat-pill {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.ff-stat-pill .val {
  font-family: var(--font-display);
  font-size: 1.2rem;
  color: var(--text-primary);
  line-height: 1;
}

.ff-stat-pill .lbl {
  font-size: 0.65rem;
  text-transform: uppercase;
  color: var(--text-muted);
  letter-spacing: 0.05em;
  margin-top: 2px;
}

.ff-scorers-box {
  border-top: 1px solid var(--border-subtle);
  padding-top: var(--space-md);
}

.ff-scorers-title {
  font-size: 0.7rem;
  text-transform: uppercase;
  color: var(--text-muted);
  letter-spacing: 0.1em;
  margin-bottom: var(--space-sm);
}

.ff-scorers-list {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.ff-scorer-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 0.9rem;
  color: var(--text-secondary);
}

.ff-scorer-item .goals {
  font-weight: 700;
  color: var(--green);
}

/* -------------------------------------
   SEMI-FINAL MATCHUPS
------------------------------------- */
.ff-matchups-container {
  display: flex;
  flex-direction: column;
  gap: var(--space-2xl);
}

.ff-matchup-card {
  background: linear-gradient(145deg, var(--bg-card), var(--bg-secondary));
  border: 1px solid var(--border);
  overflow: hidden;
  position: relative;
}

.ff-matchup-badge {
  position: absolute;
  top: 0; left: 50%;
  transform: translateX(-50%);
  background: var(--purple);
  color: #fff;
  padding: 4px 16px;
  font-size: 0.75rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  border-bottom-left-radius: var(--radius);
  border-bottom-right-radius: var(--radius);
  z-index: 10;
}

.ff-matchup-battle {
  display: flex;
  align-items: center;
  padding: var(--space-2xl) var(--space-xl);
  position: relative;
}

.ff-battle-team {
  flex: 1;
