---
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import TeamCard from '../../components/TeamCard.astro';
import StatStrip from '../../components/StatStrip.astro';
import { getCollection } from 'astro:content';
import playersData from '../../data/players.json';
import { CURRENT_SEASON, standingsFor } from '../../lib/league';

const teams = await getCollection('teams');
const standings = standingsFor(CURRENT_SEASON);
const standingBySlug: Record<string, any> = Object.fromEntries(standings.map((s) => [s.slug, s]));

// Show only the current-season line-up (historical teams remain reachable by URL).
const teamsWithStandings = teams
  .filter((team) => standingBySlug[team.data.urlSlug])
  .map((team) => ({ ...team, standing: standingBySlug[team.data.urlSlug] }))
  .sort((a, b) => (a.standing?.pos ?? 99) - (b.standing?.pos ?? 99));

const seasonOf = (p: any) => p.seasons?.[String(CURRENT_SEASON)] || {};
const topScorer = [...(playersData.players as any[])].sort((a, b) => (seasonOf(b).goals || 0) - (seasonOf(a).goals || 0))[0];

const faqs = [
  { q: "How many teams are in Baller League UK?", a: `There are 12 teams in Baller League UK Season ${CURRENT_SEASON}, each with a celebrity or footballing manager.` },
  { q: "Who manages the Baller League UK teams?", a: `The Season ${CURRENT_SEASON} dugouts include KSI (Prime FC), Niko Omilana (NDL FC), Mark Goldbridge and Spencer Owen (Gold Devils FC), Jens Lehmann (N5 FC), Jay-Jay Okocha (Toma), Alex Iwobi (P17 FC) and Danny Aarons (RTG FC).` },
  { q: "How does the Baller League UK season work?", a: "Twelve teams play 11 Monday-night matchdays. The top four after the regular season qualify for the Final Four playoffs." },
  { q: "Where are Baller League UK matches played?", a: "Matches are played at the Baller League Arena at Eastbrook Studios in Dagenham, London." },
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "Baller League UK Teams",
    "description": `All 12 teams competing in Baller League UK Season ${CURRENT_SEASON}, with managers, squads and league positions.`,
    "about": { "@type": "SportsOrganization", "name": "Baller League UK", "sport": "Football" },
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": `Baller League UK Season ${CURRENT_SEASON} teams`,
    "itemListElement": teamsWithStandings.map((t, i) => ({
      "@type": "ListItem",
      "position": i + 1,
      "name": t.data.name,
      "url": `https://ballerleagueukhub.com/teams/${t.data.urlSlug}/`,
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map((f) => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } })),
  },
];
---

<Base
  title={`Baller League UK Teams 2026 — All 12 Clubs, Managers & Squads`}
  description={`All 12 Baller League UK teams for Season ${CURRENT_SEASON} — managers, squads, form, fixtures and stats for every club, from Prime FC to Toma.`}
  keywords={`teams, managers, squads, Season ${CURRENT_SEASON}, KSI, Niko Omilana, Sharky, Mark Goldbridge, Alex Iwobi`}
  schema={schema}
>
  <div class="page-header">
    <div class="container">
      <Breadcrumb items={[{name:'Home',url:'/'},{name:'Teams'}]} />
      <div class="section-label">Season {CURRENT_SEASON}</div>
      <h1>All 12 Teams</h1>
      <p class="section-subtitle">Every team competing in Baller League UK Season {CURRENT_SEASON}.</p>
    </div>
  </div>

  <div class="container teams-page">
    <p class="page-intro">
      Baller League UK is a 6-a-side celebrity football league built around <strong>12 teams</strong>, each fronted by a
      famous manager. Season {CURRENT_SEASON} runs across 11 Monday-night matchdays at the Baller League Arena in Dagenham,
      with the top four reaching the Final Four playoffs. Below is every Baller League UK team for Season {CURRENT_SEASON} —
      tap any club for its manager, squad, form, results and current league position. Looking for the dugout instead?
      Meet every <a href="/managers">Baller League UK manager</a> with their club and season record.
    </p>
    <StatStrip
      stats={[
        { icon: '🏆', label: 'Defending champions', value: 'Prime FC', sub: 'Season 3 winners', href: '/teams/prime-fc' },
        { icon: '📅', label: 'Season 4 starts', value: '12 Oct 2026', sub: '11 matchdays' },
        { icon: '⚽', label: 'Top scorer', value: topScorer.name, sub: `${seasonOf(topScorer).goals || 0} goals`, href: `/players/${topScorer.slug}` },
        { icon: '👥', label: 'Teams', value: `${teamsWithStandings.length}`, sub: '12 managers' },
      ]}
    />
    <div class="teams-grid">
      {teamsWithStandings.map(team => (
        <TeamCard
          name={team.data.name}
          slug={team.data.urlSlug}
          manager={team.data.manager}
          managerRole={team.data.managerRole}
          emoji={team.data.emoji}
          points={team.standing?.pts}
          position={team.standing?.pos}
        />
      ))}
    </div>

    <section class="teams-faq">
      <div class="section-header">
        <div>
          <div class="section-label">Quick answers</div>
          <h2 class="section-title">Baller League UK teams FAQ</h2>
        </div>
      </div>
      <div class="faq-list">
        {faqs.map((f) => (
          <details class="faq-item">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
      <p class="teams-related">New to the league? Read the <a href="/rules">full rules</a>, browse the <a href="/explainers">explainers</a>, or see every <a href="/reports">match report</a>.</p>
    </section>
  </div>
</Base>

<style>
.teams-page { padding-bottom: var(--space-3xl); }
.page-intro { max-width: 820px; color: var(--text-secondary); line-height: 1.8; margin-bottom: var(--space-xl); }
.teams-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
  gap: var(--space-xl);
  margin-bottom: var(--space-2xl);
}

.teams-faq { margin-top: var(--space-2xl); }
.faq-list { display: flex; flex-direction: column; gap: var(--space-sm); }
.faq-item { background: var(--bg-elevated); border: 1px solid var(--border); border-radius: var(--radius); }
.faq-item summary { padding: var(--space-md); font-weight: 600; color: var(--text-primary); cursor: pointer; list-style: none; }
.faq-item summary::-webkit-details-marker { display: none; }
.faq-item p { padding: 0 var(--space-md) var(--space-md); color: var(--text-secondary); line-height: 1.7; margin: 0; }
.teams-related { margin-top: var(--space-lg); color: var(--text-secondary); }
.teams-related a { color: var(--green); }

@media (max-width: 1024px) {
  .teams-grid {
    gap: var(--space-lg);
  }
}

@media (max-width: 560px) {
  .teams-grid { 
    grid-template-columns: 1fr; 
  }
}
</style>
