---
import Base from '../../layouts/Base.astro';
import gcData from '../../data/gamechangers.json';
import tableData from '../../data/table.json';

export function getStaticPaths() {
  return [1, 2, 3].map(id => ({ params: { seasonId: String(id) } }));
}

const seasonId = Astro.params.seasonId;
const sMatches = (gcData.seasons[seasonId]?.matches as any[] || []).filter((m: any) => m.homeScore > 0 || m.awayScore > 0);

const gws = [...new Set(sMatches.map((m: any) => m.gameweek))].sort((a: any, b: any) => a - b);
const totalGoals = sMatches.reduce((s: number, m: any) => s + m.homeScore + m.awayScore, 0);
const teams = [...new Set(sMatches.flatMap((m: any) => [m.homeTeam, m.awayTeam]))].sort();

const records: Record<string, { played: number; won: number; drawn: number; lost: number; gf: number; ga: number }> = {};
for (const m of sMatches) {
  if (!records[m.homeTeam]) records[m.homeTeam] = { played: 0, won: 0, drawn: 0, lost: 0, gf: 0, ga: 0 };
  if (!records[m.awayTeam]) records[m.awayTeam] = { played: 0, won: 0, drawn: 0, lost: 0, gf: 0, ga: 0 };
  records[m.homeTeam].played++; records[m.awayTeam].played++;
  records[m.homeTeam].gf += m.homeScore; records[m.homeTeam].ga += m.awayScore;
  records[m.awayTeam].gf += m.awayScore; records[m.awayTeam].ga += m.homeScore;
  if (m.homeScore > m.awayScore) { records[m.homeTeam].won++; records[m.awayTeam].lost++; }
  else if (m.awayScore > m.homeScore) { records[m.awayTeam].won++; records[m.homeTeam].lost++; }
  else { records[m.homeTeam].drawn++; records[m.awayTeam].drawn++; }
}

const epLookup: Record<string, number> = {};
if (seasonId === '3') {
  for (const row of tableData) {
    epLookup[row.team] = row.ep || 0;
  }
}

const table = teams.map(team => {
  const r = records[team] || { played: 0, won: 0, drawn: 0, lost: 0, gf: 0, ga: 0 };
  const ep = epLookup[team] || 0;
  return {
    team,
    played: r.played,
    won: r.won,
    drawn: r.drawn,
    lost: r.lost,
    gf: r.gf,
    ga: r.ga,
    gd: r.gf - r. ga,
    ep,
    pts: r.won * 3 + r.drawn + ep,
  };
});
table.sort((a, b) => b.pts - a.pts || b.gd - a.gd || b.gf - a.gf);

const top4 = table.slice(0, 4);

const schema = {
  "@context": "https://schema.org",
  "@type": "SportsEvent",
  "name": `Baller League UK Season ${seasonId}`,
  "description": `Full standings and results for Baller League UK Season ${seasonId}. ${teams.length} teams, ${sMatches.length} matches, ${totalGoals} goals.`,
  "sport": "Football",
  "organizer": { "@type": "SportsOrganization", "name": "Baller League UK" },
};
---

<Base
  title={`Baller League UK Season ${seasonId} — Standings & Results`}
  description={`Full Season ${seasonId} standings for Baller League UK. ${teams.length} teams, ${sMatches.length} matches, ${totalGoals} total goals across ${gws.length} gameweeks. Full table with wins, draws, losses, goals, and points.`}
  schema={schema}
  keywords={`Season ${seasonId}, standings, table, results, Baller League UK, teams, champions`}
>
  <div class="page-header">
    <div class="container">
      <nav class="breadcrumb"><a href="/">Home</a><span class="breadcrumb-sep">›</span><a href="/season">Seasons</a><span class="breadcrumb-sep">›</span><span>Season {seasonId}</span></nav>
      <div class="section-label">Season {seasonId} · {gws.length} Gameweeks</div>
      <h1>Season {seasonId} Standings</h1>
      <p class="section-subtitle">
        {teams.length} teams · {sMatches.length} matches · {totalGoals} goals · {(totalGoals / sMatches.length).toFixed(1)} goals per match
      </p>
    </div>
  </div>

  <div class="container season-detail-page">
    <div class="season-nav">
      {[1, 2, 3].map(sid => (
        <a href={`/season/${sid}`} class={`season-nav-link ${String(sid) === seasonId ? 'active' : ''}`}>
          Season {sid}
        </a>
      ))}
    </div>

    <div class="table-wrapper card">
      <table class="standings-table">
        <thead>
          <tr>
            <th class="col-pos">#</th>
            <th class="col-team">Team</th>
            <th class="col-num">GP</th>
            <th class="col-num">W</th>
            <th class="col-num">D</th>
            <th class="col-num">L</th>
            <th class="col-num">GF</th>
            <th class="col-num">GA</th>
            <th class="col-num">GD</th>
            {seasonId === '3' && <th class="col-num">EP</th>}
            <th class="col-num pts-col">PTS</th>
          </tr>
        </thead>
        <tbody>
          {table.map((row, i) => (
            <tr class={`${i < 4 ? 'row-top4' : ''} ${i === 0 ? 'row-champion' : ''}`}>
              <td class="col-pos">
                {i === 0 ? <span class="champion-star">&#x1F3C6;</span> : i + 1}
              </td>
              <td class="col-team">
                <strong>{row.team}</strong>
              </td>
              <td class="col-num">{row.played}</td>
              <td class="col-num">{row.won}</td>
              <td class="col-num">{row.drawn}</td>
              <td class="col-num">{row.lost}</td>
              <td class="col-num">{row.gf}</td>
              <td class="col-num">{row.ga}</td>
              <td class="col-num">{row.gd >= 0 ? '+' : ''}{row.gd}</td>
              {seasonId === '3' && <td class="col-num ep-col">{row.ep}</td>}
              <td class="col-num pts-col"><strong>{row.pts}</strong></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="season-cta">
      <a href="/season" class="btn btn-ghost">&larr; All Seasons</a>
      <a href="/table" class="btn btn-secondary">Current Season Table</a>
    </div>
  </div>
</Base>

<style>
.season-detail-page { padding-bottom: var(--space-3xl); }

.season-nav { display: flex; gap: 8px; margin-bottom: var(--space-xl); justify-content: center; }
.season-nav-link {
  background: var(--bg-card); color: var(--text-secondary); border: 1px solid var(--border);
  padding: 8px 24px; border-radius: var(--radius-sm); font-size: 0.95rem; font-weight: 600;
  text-decoration: none; transition: all var(--transition); font-family: var(--font-display); letter-spacing: 0.04em;
}
.season-nav-link:hover { border-color: var(--green); color: var(--green); }
.season-nav-link.active { background: var(--green-glow); border-color: var(--green); color: var(--green); }

.table-wrapper { overflow-x: auto; margin-bottom: var(--space-xl); }
.standings-table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
.standings-table thead { border-bottom: 2px solid var(--border); }
.standings-table th { padding: 12px 10px; text-align: left; font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-muted); font-weight: 700; }
.standings-table td { padding: 12px 10px; border-bottom: 1px solid var(--border); color: var(--text-secondary); }
.col-pos { width: 40px; text-align: center; }
.col-team { min-width: 160px; }
.col-num { text-align: center; width: 44px; }
.col-num strong { color: var(--text-primary); }
.pts-col { color: var(--green) !important; font-weight: 700; }
.ep-col { color: var(--purple) !important; font-weight: 600; }
.row-top4 { background: rgba(0, 230, 118, 0.03); }
.row-champion td { border-bottom-color: var(--green); }
.champion-star { font-size: 1.2rem; }

.season-cta { display: flex; gap: var(--space-md); justify-content: center; flex-wrap: wrap; }

@media (max-width: 640px) {
  .standings-table { font-size: 0.8rem; }
  .standings-table th, .standings-table td { padding: 8px 6px; }
  .col-num { width: 34px; }
  .col-team { min-width: 120px; }
}
</style>
