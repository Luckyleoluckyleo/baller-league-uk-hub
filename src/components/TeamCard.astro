---
import { teamColor, teamColorSoft } from '../lib/league';

export interface Props {
  name: string;
  slug: string;
  manager: string;
  managerRole?: string;
  emoji?: string;
  points?: number;
  position?: number;
}
const { name, slug, manager, managerRole = 'Manager', emoji = '⚽', points, position } = Astro.props;

const color = teamColor(slug);
const soft = teamColorSoft(slug, 0.18);
const glow = teamColorSoft(slug, 0.30);
const firstManagerSlug = (manager.split(',')[0] || '').trim().toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
---
<a href={`/teams/${slug}`} class="team-card" style={`--team-color:${color}; --team-soft:${soft}; --team-glow:${glow};`}>
  {position && <span class="tc-pos">#{position}</span>}

  <div class="tc-crest-ring">
    <img
      src={`/logos/${slug}.svg`}
      alt={name}
      class="tc-crest"
      loading="lazy"
      onerror="this.style.display='none';this.nextElementSibling.style.display='flex'"
    />
    <span class="tc-crest-emoji">{emoji}</span>
  </div>

  <h2 class="tc-name">{name}</h2>

  <div class="tc-manager">
    <img
      src={`/managers/${firstManagerSlug}.webp`}
      alt={manager}
      class="tc-manager-photo"
      loading="lazy"
      onerror="this.style.visibility='hidden'"
    />
    <span class="tc-manager-meta">
      <span class="tc-role">{managerRole}</span>
      <span class="tc-manager-name">{manager}</span>
    </span>
  </div>

  <div class="tc-footer">
    <span class="tc-pts">{points !== undefined ? <><strong>{points}</strong> pts</> : '—'}</span>
    <span class="tc-arrow">View team →</span>
  </div>
</a>

<style>
.team-card {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: var(--space-md);
  padding: var(--space-2xl) var(--space-lg) var(--space-lg);
  border-radius: var(--radius-xl);
  overflow: hidden;
  text-decoration: none;
  background:
    radial-gradient(80% 55% at 50% 0%, var(--team-glow) 0%, transparent 62%),
    linear-gradient(180deg, var(--bg-card) 0%, var(--bg-secondary) 100%);
  border: 1px solid var(--border);
  transition: transform var(--transition), box-shadow var(--transition), border-color var(--transition);
}
.team-card::before {
  content: ''; position: absolute; inset: 0 0 auto 0; height: 4px;
  background: var(--team-color);
}
.team-card:hover {
  transform: translateY(-4px);
  border-color: var(--team-color);
  box-shadow: 0 18px 50px var(--team-glow);
}

.tc-pos {
  position: absolute; top: var(--space-md); left: var(--space-md);
  font-family: var(--font-display); font-size: 1rem; line-height: 1.5;
  color: var(--team-color); background: var(--team-soft);
  border: 1px solid var(--team-color); border-radius: var(--radius-full);
  padding: 2px 12px;
}

.tc-crest-ring {
  width: 128px; height: 128px; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  position: relative; flex-shrink: 0;
  background: radial-gradient(circle at 50% 42%, var(--team-soft), transparent 72%);
  border: 2px solid var(--team-color);
  box-shadow: 0 0 0 8px var(--team-soft), 0 16px 40px var(--team-glow);
}
.tc-crest { width: 62%; height: 62%; object-fit: contain; filter: drop-shadow(0 8px 18px rgba(0,0,0,0.5)); }
.tc-crest-emoji { display: none; font-size: 3rem; }

.tc-name {
  font-family: var(--font-display);
  font-size: 2rem; line-height: 1; letter-spacing: 0.01em;
  color: var(--text-primary); margin: 0;
}

.tc-manager { display: inline-flex; align-items: center; gap: var(--space-sm); }
.tc-manager-photo {
  width: 52px; height: 52px; border-radius: 50%; object-fit: cover;
  border: 2px solid var(--team-color); background: var(--bg-elevated); flex-shrink: 0;
}
.tc-manager-meta { display: flex; flex-direction: column; line-height: 1.15; text-align: left; }
.tc-role { font-size: 0.6rem; text-transform: uppercase; letter-spacing: 0.12em; color: var(--text-muted); }
.tc-manager-name { font-size: 0.95rem; font-weight: 700; color: var(--text-primary); }

.tc-footer {
  display: flex; align-items: center; justify-content: space-between;
  width: 100%; margin-top: var(--space-sm);
  padding-top: var(--space-md); border-top: 1px solid var(--border-subtle);
}
.tc-pts { font-size: 0.9rem; color: var(--text-secondary); }
.tc-pts strong { font-family: var(--font-display); font-size: 1.5rem; color: var(--team-color); margin-right: 4px; }
.tc-arrow { font-size: 0.82rem; font-weight: 700; color: var(--text-muted); transition: color var(--transition), transform var(--transition); }
.team-card:hover .tc-arrow { color: var(--team-color); transform: translateX(3px); }

@media (max-width: 480px) {
  .tc-crest-ring { width: 104px; height: 104px; }
  .tc-name { font-size: 1.7rem; }
}
</style>
