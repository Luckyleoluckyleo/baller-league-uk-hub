---
import { ADS, ADSENSE_CLIENT } from '../data/ad-slots';

interface Props {
  placement?: 'top' | 'inContent';
  class?: string;
  label?: string;
}

const { placement = 'top', class: className = '', label = 'Advertisement' } = Astro.props;
const slot = ADS.slots[placement];
const show = ADS.enabled && !!ADSENSE_CLIENT && !!slot;
---

{show && (
  <div class={`ad-slot ad-slot--${placement} ${className}`.trim()} aria-label="Advertisement">
    <span class="ad-slot-label">{label}</span>
    <ins
      class="adsbygoogle ad-slot-ins"
      style="display:block"
      data-ad-client={ADSENSE_CLIENT}
      data-ad-slot={slot}
      data-ad-format="auto"
      data-full-width-responsive="true"
    ></ins>
    <script is:inline>
      (window.adsbygoogle = window.adsbygoogle || []).push({});
    </script>
  </div>
)}

<style>
.ad-slot {
  margin: var(--space-2xl) auto;
  max-width: 970px;
  min-height: 110px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
}
.ad-slot-label {
  font-size: 0.68rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--text-muted);
}
.ad-slot-ins {
  width: 100%;
  min-height: 90px;
}
@media (min-width: 768px) {
  .ad-slot { min-height: 290px; }
  .ad-slot-ins { min-height: 250px; }
}
</style>
